end intrinsic;

////////////////////
intrinsic '+'(S::SetEnum,u::CliffAlgElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u to every element of the set.}
   return {s+u : s in S};
end intrinsic;

////////////////////
intrinsic '+'(poly::TorPol,u::CliffAlgElt)->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    return Polyhedron([v+u: v in Vertices(poly)]);
end intrinsic;

////////////////////
intrinsic '+'(poly::TorPol,u::CliffOrdElt)->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
