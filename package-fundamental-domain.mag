Z:=IntegerRing();
Q:=RationalField();

declare verbose Fundamental, 6;


////////////////////
intrinsic '^'(x::CliffAlgElt,u::CliffAlgElt)->CliffAlgElt
////////////////////
{Apply the conjugation star(u)*x*u.}
    return star(u)*x*u;
end intrinsic;

////////////////////
intrinsic '^'(x::CliffAlgElt,u::CliffOrdElt)->CliffAlgElt
////////////////////
{Apply the conjugation star(u)*x*u.}
    return star(u)*x*u;
end intrinsic;

////////////////////
intrinsic '^'(x::CliffOrdElt,u::CliffAlgElt)->CliffAlgElt
////////////////////
{Apply the conjugation star(u)*x*u.}
    return star(u)*x*u;
end intrinsic;

////////////////////
intrinsic '^'(x::CliffOrdElt,u::CliffOrdElt)->CliffAlgElt
////////////////////
{Apply the conjugation star(u)*x*u.}
    return star(u)*x*u;
end intrinsic;

////////////////////
intrinsic '^'(x::CliffOrdElt,u::CliffOrdElt)->CliffAlgElt
////////////////////
{Apply the conjugation star(u)*x*u.}
    return star(u)*x*u;
end intrinsic;

////////////////////
intrinsic '^'(v::ModTupFldElt,u::CliffAlgElt)->ModTupFldElt
////////////////////
{
Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.
}
    cl:=Parent(u);
    return magma_vector(clifford_vector(cl,Vector(v))^u);
end intrinsic;

////////////////////
intrinsic '^'(v::TorLatElt,u::CliffAlgElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    P:=Parent(v);
    return P!(Vector(v)^u);
end intrinsic;

////////////////////
intrinsic '^'(v::ModTupFldElt,u::CliffOrdElt)->ModTupFltElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    O:=Parent(u);
    cl:=clifford_algebra(O);
    return (v^(cl!u));
end intrinsic;

////////////////////
intrinsic '^'(v::TorLatElt,u::CliffOrdElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    P:=Parent(v);
    O:=Parent(u);
    cl:=clifford_algebra(O);
    return P!(Vector(v)^(cl!u));
end intrinsic;


////////////////////
intrinsic '^'(S::SetEnum,u::CliffOrdElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u to every element of the set.}
   return {s^u : s in S};
end intrinsic;

////////////////////
intrinsic '^'(S::SetEnum,u::CliffAlgElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u to every element of the set.}
   return {s^u : s in S};
end intrinsic;

////////////////////
intrinsic '^'(poly::TorPol,u::CliffAlgElt)->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    return Polyhedron([v^u: v in Vertices(poly)]);
end intrinsic;

////////////////////
intrinsic '^'(poly::TorPol,u::CliffOrdElt)->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    O:=Parent(u);
    cl:=clifford_algebra(O);
    return poly^(cl!u);
end intrinsic;

////////////////////
intrinsic polyhedron(vs::SeqEnum[CliffAlgElt])->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    return Polyhedron([Eltseq(vector(v)) : v in vs]);
end intrinsic;

////////////////////
intrinsic polytope(vs::SeqEnum[CliffAlgElt])->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    return Polytope([Eltseq(vector(v)) : v in vs]);
end intrinsic;

////////////////////
intrinsic vector(v::CliffOrdElt)->ModTupFldElt
////////////////////
{Return a ModTupFldElt of an element in a Clifford order.
The coordinates returned are the clifford algebra clifford vector coordinates not the lattice coordinates}
    O:=Parent(v);
    cl:=clifford_algebra(O);
    return vector(cl!v);
end intrinsic;

////////////////////
intrinsic apply_operation(v::ModTupFldElt,cl::CliffAlg,operation::UserProgram)->ModTupFldElt
////////////////////
{
Apply the operation.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.
}
    return vector(operation(clifford_vector(cl,Vector(v))));
end intrinsic;

////////////////////
intrinsic apply_operation(v::TorLatElt,cl::CliffAlg,operation::UserProgram)->TorPol
////////////////////
{}
    P:=Parent(v);
    return P!(apply_operation(Vector(v),cl,operation));
end intrinsic;

////////////////////
intrinsic apply_operation(poly::TorPol,cl::CliffAlg,operation::UserProgram)->TorPol
////////////////////
{Apply an operation to all the vertices of a polyhedron.}
    return Polyhedron([apply_operation(v,cl,operation): v in Vertices(poly)]);
end intrinsic;

////////////////////
intrinsic inversion_inv(cl::CliffAlg,poly::TorPol)->TorPol
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    function inv(x)
        return -bar(x);
    end function;
    return apply_operation(poly,cl,inv);
end intrinsic;

////////////////////
intrinsic inversion_inv(cl::CliffAlg,elt::TorLatElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u to all of the vertices of the polyhedron.}
    function inv(x)
        return -bar(x);
    end function;
    return apply_operation(elt,cl,inv);
end intrinsic;

////////////////////
intrinsic '+'(v::ModTupFldElt,u::CliffAlgElt)->ModTupFldElt
////////////////////
{
Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.
}
    cl:=Parent(u);
    return magma_vector(clifford_vector(cl,Vector(v))+u);
end intrinsic;

////////////////////
intrinsic '+'(v::TorLatElt,u::CliffAlgElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    P:=Parent(v);
    return P!(Vector(v)+u);
end intrinsic;

////////////////////
intrinsic '+'(v::ModTupFldElt,u::CliffOrdElt)->ModTupFltElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    O:=Parent(u);
    cl:=clifford_algebra(O);
    return (v+(cl!u));
end intrinsic;

////////////////////
intrinsic '+'(v::TorLatElt,u::CliffOrdElt)->TorLatElt
////////////////////
{Apply the conjugation star(u)*x*u.
The vector is assumed to be in clifford vector coordinates not in coordinates for the basis of the lattice of clifford vectors of the order.}
    P:=Parent(v);
