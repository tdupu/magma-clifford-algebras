////////////////////
intrinsic bisect(p::ModTupRngElt,q::ModTupRngElt : gram := IdentityMatrix(Q,#Eltseq(p)))->TorPol,ModTupFldElt,FldRatElt
////////////////////
{Given two points, write the half-space bounded by points equidistant
from the two and containing the second one.  Optional argument: the Gram
matrix of the ambient.}
    
    error if p eq q, "can't find a half-space containing and not containing the same point";
    
    vs := VectorSpace(Q,#Eltseq(p),gram);
    p := vs!Eltseq(p);
    q := vs!Eltseq(q);
    
    mid := (p+q)/2;
    vec := q-p;
    
    c := InnerProduct(mid,vec);
    cp := InnerProduct(vec,p);
    assert cp ne c;
    
    if cp gt c then
        vec := -vec;
        c := -c;
    end if;
    
    assert (vec,p) lt c and (vec,q) gt c;
    
    /*
    HalfSpaceToPolyhedron takes v,c and looks for x such that InnerProduct(v,x)>=c.
    The InnerProduct is the standard dot product and there doesn't seem to be a way of
    changing the quadratic form on TorLat so we use that InnerProduct(x*gram,y) is the
    new quadratic form.
    */
    hs := HalfspaceToPolyhedron(Eltseq(vec*gram),c);
    
    tl := Universe(Vertices(hs));
    assert tl!p notin hs and tl!q in hs;
    return hs, vec, c;
end intrinsic;

////////////////////
intrinsic bisect(p::TorLatElt,q::TorLatElt : gram := IdentityMatrix(Q,#Eltseq(p)))->TorPol,ModTupFldElt,FldRatElt
////////////////////
{Given two points, write the half-space bounded by points equidistant
from the two and containing the second one.  Optional argument: the Gram
matrix of the ambient.}
    pv:=Vector(p);
    qv:=Vector(q);
    return bisect(pv,qv : gram:=gram);
end intrinsic;

////////////////////
intrinsic get_bisection_point(lat::Lat,f::TorPol)->LatElt
////////////////////
{Given a facet of a Voronoi polytope return
the points p such that the facet is defined
by the plane that is equidistant between
that point and the origin.

As f runs over facets of the voronoi cell, this is output is the third output of VoronoiCell.
}
    bd:=BasisDenominator(lat);
    // gram:=GramMatrix(lat);
    gram := InnerProductMatrix(lat);
    
    ker := Kernel(Transpose(Matrix(Q,[Eltseq(x-y): x,y in Vertices(f)])*ChangeRing(gram,Q)));
    // assert Dimension(ker) eq 1;
    lat_vs := sub<Generic(ker)|Basis(lat)>;
    ker meet:= lat_vs;
    assert Dimension(ker) eq 1;
    
    l1 := LatticeWithBasis(Matrix([LCM([Denominator(i): i in Eltseq(ker.1)])*ker.1])/bd,ChangeRing(InnerProductMatrix(lat),Q));
    lp := l1 meet lat;
    // and it's either the generator of this or its negative.
    p1 := Polytope([Universe(Vertices(f))|lp.1,-lp.1]);
    pt := p1 meet f;
    assert Dimension(pt) eq 0;
    spt := Sign(rep{x: x in Eltseq(Rep(Vertices(pt)))|x ne 0});
    slp := rep{p: p in [lp.1,-lp.1]|Sign(rep{x: x in Eltseq(p)|x ne 0}) eq spt};
    return slp;
end intrinsic;


/*
This maybe needs to be fixed since it may in general be a polyhedral complex and not a polyhedron if the union of the two polyhedra are not convex.
*/

////////////////////
intrinsic join_polyhedra(polys::Setq[TorPol])->TorPol
////////////////////
{}
    facets:=&cat[Facets(x) : x in polys];
    facets_set:=Set(facets);
    facets_external:={f: f in facets_set| Multiplicity(facets,f) eq 1 };
    return Polyhedron(&cat[Vertices(f) : f in facets_external]);
end intrinsic;

/*
This can certainly be sped up. This might be a horrible idea to recompute all of these.
*/

function polytope_comparison(x,y)//(x::TorPol,y::TorPol)->RngIntElt
//{}
    subpieces:=[x,y];
    verts_of_subpieces := [Vertices(i): i in subpieces];
    vertex_seqs:=[Sort([Eltseq(i): i in v]): v in verts_of_subpieces];
    perm:=SymmetricGroup(#subpieces).1;
    Sort(~vertex_seqs,~perm);
    subpieces_sorted := [subpieces[i^perm]: i in [1..#subpieces]];
    return Index(subpieces_sorted,x)-Index(subpieces_sorted,y);
end function;

function polytope_seq_comparison(x,y) //(x::SeqEnum[TorPol],y::SeqEnum[TorPol])->RngIntElt
//{}
    lenx:=#x;
    leny:=#y;
    len:=Minimum([#x,#y]);
    for i in [1..len] do
        res:=polytope_comparison(x[i],y[i]);
        if res ne 0 then
            return res;
        end if;
    end for;
    return lenx -leny;
end function;

function polytope_seq_seq_comparison(x,y) //(x::SeqEnum[SeqEnum[TorPol]],y::SeqEnum[SeqEnum[TorPol]])->RngIntElt
    lenx:=#x;
    leny:=#y;
    len:=Minimum([#x,#y]);
    for i in [1..len] do
        res:=polytope_seq_comparison(x[i],y[i]);
        if res ne 0 then
            return res;
        end if;
    end for;
    return lenx -leny;
end function;

intrinsic Sorted(~x::.)
{}
    if #x eq 0 then
        //do nothing
    elif Type(x[1]) eq TorPol then
        Sort(~x,polytope_comparison);
    elif Type(x[1]) eq SeqEnum then
        if Type(x[1][1]) eq TorPol then
            Sort(~x,polytope_seq_comparison);
        elif Type(x[1][1]) eq SeqEnum then
            if Type(x[1][1][1]) eq TorPol then
                Sort(~x,polytope_seq_seq_comparison);
            else
                error "Not implemented for this type";
            end if;
        else
            error "Not implemented for this type";
        end if;
    else
        error "Not implemented for this type";
    end if;
end intrinsic;


intrinsic Sorted(x::.)->SeqEnum
{}
    y:=x;
    Sorted(~y);
    return y;
end intrinsic;


////////////////////
intrinsic subdivide(piece::TorPol)->SeqEnum[TorPol]
////////////////////
{Subdivide a polyhedron by taking the vertices and then using
d(x,v1)<d(x,v2)<...<d(x,vn) for each ordering of the vertices.}
    vprintf Fundamental, 4: "chopping up a piece...\n";
    t1:=Cputime();
    subpieces:=[];
    verts:=Vertices(piece);
    i:=1;
    for g in SymmetricGroup(#verts) do
        gverts:=[verts[i^g] : i in [1..#verts]];
        if IsDivisibleBy(i,10) then
            vprintf Fundamental, 4: "chopp...\n";
        end if;
        subpiece := piece meet &meet[bisect(gverts[i],gverts[i+1]) : i in [1..#verts-1]];
        if Dimension(subpiece) eq Dimension(piece) then
            Append(~subpieces,subpiece);
        end if;
        i:=i+1;
    end for;
    vprintf Fundamental, 4: "%o seconds...\n",Cputime(t1);
    
    return subpieces;
end intrinsic;

////////////////////
intrinsic center(poly::TorPol)->TorLatElt
////////////////////
{Find the center of a convex polyhedron. This is the average of the vertices of the polyhedron.}
    verts:=Vertices(poly);
    return (1/#verts)*&+[v : v in verts];
end intrinsic;

////////////////////
intrinsic stellar_subdivision(poly::TorPol,pt::TorLatElt)->SeqEnum[TorPol]
////////////////////
{Perform a stellar subdivion of the convex polyhedra at the point pt.}
    require pt in poly: "pt must be in the polytope you are subdividing.";
    dim:=Dimension(poly);
    facets := Faces(poly)[dim];
    cones := [Polyhedron(Append(Vertices(f),pt)): f in facets];
    return cones;
end intrinsic;

////////////////////
intrinsic stellar_subdivision(poly::TorPol)->SeqEnum[TorPol]
////////////////////
{Perform a stellar subdivion of the convex polyhedra at the point pt.}
    return stellar_subdivision(poly,center(poly));
end intrinsic;

////////////////////
intrinsic permutation_action(polys::Setq[TorPol],matrix_group::GrpMat)->GrpPerm,Map
////////////////////
{
Given a collection of polyhedra that matrix_group acts on via a right action find the permutation associated to each element of the matrix group.
}
    //assert {matrix_group.i : i in [1..Ngens(matrix_group)]} eq Generators(matrix_group);
    perms:=[[Index(polys,polys[i]*matrix_group.j): i in [1..#polys]] : j in [1..Ngens(matrix_group)]];
    //perms;
    PG := PermutationGroup<#polys|perms>;
    to_PG := hom<matrix_group->PG|perms>;
    return PG,to_PG;
end intrinsic;

////////////////////
intrinsic is_adjacent(pol1::TorPol,pol2::TorPol)->BoolElt
////////////////////
{returns true if the polyhedra meet in a codimension one boundary.}
    dim:=Dimension(pol1);
    return Dimension(pol1 meet pol2) eq dim-1;
end intrinsic;

function codim_2_ints(pols)
  dim := Dimension(pols[1]);
  ints := [<&meet s,s>: s in Subsets(Set(pols),2)|Dimension(&meet s) eq dim-1];
  return ints;
end function;

function repeated_codim_2(fd)
  facets := {@x: x in Facets(f), f in fd@};
  ints := codim_2_ints(facets);
  comps := [x[1]: x in ints];
  if exists(badi){i: i in [1..#comps]|Index(comps,comps[i]) lt i} then
    badpair := <ints[badi,1],[Index(facets,i): i in ints[badi,2]],[Index(facets,i): i in ints[Index(comps,comps[badi]),2]]>;
    return true, badpair;
  end if;
  return false, <>;
end function;

// I think this is a good condition to maintain: that you don't have two cones
// that meet in a certain dimension but only in part of a face.
aligned := func<cones|forall{x: x,y in cones|x meet y in Faces(x,Dimension(x meet y))}>;
subaligned := func<cones|forall{x: x,y in cones|exists{c: c in [x,y]|x meet y in Faces(c,Dimension(x meet y))}}>;

// input: a list of cones, broken into orbits
// output: a choice of one cone from each orbit that fits together nicely
// this doesn't really work
function join_orbs(cones,orbs)
  dim := Dimension(cones[1]);
  gr := Graph<{1..#orbs}|{{i,j}: i,j in [1..#orbs]|i lt j and exists{r: r in orbs[j]|Dimension(cones[orbs[i,1]] meet cones[r]) eq dim-1}}>;
  vs := VertexSet(gr);
  inv_orb := AssociativeArray();
  for i in [1..#orbs], j in orbs[i] do inv_orb[j] := i; end for;

  my_st := [1];
  repeat
    // build a spanning tree step by step
    nbs := {i: i in [1..#orbs]|i notin {inv_orb[x]: x in my_st} and #{x: x in my_st|vs!i adj vs!inv_orb[x]} gt 0};
    // the new cone has to meet an existing one in codimension 1
    // but it doesn't have to be unique
    candidates := [x: x in orbs[nb], nb in nbs|exists{i: i in my_st|Dimension(cones[i] meet cones[x]) eq dim-1}];
    // this is where we make the condition that they fit together nicely
    // we want to be sure that if the new one meets an old one in codimension
    // greater than 1, then there is another component that explains this
    // intersection by being adjacent and containing the intersection
    good_candidates := [x: x in candidates|forall{i: i in my_st|exists{j: j in my_st|Dimension(cones[x] meet cones[j]) eq dim-1 and (xi meet cones[j] eq xi) where xi is cones[x] meet cones[i]}}];
    Append(~my_st,good_candidates[1]);
  until #my_st eq #orbs;
  return my_st;
end function;

// This function tries to join an aligned collection of polyhedra, broken
// into orbits, in a way that will give something on which is_bad will
// return false.  It does not work on our existing subdivision, which is
// not aligned.

// We can tell it to start with one particular cone, which is useful when
// inv_stable is true, because we can force a start that meets the reflection
// hyperplane, so that the fundamental domain ends up being connected.

// inv_gp is an additional group that is supposed to be preserved.  The idea
// is that if we are building an inv_stable fundamental domain, then inv_gp
// will be the group of order 2 generated by inversion, and otherwise it
// will be trivial.
function join_aligned(cones,orbs,inv_gp: start := 1)
  dim := Dimension(cones[1]);
  // the condition is safe because of the alignment
  // this is a lot faster than testing the dimensions
  // but actually we don't need this graph any more
  // gr := Graph<{1..#orbs}|{{i,j}: i,j in [1..#orbs]|i lt j and exists{r: f in Facets(cones[orbs[i,1]]), g in Facets(cones[r]), r in orbs[j]|f eq g}}>;
  // vs := VertexSet(gr);
  inv_orb := AssociativeArray();
  vprintf Clifford, 2: "making a fundamental domain by joining representatives of %o orbits\n", #orbs/#inv_gp;
  for i in [1..#orbs], j in orbs[i] do inv_orb[j] := i; end for;

  vprint Clifford, 4: "testing validity of starting point";
  my_st := Orbit(inv_gp,start);
  gr := Graph<Orbit(inv_gp,start)|{{x,y}: x,y in Orbit(inv_gp,start)|x lt y and exists{f: f in Facets(cones[x])|f in Facets(cones[y])}}>;
  // this can't happen if #inv_gp is 1
  error if not IsConnected(gr), "invalid starting point";

  all_outer := {*x: x in Facets(cones[i]), i in my_st*};
  outer := {@x: x in Set(all_outer)|Multiplicity(all_outer,x) eq 1@};
  pairs := {@{@x,y@}: x,y in outer|Dimension(x meet y) eq dim-2@};
  // changed from repeat-until; there can be only 1 orbit
  while #my_st lt #orbs do
    vprintf Clifford, 3: "choosing orbit %o of %o: ", #my_st+1, #orbs; 
    cp := Cputime();
    new_cones := {x: x in [1..#cones]|forall{v: v in Orbit(inv_gp,x)|inv_orb[v] notin {inv_orb[i]: i in my_st} and exists{s: s in outer|s in Facets(cones[x])}}};
    found := false;
    for n in new_cones do
      norb := Orbit(inv_gp,n); if n ne Min(norb) then continue; end if;
      all_facets := {*x: x in Facets(cones[i]), i in norb*};
      new_facets := {@x: x in Set(all_facets)|Multiplicity(all_facets,x) eq 1 and x notin outer@};
      old_facets := {@x: x in all_facets|x in outer@};
      new_pairs := {@{@x,y@}: x in new_facets, y in new_facets join (outer diff old_facets)|Dimension(x meet y) eq dim-2@};
      keep_pairs := {@x: x in pairs|forall{i: i in old_facets|i notin x}@};
      if forall{p: p in keep_pairs, q in new_pairs|&meet p ne &meet q} then
        // it's a keeper
        my_st join:= {@x: x in norb@};
        pairs := keep_pairs join new_pairs;
        outer := (outer join new_facets) diff old_facets;
        found := true;
        break n;
      end if;
    end for;
    error if not found, "failed to find a piece";
    vprintf Clifford, 2: "%o ",my_st[#my_st];
    vprintf Clifford, 3: "(%o seconds)\n", Cputime(cp);
  end while;
  fd := [cones[i]: i in my_st];
  return fd;
end function;


/////////////////////////
intrinsic convex_hull(seq::SeqEnum[TorPol])->TorPol
/////////////////////////
{Take the convex hull of two vertices of two TorPol.}
    verts:=&cat[Vertices(x) : x in seq];
    return Polytope(verts);
end intrinsic;

/////////////////////////
intrinsic exterior_facets(FD::Setq[TorPol])->SeqEnum[TorPol]
/////////////////////////
{Find the real exterior facets of a weakly aligned polytopal complex in the plane. This essentially performs a Z/2 addition on the facets appearing with multiplicity one. The Z/2 addition is done by shredding these facets. }
    sides:=&cat[Facets(P) : P in FD];
    exterior_sides0:=[ s : s in sides| Multiplicity(sides,s) eq 1];
    bad_pairs:=[ s : s in Subsets(Set(exterior_sides0),2) | Dimension(pair[1] meet pair[2]) eq Dimension(pair[1]) where pair is [ x : x in s]];
    bad_elts:=&join(bad_pairs);
    exterior_sides_good:=[ s : s in exterior_sides0 | not s in bad_elts];
    
    FD_sh:=shred(FD);
    
    replacements:={@ @};
    for bad_pair in bad_pairs do
        bp := [x : x in bad_pairs[1]];
        A:=bp[1];
        B:=bp[2];
        H:=convex_hull([A,B]);
        replacements:=replacements join {@ H meet D : D in shred(FD) @};
    end for;
    
    facets:=exterior_sides_good cat [r : r in replacements];
    return [f : f in facets | Multiplicity(facets,f) eq 1];
end intrinsic;

/*
EXAMPLE OF EXTERIOR FACETS:

P1 := Polytope([ [0,0], [0,2],[2,0], [2,2]]);
P2:= Polytope([[2,0],[2,1],[3,1],[3,0]]);
FD:=[P1,P2];
exterior_facets(FD);

*/

/////////////////////////
intrinsic is_bad0(FD::SeqEnum[TorPol])->BoolElt
/////////////////////////
{In a weakly aligned polyhedral complex does there exist two distinct pairs of facets with the property that they intersect in the same codimension 2 cell.
This is an obstruction to being a combinatorial manifold.}
    sides:=exterior_facets(FD);
    Sorted(~sides);
    adjacent_pairs:=[ [i,j] : i in [1..#sides], j in [1..#sides] | i lt j and Dimension(sides[i] meet sides[j]) eq Dimension(sides[i])-1];
    if exists(pairs){ [pair1,pair2] : pair1 in adjacent_pairs, pair2 in adjacent_pairs | pair1 lt pair2 and (sides[pair1[1]] meet sides[pair1[2]]) eq (sides[pair2[1]] meet sides[pair2[2]])} then
        return true, pairs;
    else
        return false;
    end if;
end intrinsic;

/////////////////////////
intrinsic is_bad_assoc0(FD1::Assoc)->BoolElt
/////////////////////////
{An alias for is_bad0, but takes associative arrays as input.}
    return is_bad0([FD1[k] : k in Keys(FD1)]);
end intrinsic;

/////////////////////////
intrinsic cones_with_action(O::CliffOrd:include_inv:=true,inv_stable:=false)->SeqEnum[TorPol],SeqEnum,GrpPerm,Map,GrpPerm,Map,GrpPerm,Map
/////////////////////////
{Given a clifford order, return a partition of the Voronoi cell for the lattice of clifford vectors into cones with its right permutation action by the clifford units of the order by conjugation.}
    cl:=clifford_algebra(O);
    inv:=func<x|inversion_inv(cl,x)>;


    L:=vec(O:small:=true);
    units_right:=units_matrix_group(O: action:="right",include_inv:=include_inv);
    gramL:=ChangeRing(GramMatrix(L),Q);

    error if exists{l: l in Basis(L), g in Generators(units_right)|Vector(BaseRing(g),Eltseq(l))*g notin L}, "group does not act on lattice";

    VC,stuff,VC_vecs:=VoronoiCell(L);
    VC_poly:=Polyhedron([Eltseq(f): f in VC]);
    dim:=Rank(L);
    facets := Faces(VC_poly)[dim];
    L_tor:=Parent(Vertices(VC_poly)[1]);

    vprintf Clifford, 3: "STEP: break up the Voronoi cell according to cones for each facet.\n";

    zero := L_tor!0;
    cones := [Polyhedron(Append(Vertices(i),zero)): i in facets];
    Sorted(~cones);

    if include_inv then
        cones_bad:=[cone : cone in cones|Dimension(cone meet inv(cone)) ge dim];
        cones_invariant:=[cone : cone in cones|cone eq inv(cone)];
        assert cones_bad eq cones_invariant;

        vprintf Clifford,3: "STEP: break up invariant cones.\n";

        HSL:=HalfspaceToPolyhedron(Dual(L_tor)!vector(cl!1),0);
        HSR:=HalfspaceToPolyhedron(Dual(L_tor)!vector(cl!-1),0);

        function break_cone(cones,cone)
            old_orb:={cone*g : g in units_right};
            cones_good:={cone: cone in cones|not cone in old_orb};
            coneL:=cone meet HSL;
            coneR:=cone meet HSR;
            orbL:={coneL*g : g in units_right};
            orbR:={coneR*g : g in units_right};
            cones_new:= cones_good join orbL join orbR;
            return [cone: cone in cones_new];
        end function;

        M:=inv_matrix(cl);
        assert HSR eq HSL*M;

        //cones_bad:=[cone : cone in cones|Dimension(cone meet inv(cone)) ge dim];
        i:=0;

        vprintf Clifford,3: "STEP (include_inv=true only): Break down %o bad cones \n", #cones_bad;


        if #cones_bad gt 0 then
            repeat
                cone_bad:=cones_bad[1];
                cones:=break_cone(cones,cone_bad);
                i+:=1;
                vprintf Fundamental,4: "breaking... %o \n",i;
                cones_bad:=[cone : cone in cones|Dimension(cone meet inv(cone)) ge dim];
            until #cones_bad eq 0;
        end if;

        assert join_polyhedra(cones) eq VC_poly;
        assert Volume(VC_poly) eq &+[Volume(cone):cone in cones];

    end if;
    
    //STEP: break the facets corresponding to the cones
    facets := Faces(VC_poly)[dim];
    facets1:={cone meet face : face in facets, cone in cones| Dimension(cone meet face) eq dim-1};
    facets1:=Sorted([face:face in facets1]);

    //STEP: for the action of the matrix group on the cones.

    PG,to_PG := permutation_action(facets1,units_right);
    orbs := Orbits(PG);

    //STEP: partition the cones which have non-trivial stabilizers

    if exists{c: c in [1..#cones]|#Stabilizer(PG,c) gt 1} then
        vprintf Clifford, 3: "STEP: There are cones which have nontrivial stabilizers. More chopping. \n";
        cones1 := [];
        //s := (dim mod 2)+2;
        orbs := Orbits(PG);
        for orb in orbs do
            elt:=Rep(orb);
            f := facets1[elt]; //old cone is the hull of the vertices of facet and zero
            // f_pieces:={@ p : p in subdivide(f)@};
            // cones1 cat:= [Polyhedron([v: v in Vertices(m)] cat [zero]): m in f_pieces];
            stab_f := Stabilizer(PG,Rep(orb));
            v_action := PermutationGroup<#vs|[[Index(vs,Vector(v)*ChangeRing(i@@to_PG,Q)): v in vs]: i in Generators(stab_f)]> where vs is Vertices(f);
            // this won't work if the quadratic form defining the
            // Clifford algebra is not diagonalizable
            // notes: a transversal of H in G is a set T such that
            // HT = G or T^-1 H = G (not necessarily TH = G).
            // Applying the change of base matrix given by an automorphism
            // changes the permutation p to p*a.
            // So p needs to be inverted here.
            f_pieces := [f meet &meet [bisect(v[i^(p^-1)],v[(i+1)^(p^-1)]:gram:=/*gramL*/DiagonalMatrix(Q,[1] cat [-i: i in cl`consts])): i in [1..#v-1]]: p in Transversal(SymmetricGroup(#v),v_action)] where v is Vertices(f);
            f_pieces := [x: x in f_pieces|Dimension(x) eq dim-1];
            cones1 cat:= [Polyhedron(Append([v*g@@to_PG: v in Vertices(m)],zero)): m in f_pieces, g in PG];
        end for;
        assert &+[Volume(cone1): cone1 in cones1] eq &+[Volume(cone): cone in cones];
        assert join_polyhedra(cones1) eq join_polyhedra(cones);
        PG1,to_PG1 := permutation_action(cones1,units_right);
        assert forall{orb: orb in Orbits(PG1)|#orb eq #PG1};
    else
        PG1 := PG;
        to_PG1 := to_PG;
        cones1 := cones;
    end if;

    // STEP: sort everything.
    Sorted(~cones1);
    assert Volume(VC_poly) eq &+[Volume(cone):cone in cones1];
    assert not exists{c: c in [1..#cones1]|#Stabilizer(PG1,c) gt 1};

    // AML: I don't understand the point of these lines.  Don't we already
    // have PG1,to_PG1 equal to permutation_action(cones1,units_right)?
    PG2,to_PG2:=permutation_action(cones1,units_right);
    orbs := [Sort(i): i in Orbits(PG2)];
    _,orb_perm := Sort([Min(i): i in orbs],func<x,y|x-y>);
    orbs:= [orbs[i^orb_perm]: i in [1..#orbs]];

    return cones1,orbs,PG2,to_PG2,PG1,to_PG1,PG,to_PG;
end intrinsic;

/////////////////////////
intrinsic spanning_tree(cones1::SeqEnum[TorPol],orbs::SeqEnum)->GrphUnd,GrphVertSet,GrphEdgeSet,GrphUnd
/////////////////////////
{For the graph where two orbits of cones are adjacent if and only if there exists two adjacent cells, find a spanning tree of this graph.
This is used for finding orbit representatives for cells in a fundamental domain.}
    dim:=Dimension(cones1[1]);
    
    function cond(i,j)
        /*
        There exists an cone in the jth orbit which meets the first element of the ith orbit in dimension dim-1.
        This is symmetric so if there also a cone in the ith orbit which meets the first element of the jth orbit.
        By actions, for every element of the ith orbit there will an element of the jth orbit that meets it and conversely.
        */
        C1:=cones1[orbs[i,1]];
        return exists{k: k in orbs[j]|Dimension( C1 meet cones1[k]) eq dim-1};
    end function;
    
    Gr := Graph<{1..#orbs}|{{i,j}: j in [i+1..#orbs], i in [1..#orbs]|cond(i,j)}>;
    //Gr;
    ST,V_ST,E_ST:=SpanningTree(Gr);
    
    return ST,V_ST,E_ST,Gr;
    
end intrinsic;

/////////////////////////
intrinsic fundamental_domain_infty_old(O::CliffOrd : include_inv:=false,inv_stable:=true)->SeqEnum[TorPol]
/////////////////////////
{return the fundamental domain of the stabilizer of infinity for PSL2(O). This method is known to work when include_inv is false and inv_stable is false. It works in some cases when include_inv is true.

It also has the feature that it loops through all possible additions of cells and tests when two distinct pairs of exterior cells of the refined weakly aligned polytopal complex intersect in the same codimension 2 cell.
}
    if include_inv and inv_stable then
        error "Can't both be stable under inv and have inv as an element of the group";
    end if;
    
    cl:=clifford_algebra(O);
    inv:=func<x|inversion_inv(cl,x)>;
    
    cones1,orbs,PG2,to_PG2,PG1,to_PG1,PG,to_PG:=cones_with_action(O:include_inv:=include_inv,inv_stable:=false);
    ST,V_ST,E_ST,Gr:=spanning_tree(cones1,orbs);
    
    //needed to initialize this
    dim:=Dimension(cones1[1]);

    if not inv_stable then

        if include_inv then
            L_tor:=Parent(Vertices(cones1[1])[1]);
            HS:=HalfspaceToPolyhedron(Dual(L_tor)!vector(cl!1),0);
            boundary_cones:=[Index(cones1,cone): cone in cones1 | Dimension(HS meet cone) eq dim-1];
            orbs_and_bc:=[];
            for i_cone in boundary_cones do
                orb0:=rep{ orb : orb in orbs | i_cone in orb};
                Append(~orbs_and_bc,[Index(orbs,orb0),i_cone]);
            end for;
            Sort(~orbs_and_bc);
        else
            orbs_and_bc:=[];
        end if;

        procedure get_initial_cone(~seq,~already_tried,~FD1:include_inv:=true,inv_stable:=false)
            if include_inv and (not inv_stable) then
                //vprintf Clifford,2: "Do two boundary cones share the same orbit?: %o \n ", exists{ s : s in Subsets(Set(orbs_and_bc),2)| forall{y : y in s | y[1] eq Rep(s)[1]} };
                k:=1;
                i_orb0,i_c:=Explode(orbs_and_bc[k]);
                w:=V_ST.i_orb0;

                while #seq eq 0 do
                    pair:=<w,i_c>;
                    if {pair} in already_tried then
                        k:=k+1;
                        i_orb0,i_c:=Explode(orbs_and_bc[k]);
                        w:=V_ST.i_orb0;
                    else
                        Append(~seq,pair);
                    end if;

                    if k gt #orbs_and_bc then
                        error "We have tried all possible initial orbits";
                    end if;
                end while;

                FD1[w] :=cones1[i_c];

            elif (not include_inv) and (not inv_stable) then
                i:=1;
                k:=1;
                w:=V_ST.i;
                orb:=orbs[Index(w)];
                i_c:=orb[k];
                while {<w,i_c>} in already_tried do
                    if k lt #orb then
                        k:=k+1;
                        i_c:=orb[k];
                    elif k eq #orb then
                        i:=i+1;
                        w:=V_ST.i;
                        orb:=orbs[Index(w)];
                        k:=1;
                        i_c:=orb[k];
                    end if;
                end while;
                FD1[w] :=cones1[i_c];
                Append(~seq,<w,i_c>);
            end if;
        end procedure;

        procedure next_cell(~seq,~already_tried,~FD1:include_inv:=true,inv_stable:=false)
            //orbits adjacent to things in the fundamental domain
            available:={@ v : v in V_ST | exists{ w: w in Keys(FD1) | w adj v} and not v in Keys(FD1)@};
            vprintf Clifford, 4: "ADJACENT ORBITS %o \n", #available;
            i:=0;
            repeat
                i:=i+1;
                FD2:=FD1;
                w:=available[i];

                //all cones will either be disjoint or intersect on the boundary.
                //it suffices that there exists some v where the intersection is right.
                cone_inds:={i : i in orbs[Index(w)] | exists{ v: v in Keys(FD1) | Dimension(cones1[i] meet FD1[v]) eq dim-1}};
                j:=0;
                choices:=Sort([i : i in cone_inds]);
                vprintf Clifford, 4: "ORB %o, CONES: %o \n", w,#choices;
                repeat
                    j:=j+1;
                    i_c:=choices[j];
                    seq_new:=seq cat [<w,i_c>];
                    vprintf Clifford, 3: "TRY: %o \n",<w,i_c>;
                    FD2[w]:=cones1[i_c];
                    flag0:=is_bad_assoc0(FD2) or (Set(seq_new) in already_tried);
                    vprintf Clifford, 3: "BAD: %o \n \n", flag0;
                until (not flag0) or (j eq #choices);
            until (not flag0) or (i eq #available);

            if (not flag0) then
                FD1:=FD2;
                vprintf Clifford,2: "cells: %o/%o \n", #Keys(FD1),#orbs;
                Append(~seq,<w,i_c>);
            else
                //add the current sequence to the bad list
                Include(~already_tried,Set(seq));
                v0,j0:=Explode(seq[#seq]);

                //remove the last item from the sequence
                seq:=seq[1..#seq-1];

                //remove the last part of the fundamental domain
                FD1_new:=AssociativeArray();
                for k in Keys(FD1) do
                    if k ne v0 then
                        FD1_new[k]:=FD1[k];
                    end if;
                end for;
                FD1:=FD1_new;
            end if;
        end procedure;

        FD1:=AssociativeArray();
        seq:=[];
        already_tried:={};
        
        /*
        
            MAIN LOOP
        
        */

        if #orbs eq 1 then
            vprintf Clifford, 4: "There is a single orbit. \n";
            assert #PG eq #orbs[1];
        else
            vprintf Clifford, 4: "STEP: pick a starting cone.\n";
            get_initial_cone(~seq,~already_tried,~FD1:include_inv:=include_inv,inv_stable:=inv_stable);

            while #Keys(FD1) lt #V_ST do
                if #seq gt 0 then
                    next_cell(~seq,~already_tried,~FD1:include_inv:=include_inv,inv_stable:=inv_stable);
                else
                    get_initial_cone(~seq,~already_tried,~FD1:include_inv:=include_inv,inv_stable:=inv_stable);
                end if;
            end while;
        end if;

        FD:=[ FD1[k] : k in Keys(FD1)];
        return FD;
    
    elif inv_stable then
        FD0:=fundamental_domain_infty_old(O:include_inv:=true,inv_stable:=false);
        FD00:=FD0 cat [inv(D) : D in FD0];
        return FD00;
    end if;
end intrinsic;

function is_bad_pair(c1,c2)
  if exists(pair){[f1,f2]: f1 in Facets(c1), f2 in Facets(c2)|Dimension(f1 meet f2) eq Dimension(f1) and f1 ne f2} then
    return true, pair;
  else return false,[];
  end if;
end function;

