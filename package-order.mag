time irreds:=primes_of_size(ord,3);

*/

//################################
intrinsic cg_up_to(ord::CliffOrd,n::RngIntElt)->SeqEnum
//################################
{Return elements of the clifford monoid (element of the rational clifford group that are in the order)}
    cl:=clifford_algebra(ord);
    lat:=lattice(ord);
    shorts := ShortVectors(lat,n);
    shorts_ord:=[];
    for s in shorts do
        if s[2] in Z then
            x:=cl!Eltseq(s[1]);
            if in_clifford_group(x) then
                Append(~shorts_ord,<ord!x,s[2]>);
            end if;
        end if;
    end for;
    return shorts_ord;
end intrinsic;

//################################
intrinsic cg_up_to(ord::CliffOrd,a::RngIntElt,b::RngIntElt)->SeqEnum
//################################
{Return elements of the clifford monoid (element of the rational clifford group that are in the order)}
    cl:=clifford_algebra(ord);
    lat:=lattice(ord);
    shorts := ShortVectors(lat,a,b);
    shorts_ord:=[];
    for s in shorts do
        if s[2] in Z then
            x:=cl!Eltseq(s[1]);
            if in_clifford_group(x) then
                Append(~shorts_ord,<ord!x,s[2]>);
            end if;
        end if;
    end for;
    return shorts_ord;
end intrinsic;

//########################
intrinsic cg_of_norm(ord::CliffOrd,p::RngIntElt)->SeqEnum
//########################
{}
    return [x[1] : x in cg_up_to(ord,p,p)];
end intrinsic;

//########################
intrinsic partition(B0::SeqEnum,test::UserProgram)->SeqEnum
//########################
{}
    partitions:=[];
    B:=B0;
    while #B ne 0 do
        x:=B[1];
        A:={@ y : y in B| test(x,y) @};
        B:={@ y : y in B| not y in A @};
        Append(~partitions,A);
    end while;
    return partitions;
end intrinsic;

//########################
intrinsic primes_of_size(ord::CliffOrd,p::RngIntElt)->SetIndx
//########################
{}
    primes:=cg_of_norm(ord,p);
    test:=func<x,y|x*y^(-1) in ord>;
    sets:=partition(primes,test);
    return {@ x[1] : x in sets @};
end intrinsic;

//########################
intrinsic primes_up_to(ord::CliffOrd,n::RngIntElt)->SetIndx
//########################
{}
    return &join[primes_of_size(ord,p) : p in PrimesUpTo(n)];
end intrinsic;



//#######################
intrinsic short_clifford_vectors(O::CliffOrd,a::RngIntElt,b::RngIntElt) -> SeqEnum[Tup]
//#######################
{
    Returns the clifford vectors as OrdCliffElts of norm between a and b.
}

    short_ord_elts:=[];
    shorts:=ShortVectors(vec(O),a,b);

    for shorty in shorts do
        short_vec:=shorty[1];
        len:=shorty[2];
        short_ord_elt:= O!Eltseq(short_vec);
        short_ord_elts:=short_ord_elts cat [<short_ord_elt,len>];
    end for;
        
    return short_ord_elts;

end intrinsic;

//#######################
intrinsic short_clifford_vectors(O::CliffOrd,a::RngIntElt) -> SeqEnum[Tup]
//#######################
{
    Returns the clifford vectors as OrdCliffElts of norm less than a.
}
    return short_clifford_vectors(O,1,a);
end intrinsic;

//################################
intrinsic short_cg_elements(ord::CliffOrd,a::RngIntElt,b::RngIntElt)->SeqEnum[Tup]
//################################
{Return elements of the clifford monoid (element of the rational clifford group that are in the order) of an order up to a certain size.}
        return cg_up_to(ord,a,b);
end intrinsic;

//########################
intrinsic short_cg_elements(ord::CliffOrd,p::RngIntElt)->SeqEnum
//########################
{}
    return cg_up_to(ord,p);
end intrinsic;


//########################
intrinsic primes_up_to_sample(ord::CliffOrd,a::RngIntElt)->SetIndx
//########################
{
Return a single prime up to a certain size. This does not attempt to return a complete list of primes.
}
    primes:=PrimesUpTo(a);
    cl:=clifford_algebra(ord);
    lat:=vec(ord);
    shorts:=ShortVectors(lat,a);
    sample:=AssociativeArray();
    
    for short in shorts do
        if not short[2] in primes then
            //do nothing
        else
            if short[2] in Keys(sample) then
                //do nothing
            else
                x:=cl!Eltseq(short[1]);
                if in_clifford_group(x) then
                    sample[short[2]]:=ord!x;
                end if;
            end if;
        end if;
    end for;
    
    return {@ sample[p] : p in Keys(sample) @};
end intrinsic;

////////////////////
intrinsic pi_action(u::CliffOrdElt,v::CliffAlgElt)->CliffAlgElt
////////////////////
{Gives the action u*v*star(u) on Clifford vectors.)}
    cl:=clifford_algebra(Parent(u));
    return cl!(u*v*star(u)); //could output order elements
end intrinsic;

////////////////////
intrinsic pi_repn(u1::CliffOrdElt)->AlgMatElt
////////////////////
{This is a representation given by the left action x -> u x star(u) where x is a clifford vector.
The representation is with respect to the standard basis.}
    O:=Parent(u1);
    if not u1 in Keys(O`unit_to_matn) then
        cl:=clifford_algebra(Parent(u1));
        I:=get_I(cl);
        vs:=[cl!1] cat I;
        n:=#vs;
        M:=Transpose(Matrix(n,n,[magma_vector(cl!(u1*v*star(u1))) : v in vs]));
        O`unit_to_matn[u1]:=M;
        O`matn_to_unit[M]:=u1;
    end if;
        return O`unit_to_matn[u1];
end intrinsic;

////////////////////
intrinsic vec_coordinates(v1:CliffOrdElt)->SeqEnum
////////////////////
{Given v in Vec(O) where Vec(O) has basis w1,...,wn return the sequence [a1,...,an] such that v = a1*w1+...+an*wn.
}
    O:=Parent(v1);
    cl:=clifford_algebra(O);
    require is_vec(cl!v1): "input is not a clifford vector";
    lat:=vec(O:small:=true);
    cob:=Matrix([ Eltseq(b) : b in Basis(lat) ])^(-1);
    return Eltseq(magma_vector(cl!v1)*cob);
end intrinsic;

