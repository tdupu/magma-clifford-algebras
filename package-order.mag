//    LATTICES
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



//#############################
intrinsic lattice(ord::CliffOrd)->Lat
//############################
{
Return the Lat object associated to an order.
This is the 2^n dimensional lattice, not the lattice of clifford vectors.
The clifford vector lattice is vec.
}
/*
We take the standard lattice for the clifford algebra which is also an order.
Then given the order, we scale it to 1/(LCM) to get another ZZ-module.
Then we place our order inside of this lattice.
*/
    if not assigned ord`lattice then
        
        //Create sublattice of 1/N*(previous lattice) so that the basis can be embedded inside of it. Here we need to be careful about "order coordinates" vs "clifford coordinates". We want all of our basis vectors to be computed with respect to the standard basis in the clifford algebra.
        cl:=clifford_algebra(ord);
        bb:=basis(ord);
        gram:=Matrix([[ Eltseq((cl.i*bar(cl.j)))[1] : i in [1..dim(cl)]] : j in [1..dim(cl)]]); //Waterman, Mobius Transformations in Several Dimensions 1993, Theorem 1.
        lat_basic:=LatticeWithGram(gram);
        scale := LCM([Denominator(i): i in Eltseq(cl!b), b in bb]);
        lat_scaled:=(1/scale)*lat_basic;
        lat_order:=sub<lat_scaled|[Eltseq(cl!b): b in bb]>;
        
        ord`lattice:=lat_order;
        
        lat_vec_big:=sub<lat_scaled|[Eltseq((1/scale)*cl.i) : i in get_vector_indices(cl)]>;
        lat_vec:=lat_order meet lat_vec_big;
        
        ord`vec:=lat_vec;
        
        /*
        There is another way to compute this with order coordinates which is slightly faster for some things which I'm including in case we need it later. This approach has the downside that you can't coerce element sequences directly into the clifford algebra.
        
            gram:=Matrix([[ Eltseq(((cl! b)*bar(cl! c)))[1] : b in bb] : c in bb]);
            lat_order:=LatticeWithGram(gram);
            scale := LCM([Denominator(i): i in Eltseq(cl!b), b in bb]);
            lat_scaled:=scale*lat_order;
            lat_vec_big:=sub<lat_order|[get_order_coordinates(ord,cl.i) : i in get_vector_indices(cl)]>;
            lat_vec_scaled:=lat_scaled meet lat_vec_big;
            lat_vec:=(1/scale)*lat_vec_scaled;
        
        */
    end if;
    
    return ord`lattice;
end intrinsic;

//######################
intrinsic vec(O::CliffOrd:small:=false,integral:=false)->Lat,.
//######################
{
Given a clifford order return the lattice of clifford vectors.
The option 'small' controls the size of the ambient space.
The option 'integral' tells us to give an integral lattice and it returns the denominator of the lattice as well.
The actual lattice will then be given by (1/(den))*lat.
One needs to pass small:=true, and integral:=true for the fundamental domain code to work.
One then needs to understand that the Voronoi cells will then be scaled by den.
}
/*
EXAMPLE:

cl:=clifford_algebra(Q,[-1,-1,-1]);
O:=get_maximal_orders(cl)[1];
lat,den:=vec(O:small:=true,integral:=true);

*/
    if not small and not integral then
        if not assigned O`vec then
            order_lattice:=lattice(O); //this computes the clifford vectors in the process
        end if;
        
        return O`vec;
    
    elif integral then
        den:=LCM([Denominator(v): v in Basis(vec(O))]);
        
        if small then
            cl:=clifford_algebra(O);
            vecs:=[cl!Eltseq(v) : v in Basis(vec(O))];
            // this is wrong because it forgets the inner product
            // M:=Matrix([magma_vector(w) : w in vecs]);
            // return den*LatticeWithBasis(M),den;
            lat_sub := LatticeWithGram(Matrix([[g[i,j]: j in cl`vec_inds]: i in cl`vec_inds])) where g is InnerProductMatrix(lattice(O));
            return sub<lat_sub|[den*magma_vector(w): w in vecs]>,den;
        else
            return den*vec(O),den;
        end if;
    else
            cl:=clifford_algebra(O);
            vecs:=[cl!Eltseq(v) : v in Basis(vec(O))];
            gr_mat := Matrix(Q,[[g[i,j]: j in cl`vec_inds]: i in cl`vec_inds]) where g is InnerProductMatrix(lattice(O));
            M:=Matrix([magma_vector(w) : w in vecs]);
            // return LatticeWithBasis(M);
            return LatticeWithBasis(M,gr_mat);
    end if;
end intrinsic;

