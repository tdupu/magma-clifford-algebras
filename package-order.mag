////////////////////
intrinsic pi_repn_right(u::CliffOrdElt)->AlgMatElt
////////////////////
{Returns return the matrix which multiplies vectors on the right so that
 vector(x^u) = vector(x)*pi_repn_right(u);
 vector(x^(u1*u2)) = vector(x)*pi_repn_right(u1)*pi_repn_right(u2);
}
    cl:=clifford_algebra(Parent(u));
    I:=get_I(cl); vs:=[cl!1] cat I;
    n:=#vs;
    return Matrix(n,n,[vector(v)^u : v in vs]);
end intrinsic;

////////////////////
intrinsic inv_matrix(cl::CliffAlg)->MatAlgElt
////////////////////
{The matrix for multiplication on the right of a vector for the map x->-bar(x).}
    inv:=func<x|inversion_inv(cl,x)>;
    I:=get_I(cl);
    inv_cl:=func<x|-bar(x)>;
    dim:=arity(cl)+1;
    vecs:=[cl!1] cat [I[i] : i in [1..dim-1]];
    M:=Matrix(dim,dim,[vector(inv_cl(v)) : v in vecs]);
    return M;
end intrinsic;

////////////////////
intrinsic units_matrix_group(O::CliffOrd:action:="left",include_inv:=false)->GrpMat,SeqEnum
////////////////////
{
For each unit we can define u*x*u^* and consider the matrix associated to this linear map which acts on column vectors on the left.
Magma's convention is by right multiplication so this won't defined a group homomorphism.
That defines pi_repn_right.
   pi_repn(u1*u2) = pi_repn(u1)*pi_repn(u2);
   pi_repn_right(u1*u2) = pi_repn_right(u2)*pi_repn_right(u1);
We take the transpose of this and get units_matrix group in order to get a group homomorphism.

This is the matrix group that is called with fundamental domains.
Also returns the list of units and the map.

If the option include_inv is set to true, then the matrix group will include the transformation x->-bar(x). This is used in the construction of fundamental domains.
}
    c_units:=units(O);
    cl:=clifford_algebra(O);
    n:=get_arity(cl)+1;

    //start with matrices for the right action
    mat_gens:=[pi_repn_right(u1) : u1 in c_units];
    if include_inv then
        mat_gens:=mat_gens cat [inv_matrix(cl)];
    end if;
    
    if action eq "left" then
        mat_gens:=[Transpose(M) : M in mat_gens];
    elif action eq "right" then
        //do nothing
    else
        assert action in {"left","right"};
    end if;
    
    return sub<GL(n,Q)|mat_gens>,c_units;

end intrinsic;


////////////////////
intrinsic cg_up_to(ord::CliffOrd, upper::RngIntElt:lower:=1)->SeqEnum
////////////////////
{Find element of the clifford group of an order up to a certain size.}
    bb:=basis(ord);
    cl:=clifford_algebra(ord);
    // lat:=get_cliff_lattice(ord);
    diag := DiagonalMatrix([AbsoluteValue(Eltseq(cl.i^2)[1]): i in [1..Dimension(cl)]]);
    scale := LCM([Denominator(i): i in Eltseq(b), b in bb]);
    diaglat := LatticeWithGram(diag);
    ord_basis := [diaglat|Eltseq(scale*i): i in bb];
    subdiag := sub<diaglat|ord_basis>;
    shorts := ShortVectors(subdiag,lower*scale^2,upper*scale^2);
    elts := [];
    for s in shorts do
      coords := Solution(Matrix(ord_basis),Vector(s[1]));
      cdiv := &+[coords[i]*bb[i]: i in [1..#bb]];
      assert cdiv in ord and nm(cdiv) eq s[2]/scale^2;
      Append(~elts,<cdiv,Z!(s[2]/scale^2)>);
    end for;
    return elts;
    /* M:=Matrix([Eltseq(x) : x in basis(ord)]);
    lat:=Lattice(M);
    
    shorts:=ShortVectors(lat,lower,upper);
    shorts_cg:=[];
    for short in shorts do
        elt:=&+[Coordinates(short[1])[i]*bb[i] : i in [1..#bb]];
        if in_clifford_group(cl!elt) then
            Append(~shorts_cg,<elt,short[2]>);
        end if;
    end for;
    return shorts_cg;*/
end intrinsic;

////////////////////
intrinsic cg_of_norm(ord::CliffOrd,p::RngIntElt)->SeqEnum
////////////////////
{Find elements of the clifford group up to a certain size.}
    return [x[1] : x  in cg_up_to(ord,p:lower:=p)];
end intrinsic;

//----------
function partition(B0,test)
//----------
    partitions:=[];
    B:=B0;
    while #B ne 0 do
        x:=B[1];
        A:={@ y : y in B| test(x,y) @};
        B:={@ y : y in B| not y in A @};
        Append(~partitions,A);
    end while;
    return partitions;
end function;

////////////////////
intrinsic primes_of_size(ord::CliffOrd,p::RngIntElt)->SeqEnum
////////////////////
{Find the primes of a given size}
    primes:=cg_of_norm(ord,p);
    test:=func<x,y|x*y^(-1) in ord>;
    sets:=partition(primes,test);
    return [x[1] : x in sets];
end intrinsic;

////////////////////
intrinsic primes_up_to(ord::CliffOrd,n::RngIntElt)->SeqEnum
////////////////////
{Primes in ord up to a certain size.}
    return &cat[primes_of_size(ord,p) : p in PrimesUpTo(n)];
end intrinsic;

////////////////////
intrinsic is_star_invariant(O::CliffOrd)->BoolElt
////////////////////
{Determined if an order in a clifford algebra is closed under the star involution.}
    cl:=clifford_algebra(O);
    return forall{ b : b in basis(O) | star(cl!b) in O};
end intrinsic;
