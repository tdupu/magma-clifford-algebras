//#######################################
intrinsic random_rational( :bound:=1000)->RngElt
//#######################################
{}
    num:=Random([1..bound]);
    den:=Random([1..bound]);
    rand:=num/den;
    return rand;
end intrinsic;

//#######################################
intrinsic random_clifford_vector(cl::CliffAlg:bound:=1000)->CliffAlgElt
//#######################################
{}
    require cl`base_ring eq Q: "this is only implemented for rational clifford algebras";
    I:=get_I(cl);
    rand:=cl!random_rational(:bound:=bound) + &+[random_rational(:bound:=bound)*I[i] : i in [1..#I]];
    return rand;
end intrinsic;


//#######################################
intrinsic base_ring(cl::CliffAlg)->Rng
//#######################################
{}
   return cl`base_ring;
end intrinsic;

//#######################################
intrinsic Dimension(cl::CliffAlg)->RngIntElt
//#######################################
{}
  return Dimension(cl`alg);
end intrinsic;

//#############################
intrinsic Hash(X::CliffAlg) -> RngIntElt
//#############################
{Return a hash}
  return Hash(<X`base_ring,X`consts>);
end intrinsic;

//#############################
intrinsic Hash(x::CliffAlgElt) -> RngIntElt
//#############################
{Return a hash}
  return Hash(get_magma_elt(x));
end intrinsic;

////////////////////////////////////
//   Printing
////////////////////////////////////

intrinsic variableNames(cl::CliffAlg) -> SeqEnum
{Return the variable names.}
    if not assigned R`variable_names then
        cl`variable_names:=[ Sprintf("a%o",i) : i in [1..Nvariables(cl)]];
    end if;
    
    return cl`variable_names;
end intrinsic;

intrinsic Name(R::CliffAlg,i::RngIntElt)->CliffAlgElt
{Return the I[i] algebra generator.}
    I:=get_I(R);
    return I[i];
end intrinsic;

intrinsic AssignNames(~R::CliffAlg,s::SeqEnum)
{Give the generators a name.}
    R`variable_names := s;
end intrinsic;

intrinsic NumberOfNames(cl::CliffAlg)->RngIntElt
{Return the number of names.}
    return Nvariables(cl);
end intrinsic;

/////////////////////////////
intrinsic Nvariables(cl::CliffAlg)->RngIntElt
/////////////////////////////
{}
    return cl`arity;
end intrinsic;

////////////////////
intrinsic inner_product(x::CliffAlgElt,y::CliffAlgElt)->RngElt
////////////////////
{Takes the dot product of two clifford vectors.
It assumes that 1/2 is in the base ring.}
    return Eltseq((nm(x+y)-nm(x)-nm(y)))[1]/2;
end intrinsic;

////////////////////
intrinsic vector(w::CliffAlgElt)->ModTupFldElt
////////////////////
{Gives the magma vector associated to a clifford vector}
    require is_vec(w): "Not a clifford vector";
    cl:=Parent(w);
    I:=get_I(cl);
    vs:=[cl!1] cat I;
    // bogus:
    // return Vector([inner_product(w,v) : v in vs]);
    return Solution(Matrix([Vector(Eltseq(i)): i in vs]),Vector(Eltseq(w)));
end intrinsic;

////////////////////
intrinsic vector(w::AlgClffElt)->ModTupFldElt
////////////////////
{Gives the magma vector associated to a clifford vector}
    require is_vec(w): "Not a clifford vector";
    cl_mag:=Parent(w);
    I:=get_I(cl_mag);
    vs:=[cl_mag!1] cat I;
    return Solution(Matrix([Vector(Eltseq(i)): i in vs]),Vector(Eltseq(w)));
end intrinsic;

////////////////////
intrinsic magma_vector(w::CliffAlgElt)->ModTupFldElt
////////////////////
{Gives the magma vector ModTupFldElt associated to a clifford vector}
    return vector(w);
end intrinsic;

/*
magma_vector(I[1]);
*/

////////////////////
intrinsic magma_vector_truncated(w::CliffAlgElt)->ModTupFldElt
////////////////////
{
Projects a vector x[0]+x[1]*I[1] + ... + x[n]*I[n] to x[0]+x[1]*I[1]+...+x[n-1]*I[n-1].
This is useful for clifford vectors thought of as elements of hyperbolic space that you want to project to the boundary.
 }
    require is_vec(w): "Not a clifford vector";
    v:=Eltseq(magma_vector(w));
    return Vector(v[1..#v-1]);
end intrinsic;

/*
magma_vector_truncated(I[1]);
*/

////////////////////
intrinsic clifford_vector(cl::CliffAlg,wv::ModTupRngElt)->CliffAlgElt
////////////////////
{Create a clifford vector from a magma vector with ring entries.}
    I:=get_I(cl);
    wv_seq:=Eltseq(wv);
    vs:=[cl!1] cat I;
    require #vs eq #wv_seq: "vector cannot be made into a clifford vector";
    return &+[wv[i]*vs[i] : i in [1..#wv_seq]];
end intrinsic;

////////////////////
intrinsic clifford_vector(cl::AlgClff,wv::ModTupRngElt)->CliffAlgElt
////////////////////
{Create a clifford vector from a magma vector with ring entries.}
    I:=get_I(cl);
    wv_seq:=Eltseq(wv);
    vs:=[cl!1] cat I;
    require #vs eq #wv_seq: "vector cannot be made into a clifford vector";
    return &+[wv[i]*vs[i] : i in [1..#wv_seq]];
end intrinsic;

////////////////////
intrinsic clifford_vector(cl::CliffAlg,wv::LatElt)->CliffAlgElt
////////////////////
{Create a clifford vector from a lattice element}
    return clifford_vector(cl,Vector(Eltseq(wv)));
end intrinsic;

////////////////////
intrinsic clifford_vector(cl::CliffAlg,wv::TorLatElt)->CliffAlgElt
////////////////////
{Create a clifford vector from a TorLatElt.}
    return clifford_vector(cl,Vector(Eltseq(wv)));
end intrinsic;

////////////////////
intrinsic clifford_vector(cl::CliffAlg,wv::ModTupFldElt)->CliffAlgElt
////////////////////
{Create a clifford vector from a magma vector with field entries.}
    I:=get_I(cl);
    wv_seq:=Eltseq(wv);
    vs:=[cl!1] cat I;
    require #vs eq #wv_seq: "vector cannot be made into a clifford vector";
    return &+[wv[i]*vs[i] : i in [1..#wv_seq]];
end intrinsic;

////////////////////
intrinsic Norm(x::CliffOrdElt)->RngElt
////////////////////
{Take the norm of a clifford order element.}
  return x`parent`clifford_algebra`nm(x);
end intrinsic;

////////////////////
intrinsic Norm(x::CliffAlgElt)->RngElt
////////////////////
{Take the norm of a clifford order element.}
  return x`parent`nm(x);
end intrinsic;

////////////////////
intrinsic squares(cl::AlgClff)->SeqEnum[RngIntElt]
////////////////////
{For a Clifford algebra with generators a1,a2,...,an return a1^2,a2^2,...,an^2.}
    I:=get_I(cl);
    return [Eltseq(I[i]^2)[1] : i in [1..arity(cl)]];
end intrinsic;

////////////////////
intrinsic squares(cl::CliffAlg)->SeqEnum[RngIntElt]
////////////////////
{For a Clifford algebra with generators a1,a2,...,an return a1^2,a2^2,...,an^2.}
    return squares(magma_algebra(cl));
end intrinsic;

////////////////////
intrinsic square_roots(cl::CliffAlg)->SeqEnum[FldReElt]
////////////////////
{For a Clifford algebra with generators a1,a2,...,an return sqrt(a1^2),sqrt(a2^2),...,sqrt(an^2).}
    return [Sqrt(d) : d in squares(cl)];
end intrinsic;

// AML: this assumes that the algebra already has names for the hyperbolic
// units.  Do we want to check this?
////////////////////
intrinsic extend(cl:CliffAlg)->CliffAlg
////////////////////
{
Extend the clifford algebra to a larger clifford algebra with an extra unit j such that j^2=-1. This is used in the construction of hyperbolic spaces.
}
    sqs:=squares(cl) cat [-1];
    F:=base_ring(cl);
    if not assigned cl`variable_names then
        names:= ["J"];
    else
        names:= cl`variable_names cat ["J"];
    end if;
    cl_big:=clifford_algebra(F,sqs);
    AssignNames(~cl_big,names);
    return cl_big;
end intrinsic;

intrinsic is_extension(cl2::CliffAlg,cl1::CliffAlg)->BoolElt
{Determines if the Clifford algebra cl2 is an extension of the Clifford algebra cl2. This is used in coercion.}
    F1:=base_ring(cl1);
    F2:=base_ring(cl2);
    
    rings_ok:=forall{ a : a in Generators(F1) | a in F2};
    squares1 := squares(cl1);
    squares2 := squares(cl2);
    return rings_ok and IsSubsequence(squares1,squares2);
end intrinsic;
