////////////////////////////////////////
////////////////////////////////////////
////////////////////////////////////////
//  Vertices/Clusters/Pruning
////////////////////////////////////////
////////////////////////////////////////
////////////////////////////////////////

intrinsic ambient_linear_polyhedron(pol::HypPol)->HypPol
{Find the linear space containing the polyhedron.}
    halfs:=halfspaces(pol);
    linear_halfs:=[h : h in halfs | flip(h) in halfs];
    if #linear_halfs eq 0 then
        return polyhedron(hyperbolic_space(pol));
    else
        return &meet(linear_halfs);
    end if;
end intrinsic;

intrinsic ambient_linear_scheme(pol::HypPol)->Sch
{Find the minimal linear space containing the scheme of a polyhedron. The scheme of a polyhedron is the union of its sides.}
    hyperplane_pairs:={@ {h,flip(h)} : h in halfspaces(pol) | flip(h) in halfspaces(pol) @};
    if #hyperplane_pairs eq 0 then
        return affine_space(hyperbolic_space(pol));
    else
        hyperplanes:=[ scheme(Rep(pair)) : pair in hyperplane_pairs  ];
        minimal_linear_subspace:=&meet(hyperplanes);
        return minimal_linear_subspace;
    end if;
end intrinsic;



intrinsic cluster(pol::HypPol)->Sch
{Given a hyperbolic polyhedron determine the zero dimensional scheme that is its set of points.}
    H:=hyperbolic_space(pol);
    n:=dimension(H);
    halfs:=Setseq(halfspaces(pol));

    subs := [[halfs[i]: i in s]: s in Subsets({1..#halfs},n)];
    //  subs:=Subsets(halfspaces(pol),n);
    clusters:=[];
    for sub in subs do
        X:=(&meet[scheme(x) : x in sub]);
        if Dimension(X) eq 0 then
            Append(~clusters,X);
        end if;
    end for;
    
    if #clusters eq 0 then
        AN:=affine_space(H);
        return EmptyScheme(AN);
    else
        return &join clusters;
    end if;
end intrinsic;


intrinsic vertices(pol::HypPol)->SeqEnum[HypSpcCliffElt],SeqEnumPt
{
Returns the vertices of a hyperbolic polyhedron. The second sequence returns their real values as points of affine space. This can be used for testing inequalities.
There are at most two real embeddings of every point.
We understand our algebraic one to mean the one that is in the upper half space.
We can coerce these into points of hyperbolic space so we return them as such.
We also test to make sure the points are genuinely points of the polyhedron.
}
    if not assigned pol`vertices then
        H:=hyperbolic_space(pol);
        AN:=affine_space(H);
        n:=dimension(H);
        X:=cluster(pol) meet ambient_linear_scheme(pol);
        
        if not IsEmpty(X) then
            pts:=RationalPoints(X,Qbar);
            real_value:=AssociativeArray();
            for pt in pts do
                seq:=Eltseq(pt);
                y:=seq[n];
                my:=MinimalPolynomial(y);
                if Degree(my) gt 1 then
                    assert Degree(my) eq 2;
                    F<a>:=SplittingField(my);
                    y_coord:=[ x : x in RealEmbeddings(a) | x ge 0];
                    if #y_coord gt 0 then
                        assert #y_coord eq 1;
                        real_value[pt]:=AN(RR)!([RR!x: x in seq[1..n-1]] cat [y_coord[1]]);
                    end if;
                elif Q!y gt 0 then
                    //they can always be made rational so the test above works
                    real_value[pt]:=AN(RR)!seq;
                end if;
            end for;
            //printf "finished main loop...\n";

            
            bogus_points:=[ x : x in pts | not x in Keys(real_value)];
            verts:={@ @};
            key_list:=[k: k in Keys(real_value)];
            
            for k in key_list do
                //printf "converting %o...\n",k;
                v:=H!Eltseq(k);
                v`algebraic_point:=k;
                v`real_algebraic_point:=real_value[k];
                verts:=verts join {@ v @};
            end for;
            
            //Test that the points are genuine;
            //printf "testing membership...\n";
            verts:=[ v : v in verts | v in pol];
            
            //this tests to see if a vertex is actually necessary by seeing it is contained in a defining hyperplane
            verts_good:=[];
            for v in verts do
                if exists{ h : h in halfspaces(pol) | algebraic_point(v) in scheme(pol) } then
                    Append(~verts_good,v);
                end if;
            end for;
                    
            
            infty:=infinity(H);
            if infinity(H) in pol then
                verts_good:=verts_good cat [infty];
            end if;
            
            pol`vertices:=verts_good;
            return verts_good,bogus_points;
        else
            pol`vertices:=[];
        end if;
    end if;
        
        return pol`vertices;
    
end intrinsic;

intrinsic prune(pol::HypPol)->HypPol
{Remove the excess halfspaces from a polyhedron given that it bounds a polytope.
It does this by making sure that every bound plane contains at least one vertex.}
    verts:=vertices(pol);
    H:=hyperbolic_space(pol);
    
    if #verts gt 0 then
    //we currently only have an algorithm if the polyhedron is a polytope
        infty:=infinity(H);
        verts_finite:=[ v : v in verts | not is_infinite(v)];

        verts_of_sides:=AssociativeArray();
        halfs:={@ h: h in halfspaces(pol) @};
        infty:=infinity(H);

        for h in halfs do
            verts_of_sides[h]:=[];
            verts_of_sides[h]:=[ v : v in verts_finite| algebraic_point(v) in scheme(h)];
        end for;
        
        halfs_new:=[h: h in halfs|#verts_of_sides[h] gt 0];
        if #halfs_new gt 0 then
            pol_new:=&meet[h: h in halfs_new];
            pol_new`vertices:=verts;
            
            pol`vertices:=pol_new`vertices;
            pol`curved_halfspaces:=pol_new`curved_halfspaces;
            pol`flat_halfspaces:=pol_new`flat_halfspaces;
            return pol_new;
        else
            pol_new:=empty_polyhedron(H);
            pol:=pol_new;
            return pol_new;
        end if;
    else
            return pol;
    end if;
end intrinsic;

intrinsic polytope(pol::HypPol)->HypPolt
{Return the polytope of the hyperbolic polyhedron when possible. This is the convex hull of a finite set of points in Satake compactified hyperbolic space.}
    if not assigned pol`polytope then
        pol_new:=prune(pol);
        polt:=New(HypPolt);
        polt`hyperbolic_space:=hyperbolic_space(pol_new);
        polt`vertices:=vertices(pol_new);
        polt`scheme:=scheme(pol_new);
        pol`polytope:=polt;
        polt`polyhedron:=pol_new;
    end if;
        return pol`polytope;
end intrinsic;

intrinsic dimension(polt::HypPolt)->RngIntElt
{Returns the dimension of a hyperbolic polytope. It is the dimension of the underlying scheme plus one.}
    return Dimension(scheme(polt))+1;
end intrinsic;

intrinsic polyhedron(polt::HypPolt : bound:=10^-10)->HypPol
{Return the underlying polyhedron of a polytope. The function checks inequalities numerically. The bound is the accuracy that we check these inequalities to.
The algorithm proceeds by taking the geodesic hyperplanes defining the underlying scheme of the polytope.
For each of these hyperplanes we plug in all of the points.
If it is zero everywhere we know the polyhedron is contained in that hyperplane.
If they are all positive we make the appropriate inequality for the associated halfspace.
If they are all negative we make the appropriate inequality for the associated halfspace.
}
    if not assigned polt`polyhedron then
        verts:=vertices(polt);
        H:=Parent(verts[1]);
        pts:=[real_algebraic_point(v) : v in verts];
        irreds:=IrreducibleComponents(scheme(polt));
        eqn_seq:=&cat[ Equations(X) : X in irreds];
        eqns:={@ eqn : eqn in eqn_seq @};

        hyperplanes:=[];
        positive:=[];
        negative:=[];
        lower:=-bound;
        upper:=bound;

        for eqn in eqns do
            values:=[Evaluate(eqn,pt) : pt in pts ];
            if &and[v lt upper and v gt lower : v in values] then
                Append(~hyperplanes,eqn);
            elif &and[v lt upper : v in values] then
                Append(~negative,eqn);
            elif &and[v gt lower : v in values] then
                Append(~positive,eqn);
            end if;
        end for;

        //check that we didn't miss anything by doing these numerical computations.
        assert [eqn : eqn in eqns] eq (hyperplanes cat negative cat positive);

        hs:=[];

        for eqn in hyperplanes do
            hs:=hs cat [halfspace(H,eqn,-1),halfspace(H,eqn,1)];
        end for;

        for eqn in positive do
            Append(~hs,halfspace(H,eqn,1));
        end for;

        for eqn in negative do
            Append(~hs,halfspace(H,eqn,-1));
        end for;

        pol:=&meet(hs);
        polt`polyhedron:=pol;
    end if;
        
    return polt`polyhedron;
end intrinsic;

intrinsic 'in'(x::SpcHypCliffElt,polt::HypPolt)->BoolElt
{Determine if a point in hyperbolic space is a member of a polytope.}
    pol:=polyhedron(polt);
    return x in pol;
    
end intrinsic;

intrinsic 'subset'(polt1::HypPolt,pol2::HypPol)->BoolElt
{Determine if a polytope is a subset of a polyhedron}
    // return forall{v: v in pol2|v in vertices(polt1)};
    // AML: it used to be as above--am I right that this doesn't make sense?
    return forall{v: v in vertices(polt1)|v in pol2};
end intrinsic;

intrinsic 'subset'(polt1::HypPolt,polt2::HypPolt)->BoolElt
{Determine if a polytope is contained in another polytope.}
    return forall{v: v in vertices(polt1)|v in polt2};
end intrinsic;

intrinsic 'eq'(polt1::HypPolt,polt2::HypPolt)->BoolElt
{Determine if two polytopes are equal}
    return (polt1 subset polt2) and (polt2 subset polt1);
    
end intrinsic;

intrinsic facets(pol::HypPol)->SeqEnum[HypPol]
{Return the facets of a hyperbolic polyhedron.}
    return faces(pol,1);
end intrinsic;


intrinsic faces(pol::HypPol,n::RngIntElt)->SeqEnum[HypPol]
{Return the codimension n polyhedra which are faces of the given polyhedra.}
    assert n ge 1;
    
    if not assigned pol`faces then
        pol`faces:=AssociativeArray();
    end if;
    
    if not n in Keys(pol`faces) then
        if n eq 1 then
            amb:=ambient_linear_polyhedron(pol);
            sides:={(h meet flip(h)) : h in halfspaces(pol)};
            fs:={pol meet side : side in sides};
            fs:=[ f : f in fs | dimension(f) eq dimension(pol)-1];
            pol`faces[n]:=fs;
        else
            fs := {};
            for f1 in faces(pol,n-1) do
                fs:=fs join {f2: f2 in faces(f1,1)};
            end for;
            output:=[f : f in fs];
            assert &and[dimension(f) eq dimension(pol)-n : f in output];
            pol`faces[n]:=output;
        end if;
    end if;
    
    return pol`faces[n];
end intrinsic;

intrinsic facets(polt::HypPolt)->SeqEnum[HypPolt]
{return the codimension 1 faces of a polytope. This is much faster than working with polyhedra.}
    if not assigned polt`faces then
        polt`faces:=AssociativeArray();
    end if;
    
    if not 1 in Keys(polt`faces) then
        H:=hyperbolic_space(polt);
        irreds:=IrreducibleComponents(scheme(polt));
        verts:=[v : v in vertices(polt) | not is_infinite(v)];
        pts:=[algebraic_point(v) : v in verts];
        fs:=[];
        for X in irreds do
            Z:=&join[Y : Y in irreds | Y ne X];
            sch:=Z meet X;
            verts:=[H!Eltseq(p) : p in pts | p in sch];
            polt0:=New(HypPolt);
            polt0`hyperbolic_space:=H;
            polt0`scheme:=sch;
            polt0`vertices:=verts;
            Append(~fs,polt0);
        end for;
        polt`faces[1]:=fs;
    end if;
    
    return polt`faces[1];

end intrinsic;
    
intrinsic faces(polt::HypPolt,n::RngIntElt)->SeqEnum[HypPolt]
{Compute the codimension n faces of a polytope. This intrinsic is faster than the one for polyhedra.}
    if not assigned polt`faces then
        polt`faces:=AssociativeArray();
    end if;
    
    if n in Keys(polt`faces) then
        return polt`faces[n];
    elif n eq 1 then
        polt`faces[1]:=facets(polt);
        return polt`faces[1];
    elif n gt 1 then
        fs:=faces(polt,n-1);
        fss:=&cat[facets(f) : f in fs];
        fss_set:={@ e : e in fss@};
        polt`faces[n]:=[f : f in fss_set];
        return polt`faces[n];
    end if;
end intrinsic;

/*
TAD:I think we have duplicated some code here. There is algebraic_point and real_algebraic point in package-cusps.mag. We should consolidate these intrinsics. I have also been trying to keep intrinsics just involving cusps and points of hyperbolic space with package-cusps.
*/

function affine_point(cusp)
  error if is_infinite(cusp), "no affine point corresponds to the cusp at infinity";
  alg := cusp`parent`clifford_algebra;
  inds := alg`vec_inds;
  aff := affine_space(hyperbolic_space(cusp`parent));
  pt := aff!Append([Eltseq(cusp)[i]: i in inds],0);
  return pt;
end function;
                                               
// AML: I am not sure about the conventions.  This probably assumes that
// all of the imaginary units square to -1.
// TAD: Yes, see line 1418. Also, I think with a little prunning of the vertices we can return a HypPolt since it is essentially a scheme with vertices. Also, I think this will work for SpcHypCliffElts more generally.

////////////////////
intrinsic geodesic(cusps::Setq[SetCspCliffElt]) -> Sch
////////////////////
{Given a set of cusps, find a geodesic of minimal dimension through them.}
  cs := Universe(cusps);
  require &and[a eq -1 : a in squares(Parent(Rep(cusps)))]: "Only implemented for squares being -1";
  
  hyp := hyperbolic_space(cs);
  aff := affine_space(hyp);
  if #cusps eq 0 then
    return EmptySubscheme(aff);
  end if;
  d := Dimension(aff);
  pts := [aff|Eltseq(affine_point(i)): i in cusps|i ne infinity(cs)];
  ls1 := LinearSystem(aff,Append([aff.i: i in [1..d-1]],1));
  for i in pts do
    ls1 := LinearSystem(ls1,i);
  end for;
  lin := BaseScheme(ls1);
  if infinity(cs) in cusps then
    sch := lin;
  else // we are looking for a hemisphere, so first we find its centre
    dists := [&+[(aff.i-x[i])^2: i in [1..d]]: x in pts];
    //TAD: This is where you are using the convention.
    //I have been doing explicit computations with clifford algebras to avoid convention mistakes.
    //See for example, the algebraic_map intrinsic in package-cusp.mag.
    
    same_dist := Scheme(aff,Append([d-dists[1]: d in dists],aff.d));
    sl := same_dist meet lin;
    if Dimension(sl) eq -1 then // IsEmpty seems not to work here
      // in this case the points are linearly dependent, so the minimal
      // geodesic subspace is vertical.
      sch := lin;
    else
      assert Dimension(sl) eq 0 and Degree(sl) eq 1;
      centre := RationalPoints(sl)[1];
      radsq := Evaluate(dists[1],Eltseq(centre));
      assert radsq gt 0;
      sch := Scheme(lin,&+[(aff.i-centre[i])^2: i in [1..d]]-radsq);
    end if;
  end if;
  assert forall{x: x in pts|x in sch};
  return sch;
end intrinsic;



//TAD: I think we should rename this one 'in'.
intrinsic cusp_in_pol(cusp::SetCspCliffElt,pol::HypPol) -> BoolElt
{Given a cusp and a polyhedron, decide whether it is contained in the closure.}
  if is_infinite(cusp) then
    return forall{x: x in pol`curved_halfspaces|x[2] eq 1};
  else
    pt := affine_point(cusp);
    return forall{x: x in pol`curved_halfspaces join pol`flat_halfspaces|Sign(Evaluate(x[1],Eltseq(pt)))*x[2] ne -1};
  end if;
end intrinsic;
          
intrinsic vertices_to_faces(cusps::Setq[SetCspCliffElt]) -> HypPol
{Given a set of cusps, construct the facets of the polyhedron they span.}
  cs := Universe(cusps);
  if not assigned cs`hyperbolic_space then cs`hyperbolic_space := hyperbolic_space(cs`clifford_algebra); end if;
  inf := cs!Infinity();
  // everything is contained in this space
  span := geodesic(cusps);
  // and every facet has number of vertices equal to the dimension
  ss := Setseq(Subsets(Set(cusps),Dimension(span)));
  faces := [];
  pol := New(HypPol);
  pol`curved_halfspaces := {};
  pol`flat_halfspaces := {};
  pol`hyperbolic_space := cs`hyperbolic_space;
  for s in ss do
    face := geodesic(Setseq(s)); // sets of cusps cause problems with the hash
    if Dimension(face) eq Dimension(span)-1 then
      // which one shouldn't matter
      neweq := rep{x: x in DefiningPolynomials(face)|x notin Ideal(span)};
      signs := {@Sign(Evaluate(neweq,Eltseq(i))): i in cusps|i ne inf@};
      if inf in cs and Degree(neweq) eq 2 then
        Include(~signs,1);
      end if;
      if {@-1,1@} notsubset signs then
        sign := rep{i: i in signs|i ne 0};
        // we could also determine here which points are the vertices
        // of which faces
        if Degree(neweq) eq 2 then
          Include(~pol`curved_halfspaces,<neweq,sign>);
        else
          Include(~pol`flat_halfspaces,<neweq,sign>);
        end if;
      end if;
    end if;
  end for;
  return pol;
end intrinsic;

intrinsic Hash(polt::HypPolt)->RngIntElt
{}
    return Hash(vertices(polt));
end intrinsic;
