/////////////////////////
intrinsic equation(P::HypPol)->RngMPol
/////////////////////////
{Equations are always normalized so the leading coefficient is 1.}
    require is_halfspace(P): "Only hyperplanes have a single equation";
    H:=hyperbolic_space(P);
    AN:=affine_space(H);
    if #P`curved_halfspaces gt 0 then
        return CoordinateRing(AN)!Rep(P`curved_halfspaces)[1];
    else
        return CoordinateRing(AN)!Rep(P`flat_halfspaces)[1];
    end if;
end intrinsic;

/////////////////////////
intrinsic sign(H::HypPol)->RngIntElt
/////////////////////////
{Return the sign of a halfspace which can only be plus or minus 1.
If it is +1 and the equation is eqn (always normalized so the leading coefficient is 1) then the halfspace is defined by eqn \geq 0. If the sign is -1 then the halfspace is defined by eqn \leq 0.
}
    require is_halfspace(H): "only halfspaces have signs";
    return Rep(H`curved_halfspaces join H`flat_halfspaces)[2];
end intrinsic;

/////////////////////////
intrinsic 'in'(pt::SpcHypCliffElt,P::HypPol)->BoolElt
/////////////////////////
{}
    if is_full(P) then
        return true;
    elif is_halfspace(P) then
        if is_infinite(pt) then
            if is_flat(P) then
                return true;
            else
                return (sign(P) ne -1);
                /*if sign(P) eq -1 then
                    return false;
                else
                    return true;
                end if;*/
            end if;
        else
            AN:=affine_space(Parent(pt));
            seq:=Eltseq(pt);
            eqn:=equation(P);
            sgn:=sign(P);
            // AML: I coerced this to Q, because Magma thinks all comparisons
            // of elements of Qbar are true, resulting in nonsense.
            // If we want to work over a general totally real field this will
            // have to be changed.
            val := Q!Evaluate(eqn,seq);
            return (val*sgn) ge 0;
        end if;
    else
        return forall{ H : H in halfspaces(P) | pt in H};
    end if;
end intrinsic;


// AML: I don't understand what operation this is supposed to be.
// If I apply it to an ideal triangle with vertices -1, 0, 1, I get the
// empty polyhedron, for example?

// TAD: I've really only been applying it to halfspaces. Yes, that is what till happen in this case.

/////////////////////////
intrinsic flip(P::HypPol)->HypPol
/////////////////////////
{change the inequality in each hyperplane}
    P1:=New(HypPol);
    P1`hyperbolic_space:=hyperbolic_space(P);
    P1`curved_halfspaces:={ <x[1],-x[2]> : x in P`curved_halfspaces};
    P1`flat_halfspaces:={ <x[1],-x[2]> : x in P`flat_halfspaces};
    return P1;
end intrinsic;


/////////////////////////
intrinsic projection(pol::HypPol)->TorPol
/////////////////////////
{Given a flat hyperbolic polyhedron project the polyhedron onto the boundary to get a TorPol.}
    require is_flat(pol): "Can only project a flat polyhedron";
    H:=hyperbolic_space(pol);
    AN:=affine_space(H);
    rows:=[];
    intercepts:=[];

    for flat in pol`flat_halfspaces do
        eqn:=flat[1];
        sgn:=flat[2];
        zeros:=[0: i in [1..dimension(H)]];

        coeffs:=[Evaluate(Derivative(eqn,AN.i),zeros) : i in [1..dimension(H)-1]];
        intercept:=Evaluate(eqn,zeros);

        if sgn eq 1 then
            aa:=coeffs; bb:=-intercept;
        elif sgn eq -1 then
            aa:=[-c : c in coeffs]; bb:=intercept;
        end if;

        Append(~rows,aa);
        Append(~intercepts,bb);
    end for;

    return &meet([HalfspaceToPolyhedron(rows[i],intercepts[i]) : i in [1..#rows]]);

end intrinsic;


/////////////////////////
intrinsic normal_and_intercept(pol::HypPol)->SeqEnum,.
/////////////////////////
{Given a flat hyperbolic halfspace get the normal vector of the hyperplane and the intercept}
    
    require is_flat(pol) and is_halfspace(pol): "pol is not a flat halfspace";
    eqn:=Equation(scheme(pol));
    return normal_and_intercept(eqn);
end intrinsic;

/////////////////////////
intrinsic normal_and_intercept(plane::Sch)->SeqEnum,.
/////////////////////////
{Given a hyperplane of the hyperplane and the intercept}
    require Degree(plane) eq 1 : "The equation must be a plane in affine space";
    eqn:=Equation(plane);
    return normal_and_intercept(eqn);
end intrinsic;

/////////////////////////
intrinsic normal_and_intercept(eqn::RngMPolElt)->SeqEnum,.
/////////////////////////
{Given the equation of a plane return the normal vector (a1,...,an) and the intercept b such that the plane is given by a1*x1+...+an*xn=b.}
    require Degree(eqn) eq 1: "Must be a hyperplane.";
    R:=Parent(eqn);
    nn:=Ngens(R);
    zeros:=[R!0: i in [1..nn]];
    coeffs:=[Evaluate(Derivative(eqn,R.i),zeros) : i in [1..nn]];
    intercept:=Evaluate(eqn,zeros);
    return coeffs,intercept;
end intrinsic;


/////////////////////////
intrinsic nearest_point(pt::Pt,plane::Sch)->Pt
/////////////////////////
{Given a plane in affine space over a field contained in the reals and a point in affine space return the point in the plane closes to the given point.
If n is the normal vector we have p+((p-p dot n)/|n|^2) n is the nearest point.
}
    require Degree(plane) eq 1: "Nearest point is only implemented for planes over the reals.";
    AN:=Ambient(plane);
    require pt in AN: "The point and the plane must be in the same ambient affine space.";
    normal,intercept:=normal_and_intercept(plane);
    p_dot_n:=&+[normal[i]*pt[i] : i in [1..Dimension(AN)]];
    n_sq:=&+[normal[i]*normal[i] : i in [1..Dimension(AN)]];
    lambda:=(-intercept-p_dot_n)/n_sq;
    pt2:=AN![pt[i]+lambda*normal[i] : i in [1..Dimension(AN)]];
    assert pt2 in plane;
    return pt2;
end intrinsic;

/////////////////////////
intrinsic distance_squared(p1::Pt,q1::Pt)->FldRatElt
/////////////////////////
{Return the Euclidean distance squared between two points in affine space.}
    assert Parent(p1) eq Parent(q1);
    N:=#Eltseq(p1);
    return &+[(p1[i]-q1[i])^2 : i in [1..N]];
end intrinsic;


/////////////////////////
intrinsic 'subset'(P1::HypPol,P2::HypPol)->BoolElt
/////////////////////////
{}

/*

Thoughts:
We have that P1 is a subset of P2 if and only if P1 is contained in every halfspace of P2, so we can reduce the problem to containment of a general convex polytope into halfspaces.
If P1 is a polytope, then we can just check membership of each of the vertices.

If P1 is a curved halfspace and P2 is a curved halfspace then we can check the circles in the plane.
If P1 is a curved halfspace and P2 is a flat halfspace then we can check that half-space and the sphere in the plane.
If P1 is a flat halfspace and P2 is a curved halfspace then NO.
If P1 is a flat halfspace and P2 is a flat halfspace then this reduces to a containment of the convex polyhedra in the plane.

I think this is best handled by a linear programing problem.
*/
  
    H:=hyperbolic_space(P1);
    AN:=affine_space(H);
    
    if is_flat_halfspace(P1) and is_curved_halfspace(P2) then
        sgn1:=sign(P1);
        sng2:=sign(P2);
        if sng2 eq -1 then
            return false; //bounded by sphere
        else
            //unbounded region of sphere
            cen2,rad_sq2:=center_and_radius_squared(P2);
            plane1:=scheme(P1);
            dist_sq:=distance_squared(cen2,plane1);
            if dist_sq gt rad_sq2 then
                return (not cen2 in P1);
            else
                return false;
            end if;
        end if;
    elif is_flat(P1) and is_flat(P2) then
        return projection(P1) subset projection(P2);
    //elif is_curved_halfspace(P1) and is_curved_halfspace(P2) then
        //This is where we need to use Adam's the MLP thing.
    elif is_curved_halfspace(P1) and is_flat_halfspace(P2) then
        sgn1:=sign(P1);
        sng2:=sign(P2);
    
        if sgn1 eq 1 then
            return false; //unbounded region for sphere
        else
            cen,rad:=center_and_radius_squared(P1);
            plane2:=scheme(P2);
            n2,b2:=normal_and_intercept(P2);
            
            if dist_sq(cen,plane2) gt rad^2 then
                return (cen in P2);
            else
                return true;
            end if;
            
        end if;
    else
        //assumes it can be made into a polytope
        return polytope(P1) subset P2;
    end if;
end intrinsic;




