Q:=RationalField();
Qbar:=AlgebraicClosure(Q);
RR:=RealField();
Z:=IntegerRing();


/*
There are a set of half spaces defining a convex polyhedron. There have meets but not joins—the union of two convex polyhedra is not a convex polyhedra.

The boundary is not itself a convex polytope, but each face itself is. The boundary is a polyhedral complex. It is described by a scheme and an underlying set of points that are the zero faces.
*/



/*
Claim.
The geodesic between any two points is the intersection of a flat hyperplane containing it and a curves hyperplane containing it.

The vertical hyperplane containing the two points is clear. It corresponds to the line in the boundary connecting the two points. It is two dimensional.

For the sphere centered at the boundary once you fix a point, any curved hyperplane will be determined by the center in the boundary. (You can think about moving the center of the sphere around but "pinned" to a given point and then having that sphere intersecting another sphere. )

In any direction of the boundary away from the pinned point there is a halfspace in the boundary defined by the projection of the pinned point and the direction. If that half space contains the projection of the other point, then eventually there will exist a radius that will intersect the other point. So there exists an (N-1)-1 dimensional set of spheres containing the two points.
/*

/*
Formula I want to save for later:

Ratcliffe section 4.6, Theorem 4.6.1

cosh d(x,y) = 1+|x-y|^2/2*x[n]*y[n]
*/


/*
For polytopes, we take the scheme and the extremal point.

The faces are the irreducible components with the extremal points that are contained in it.
*/


/*
Ratcliffe Theorem 4.6.4

Hyperbolic spheres:
--Euclidean spheres contained in the upper half space.
*/


/*
Ratcliff Theorem 4.6.5

Horosphere based at b in the boundary
--b=infty, and Euclidean hyperplane parallel to boundary
--b != infty, and Euclidean sphere tangent at b
*/


declare type HypPol;
declare attributes HypPol: hyperbolic_space, flat_halfspaces, curved_halfspaces, vertices, polytope, faces;

/*
Better method for vertices of HypPol: really we should have the vertices of HypPol return the vertices of the HypPolt provided they exist. This might require some careful thinking. Right now it is going to return infinity as a vertex of everything. We need to test if something is a polytope. Really, we need a non-empty cluster for the polytope to exist.
*/

declare type HypPolt;
declare attributes HypPolt: hyperbolic_space, vertices, scheme, cluster, polyhedron, faces;
/*
A hyperbolic polytope is going to be the convex hull of a finite set of points. It's sides are going to be represented by a scheme which is the union of hyperplanes that contain it. The vertices are going to be HypSpcCliffElts and they are going to be points in the splitting field of the cluster.

This representation makes things like the facets to compute. The facets then are going to be determined by the irreducible components of the underlying scheme together with the points that are contained within those facets.

The action of the AlgMatElt[AlgClff] is going to be determined by the action on the vertices and the underlying scheme.

The halfspaces are going to be determined by the equations of the irreducible component and the sign of the inequality is determined by whether the points evaluate to something greater than or equal to zero. We need to write a little function for this.
*/


declare type PolComp;
declare attributes PolComp: ambient, polyhedra,faces;

/*
The polyhedron defined by the system of inequalities Aiv≥ci for each vector Ai and integer ci.

*/

/////////////////////////
intrinsic empty_polyhedron(H::SpcHypCliff)->HypPol
/////////////////////////
{Return all of H as a polyhedron.}
    P:=New(HypPol);
    P`curved_halfspaces:={};
    P`flat_halfspaces:={};
    P`hyperbolic_space:=H;
    return P;
end intrinsic;

/////////////////////////
intrinsic is_full(pol::HypPol)->BoolElt
/////////////////////////
{Is the polyhedron all of hyperbolic space?}
    return #halfspaces(pol) eq 0;
end intrinsic;


/////////////////////////
intrinsic sphere_equation(pt_csp::SetCspCliffElt, rad::.)->RngMPolElt,Sch
/////////////////////////
{Find the algebraic equation of a sphere. This is coded to work with clifford algebra so it is impossible to mess up conventions. We take an element of a clifford algebra with the correct multiplication rules over a function field with N indeterminates, where N is the dimension of the hyperbolic space, then compute the equation of a sphere there using Weil restriction.}

    //stuff we need
    H:=hyperbolic_space(Parent(pt_csp));
    N:=dimension(H);
    cl:=clifford_algebra(H);
    cl_big:=big_clifford_algebra(H);
    AN:=affine_space(H);
    
    //We will first create a bubble of radius rad^2.
    
    //create function field for coeffs
    R<[a]>:=PolynomialRing(Q,dimension(H));
    F<[a]>:=FieldOfFractions(R);
    sqs:=squares(cl);
    clF<[I]>:=clifford_algebra(F,sqs cat [-1]);
    
    //generic clifford vector
    x_general:=a[1]+&+[a[i+1]*I[i] : i in [1..arity(clF)]];
    
    //equation of the sphere
    y_general:=nm(x_general)-rad^2;
    
    //extract the coefficients (Weil restriction)
    y_vec:=vector(y_general);
    seq:=Eltseq(y_vec);
    eqn0:=seq[1];
    
    //now we turn it into a scheme by converting it to an element of the coordinate ring for the appropriate affine space.
    eqn1:=CoordinateRing(AN)!Evaluate(eqn0,[AN.i : i in [1..dimension(H)]]);
    sphere := Scheme(AN,eqn1);
    
    //now to take account for translations we use the built-in translation mechanism for schemes
    pt_AN:=AN!Eltseq(-vector(cl_big!clifford_vector(pt_csp)));
    f:=Translation(AN,pt_AN);
    my_sphere:=f(sphere);
    eqn:=Generators(Ideal(my_sphere))[1];
    assert eqn in CoordinateRing(AN);
    
    //normalize the equation
    return CoordinateRing(AN)!(eqn/AbsoluteValue(LeadingCoefficient(eqn))),my_sphere;
end intrinsic;


/////////////////////////
intrinsic curved_halfspace(H::SpcHypCliff,eqn::RngMPolElt,sgn::RngIntElt)->HypPol
/////////////////////////
{}
    P:=New(HypPol);
    AN:=affine_space(H);
    eqn0:=Evaluate(eqn,[AN.i : i in [1..dimension(H)]]);
    eqn1:=eqn0/AbsoluteValue(LeadingCoefficient(eqn0));
    assert eqn1 in CoordinateRing(AN);
    P`curved_halfspaces:={<CoordinateRing(AN)!eqn1,sgn>};
    P`flat_halfspaces:={};
    P`hyperbolic_space:=H;
    return P;
end intrinsic;

/////////////////////////
function ellipsoid_data(f)
/////////////////////////
    P:=Parent(f);
    zeros:=[ 0 : i in [1..Ngens(P)]];

    translates:=[];
    centers:=[];
    scale:=[];

    cv:=f;
    c:=Evaluate(cv,zeros);


    for i in [1..Ngens(P)] do
        v:=P.i;
        av:=Derivative(f,2,v)/2;
        bv:=Derivative(f,1,v);

        a:=Evaluate(av,zeros);
        b:=Evaluate(bv,zeros);
        //assert f1 eq a*v^2+b*v+c;

        cen:=-b/(2*a);
        coeff:=a;
        trans:=-a*(cen)^2;
        rebuild:=coeff*(v-cen)^2+trans;

        Append(~scale,coeff);
        Append(~centers,cen);
        Append(~translates,trans);
    end for;

    translate:=&+(translates)+c;
    rebuild:=&+[scale[i]*(P.i-centers[i])^2 : i in [1..Ngens(P)]]+translate;
    assert rebuild eq f;
    
    return scale,centers,translate;
end function;

/////////////////////////
intrinsic center(H::SpcHypCliff)->SpcHypCliffElt
/////////////////////////
{Return the center of the curve halfspace}
    eqn:=equation(H);
    center,radius,translate:=ellipsoid_data(eqn);
    return center;
end intrinsic;

/////////////////////////
intrinsic radius_squared(H::SpcHypCliff)->.
/////////////////////////
{Return the center of the curve halfspace}
    eqn:=equation(H);
    center,radius,translate:=ellipsoid_data(eqn);
    return radius^2; //not sure if that is right.
end intrinsic;

/////////////////////////
intrinsic curved_halfspace(cen::SpcHypCliffElt,rad::.)->HypPol
/////////////////////////
{}
    H:=Parent(cen);
    AN:=affine_space(H);
    C:=cusps(H);
    pt_csp:=C!cen;
    eqn:=sphere_equation(pt_csp,rad);
    sgn:=+1;
    
    P:=New(HypPol);
    eqn0:=eqn/AbsoluteValue(LeadingCoefficient(eqn));
    P`curved_halfspaces:={<eqn0,sgn>};
    P`flat_halfspaces:={};
    P`hyperbolic_space:=H;
    return P;
end intrinsic;

/////////////////////////
intrinsic curved_halfspace(cen::SetCspCliffElt,rad::.)->HypPol
/////////////////////////
{}
    H:=hyperbolic_space(Parent(cen));
    cen_H:=H!cen;
    return curved_halfspace(cen_H,rad);
end intrinsic;

/////////////////////////
intrinsic bubble(H::SpcHypCliff)->HypPol
/////////////////////////
{Return the region associated to x0^2 + ... + xn^2 >=1 (in the ellipsoid coordinates).}

    C:=cusps(H);
    cl:=clifford_algebra(H);
    pt_cusp:=H!C!cl!0;
    return flip(curved_halfspace(pt_cusp,1));

end intrinsic;

/////////////////////////
intrinsic center_and_radius_squared(pol::HypPol)->HypPolElt,FldRatElt
/////////////////////////
{Given curved halfspace find the center and radius squared of the associated sphere.}
    require is_curved_halfspace(pol): "Only curved halfspaces have a center and radius";
    H:=hyperbolic_space(pol);
    eqn:=equation(pol);
    scale,centers,neg_radsq:=ellipsoid_data(eqn);
    return H!centers,-neg_radsq;
end intrinsic;

intrinsic halfspace(H::SpcHypCliff,eqn::RngMPolElt,sgn::RngIntElt)->HypPol
{Given a hyperbolic space, an equation f of a geodesic plane in the halfspace model and a sgn return the hyperbolic polyhedron defined by the halfspace sign*f <=0 }
    AN:=affine_space(H);
    eqn0:=CoordinateRing(AN)!eqn;
    if Degree(eqn0) eq 1 then
        return flat_halfspace(H,eqn0,sgn);
    elif Degree(eqn0) eq 2 then
        return curved_halfspace(H,eqn0,sgn);
    else
        error "The equation must be for a plane or a sphere whose center is on the boundary of hyperbolic space.";
    end if;
end intrinsic;


/////////////////////////
intrinsic flat_halfspace(H::SpcHypCliff,eqn::RngMPolElt,sgn::RngIntElt)->HypPol
/////////////////////////
{}
    P:=New(HypPol);
    eqn0:=eqn/AbsoluteValue(LeadingCoefficient(eqn));
    P`flat_halfspaces:={<eqn0,sgn>};
    P`curved_halfspaces:={};
    P`hyperbolic_space:=H;
    return P;
    
end intrinsic;

/////////////////////////
intrinsic hyperbolic_space(pol::HypPol)->SpcHypCliff
/////////////////////////
{}
    return pol`hyperbolic_space;
end intrinsic;

/////////////////////////
intrinsic curved_halfspaces(pol::HypPol)->SetEnum[HypPol]
/////////////////////////
{}
    H:=hyperbolic_space(pol);
    return {curved_halfspace(H,x[1],x[2]) : x in pol`curved_halfspaces};
end intrinsic;

/////////////////////////
intrinsic flat_halfspaces(pol::HypPol)->SetEnum[HypPol]
/////////////////////////
{}
    H:=hyperbolic_space(pol);
    return {flat_halfspace(H,x[1],x[2]) : x in pol`flat_halfspaces};
end intrinsic;

/////////////////////////
intrinsic is_halfspace(pol::HypPol)->SetEnum[Tup]
/////////////////////////
{}
    return #curved_halfspaces(pol)+#flat_halfspaces(pol) eq 1;
end intrinsic;

/////////////////////////
intrinsic is_curved(pol::HypPol)->BoolElt
/////////////////////////
{}
    return #pol`flat_halfspaces eq 0;
end intrinsic;

/////////////////////////
intrinsic is_flat(pol::HypPol)->BoolElt
/////////////////////////
{}
    return #pol`curved_halfspaces eq 0;
end intrinsic;

/////////////////////////
intrinsic is_curved_halfspace(pol::HypPol)->BoolElt
/////////////////////////
{Returns true if the polyhedron is a curved halfspace.}
    return is_curved(pol) and is_halfspace(pol);
end intrinsic;

/////////////////////////
intrinsic is_flat_halfspace(pol::HypPol)->BoolElt
/////////////////////////
{Returns true if the polyhedron is a flat halfspace.}
    return is_flat(pol) and is_halfspace(pol);
end intrinsic;

/////////////////////////
intrinsic halfspaces(pol::HypPol)->SetEnum[HypPol]
/////////////////////////
{}
    return curved_halfspaces(pol) join flat_halfspaces(pol);
end intrinsic;

/////////////////////////
intrinsic polyhedron(H::SpcHypCliff,pol0::TorPol)->HypPol
/////////////////////////
{Create a hyperbolic polyhedron from a TorPol.}
    require dimension(H) eq 1+Dimension(Ambient(pol0)): "dim(pol) + 1 eq dim(H) fails.";
    pol:=New(HypPol);
    AN:=affine_space(H);
    flat_halfspaces:=[];
    inequalities:=Inequalities(pol0);

    for inequality in inequalities do
        coeffs:=Eltseq(inequality[1]);
        intercept:=inequality[2];
        eqn:=&+[coeffs[i]*AN.i : i in [1..#coeffs]]-intercept;
        Append(~flat_halfspaces,<eqn,1>);
    end for;
    
    pol`curved_halfspaces:={};
    pol`flat_halfspaces:={x : x in flat_halfspaces};
    pol`hyperbolic_space:=H;
    return pol;
end intrinsic;

/////////////////////////
intrinsic 'eq'(pol1::HypPol,pol2::HypPol)->BoolElt
/////////////////////////
{Checks equality of halfspaces. This intrinsic won't work properly unless there are no redundant halfspaces in the set of halfspaces defining the equation.}
    if is_halfspace(pol1) and is_halfspace(pol2) then
        return sign(pol1)*equation(pol1) eq sign(pol2)*equation(pol2);
    else
        return (pol1 subset pol2) and (pol2 subset pol1);
    end if;
end intrinsic;


/////////////////////////
intrinsic Print(P::HypPol)
/////////////////////////
{Print statement for a convex polyhedron in hyperbolic space.}
    //-----
    function halfspace_string(P)
    //-----
        if sign(P) eq -1 then
            return Sprintf("%o <= 0",equation(P));
        elif sign(P) eq 1 then
            return Sprintf("%o >= 0",equation(P));
        end if;
    end function;
    
    if is_halfspace(P) then
        printf "Hyperbolic halfspace defined by " cat halfspace_string(P);
    else
        out:=[halfspace_string(H) cat "\n":H in halfspaces(P)];
        printf "Hyperbolic convex polyhedron defined by " cat &cat(out);
    end if;

end intrinsic;

/////////////////////////
intrinsic scheme(P::HypPol)->RngIntElt
/////////////////////////
{For all halfspaces take the union of the defining hyperplanes.}
    HN:=hyperbolic_space(P);
    AN:=affine_space(HN);
    
    halfs:=halfspaces(P);
    hyperplane_halfs:={@ h : h in halfs | flip(h) in halfs @};
    
    my_scheme:=(&join[Scheme(AN,equation(h)) meet ambient_linear_scheme(P) : h in halfspaces(P) | not h in hyperplane_halfs]);
    assert AmbientSpace(my_scheme) eq AN;
    return my_scheme;
end intrinsic;


/////////////////////////
intrinsic dimension(P::HypPol)->RngIntElt
/////////////////////////
{Return the dimension of a convex polyhedron.}
    return Dimension(ambient_linear_scheme(P));
end intrinsic;



//This is the intersection of the halfspaces except we remove any halfspace that is contained in any other halfspace. This begs the question: given a set of halfspaces, what is a normal form for the set of equations?

