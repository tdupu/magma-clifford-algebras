////////////////////////////////////////
//  Subset/Meet Convex Optimization
////////////////////////////////////////
////////////////////////////////////////
////////////////////////////////////////

/////////////////////////
intrinsic SOCP_max(constraints::SeqEnum[Tup],target::Tup : filename:="temp.txt")->RngIntElt,.,.
/////////////////////////
{
Maximize:\n
|At x + bt|_2 - (ct^T*x + dt)\n\n

Subject to:\n
|A_i x +b_i|_2 \leq c_i^T*x+d_i, for i=1,...,m\n
Fx=g.\n\n

where\n \n

x in RR^n,\n
f in RR^n,\n
A_i in n_i x n\n
b_i in RR^n_i \n
c_i in RR^n \n
d_i in RR \n \n

    --constraint: A sequence of <Ai,bi,ci,di> \n
    --target: <At,bt,ct,dt> \n \n
}
    
    /*
    We create a text file which instantiates
    --A,b,c,d, python lists
    --ni, python list
    --m, int, length of constraints
    --n, int, length of x
    --At,bt,ct,dt list of lists, list, list, element
    */
    
    At:=target[1];
    bt:=target[2];
    ct:=target[3];
    dt:=target[4];
    
    m:=#constraints;
    n:=Ncols(At);
    nis:=[];
    
    file := Open(filename,"w");
    
    //record the target information and m and n
    str := Sprintf(
    "
    m=%o\n
    n=%o\n
    At=%o\n
    bt=%o\n
    ct=%o\n
    dt=%o\n
    ", m,n,At,bt,ct,dt);
    Write(file,str);
    
    
    //record the constraints
    for con in constraints do
        A := con[1];
        b := con[2];
        c := con[3];
        d := con[4];
        str := Sprintf(
            "
            A.append(%o)\n
            b.append(%o)\n
            c.append(%o)\n
            d.append(%o)\n
            ", A,b,c,d);
        Write(file,str);
        
        Append(~nis,#Eltseq(b));
    end for;
    
    //record the nis
    str := Sprintf(
    "
    ni=%o
    ", nis);
    Write(file,str);
    
    delete file;
    
    ans,value_raw,x_raw := System("python optimize.py" cat " " cat filename); //I removed div 256
    
    if ans eq 0 then
        return 0;
    else
        return 1, value_raw,x_raw;
    end if;
    
end intrinsic;


