intrinsic polyhedral_complex(pols::SetEnum[HypPol])->PolComp
{Given a set of hyperbolic polyhedra, create a polyhedral complex}
/*
Some testing needs to be added here at the top level. Polyhedra can only intersect at faces (of any codimension).
*/
    pol_comp:=New(PolComp);
    pol_comp`ambient:=hyperbolic_space(Rep(pols));
    pol_comp`polyhedra:=pols;
    pol_comp`faces:=AssociativeArray();
    return pol_comp;
end intrinsic;

intrinsic polyhedra(pol_comp::PolComp)->SetEnum
{Return the underlying polyhedra of a polyhedral complex}
    return pol_comp`polyhedra;
end intrinsic;

intrinsic dimension(pol_comp::PolComp)->RngIntElt
{Return the dimension of a polyhedral complex}
    pol:=Rep(polyhedra(pol_comp));
    return dimension(pol);
end intrinsic;

