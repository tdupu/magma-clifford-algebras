/////////////////////////
intrinsic vertices(pol::HypPolt)->SetEnum[SpcHypCliffElt]
/////////////////////////
{Return the vertices of the underlying hyperbolic space.}
    return pol`vertices;
end intrinsic;

/////////////////////////
intrinsic hyperbolic_space(pol::HypPolt)->SpcHypCliff
/////////////////////////
{Return the underlying compactified hyperbolic space of a convex hyperbolic polytope.}
    return pol`hyperbolic_space;
end intrinsic;

/////////////////////////
intrinsic scheme(pol::HypPolt)->Sch
/////////////////////////
{Return the scheme associated to a convex hyperbolic polytope.}
    return pol`scheme;
end intrinsic;

