//  SL2 ACTION
////////////////////////////////////////
////////////////////////////////////////
////////////////////////////////////////


intrinsic '*'(g::AlgMatElt,P::HypPol)->HypPol
{Given a matrix of Clifford algebra elements act on a hyperbolic polyhedron by a fractional linear transformation.}
    H:=hyperbolic_space(P);
    g_alg,rationals:=map_of_affine_space(H,g^-1);
    
    /*
    Do it for halfspaces then if it isn't a halfspace take the intersection of the moved halfspaces.
    */
    
    if is_halfspace(P) then
        sgn:=sign(P);
        /*
        We had to compose the equations "by hand" to get the right behavior here.
        There is a sticky point dealing with the sign of equations defining schemes since we are dealing with inequalities.
        */
        eqn:=Numerator(Evaluate(equation(P),rationals));
        d:=Degree(eqn);
        if d eq 1 then
            return flat_halfspace(H,eqn,sgn);
        elif d eq 2 then
            return curved_halfspace(H,eqn,sgn);
        else
            error "invalid equation: must have degree 1 or 2";
        end if;
    else
        halfs:=halfspaces(P);
        return &meet[g*h : h in halfs];
    end if;
    
end intrinsic;


