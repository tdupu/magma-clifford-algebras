//############################
intrinsic Hash(x::SetCspCliffElt) -> RngIntElt
//############################
{Return a hash value for the object x (should be between 0 and 2^31-1)}
    if not is_infinite(x) then
        x_mag:=get_magma_element(x);
        return Hash(x_mag);
    else
        cl:=clifford_algebra(Parent(x));
        return Hash(<cl,0>);
    end if;
end intrinsic;


