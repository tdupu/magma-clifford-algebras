//#######################
intrinsic hyperbolic_space(cl::CliffAlg) -> SpcHypCliff
//#######################
{
Create a partial Satake compactified hyperbolic space with cusps from the designated Clifford algebra.
}
  cusps:=cusps(cl);
  if assigned cusps`hyperbolic_space then
    return cusps`hyperbolic_space;
  else
    H := New(SpcHypCliff);
    cl_big:=extend(cl);
    H`cusps:=cusps;
    H`affine_space:=AffineSpace(Q,arity(cl)+2);
    H`big_clifford_algebra:=cl_big;
    cusps`hyperbolic_space:=H;
    return H;
  end if;
end intrinsic;

//#######################
intrinsic hyperbolic_space_with_cusps(cl::CliffAlg) -> SpcHypCliff
//#######################
{
Create a partial Satake compactified hyperbolic space with cusps from the designated Clifford algebra.
}
    return hyperbolic_space(cl);
end intrinsic;

//#######################
intrinsic hyperbolic_space(cusps::SetCspCliff)->SpcHypCliff
//#######################
{Return the Satake compactified hyperbolic space of which cusps is the boundary}
    return hyperbolic_space(clifford_algebra(cusps));
end intrinsic;


//#######################
intrinsic 'eq'(H1::SpcHypCliff,H2::SpcHypCliff)->BoolElt
//#######################
{Test equality of hyperbolic spaces.}
    return  H1`cusps eq H2`cusps and H1`affine_space eq H2`affine_space;
end intrinsic;


//#######################
intrinsic Print(H::SpcHypCliff)
//#######################
{The print statement for SpcHypCliff
}
    printf "Satake compactified hyperbolic space of dimension %o with clifford vectors from %o", dimension(H),clifford_algebra(H);
end intrinsic;

//#######################
intrinsic Print(pt::SpcHypCliffElt)
//#######################
{The print statement for SpcHypCliffElt
}
    if is_infinite(pt) then
        printf "infinity";
    else
        printf "%o", [RealField(4)!x : x in Eltseq(real_algebraic_point(pt))];
    end if;
end intrinsic;


//#######################
intrinsic cusps(H::SpcHypCliff) -> SetCspCliff
//#######################
{
Return the cusps for the boundary of the hyperbolic space.
}
    return H`cusps;
end intrinsic;

//#######################
intrinsic clifford_algebra(H::SpcHypCliff) -> CliffAlg
//#######################
{
Return the clifford algebra of the base of the underlying space.
}
    return clifford_algebra(cusps(H));
end intrinsic;

//#######################
intrinsic dimension(H::SpcHypCliff) -> RngIntElt
//#######################
{
Return the dimension of the hyperbolic space.
}
    return arity(clifford_algebra(cusps(H)))+2;
end intrinsic;

/////////////////////////
intrinsic affine_space(H::SpcHypCliff)->Sch
/////////////////////////
{Return a copy of affine space of the appropriate dimension}
    if not assigned H`affine_space then
        H`affine_space:= AffineSpace(Q,dimension(H));
    end if;
    
    return H`affine_space;
end intrinsic;

////////////////////
intrinsic algebraic_point(pt::SpcHypCliffElt)->Pt
////////////////////
{Convert a point in hyperbolic space to a point in affine space.}
    if not assigned pt`algebraic_point then
        AN:=affine_space(Parent(pt));
        seq:=Eltseq(pt);
        F:=Parent(seq[1]);
        pt`algebraic_point:=AN(F)!seq;
    end if;
        return pt`algebraic_point;
end intrinsic;

////////////////////
intrinsic real_algebraic_point(pt::SpcHypCliffElt)->Pt
////////////////////
{Convert a point in hyperbolic space to a point in affine space with values in a real field.
This may need to be modified to account for other coordinates. There should only be a single real embedding for this to work.}
    if not assigned pt`real_algebraic_point then
        H:=Parent(pt);
        AN:=affine_space(H);
        n:=dimension(H);
        RR:=RealField();
        seq:=Eltseq(pt);
        num:=Eltseq(pt)[n];
        fy:=MinimalPolynomial(num);
        if Degree(fy) eq 1 then
            seq0:=[RR!Q!s : s in seq];
        else
            F<a>:=NumberField(fy);
            y_val:=[ x : x in RealEmbeddings(a) | x gt 0][1];
            seq0:=[RR!Q!s : s in seq[1..n-1]] cat [RR!y_val];
        end if;
        pt`real_algebraic_point:=AN(RR)!seq0;
    end if;
        return pt`real_algebraic_point;
end intrinsic;



//#######################
intrinsic elt(H::SpcHypCliff, eltseq::SeqEnum[RngElt]) -> SpcHypCliffElt
//#######################
{Create a point of hyperbolic space}
    
    N:=dimension(H);

    require #eltseq eq N: "The number of elements in the sequence is not of the correct dimension.";
    require eltseq[N] ge 0: "eltseq must have a non-negative height.";
    
    //AN:=affine_space(H);
    
    pt := New(SpcHypCliffElt);
    pt`parent:=H;
    pt`vector:=Vector(eltseq);
    //pt`vector:=AN(Qbar)!eltseq;
    pt`is_infinite:=false;
    
    return pt;
end intrinsic;


//#######################
intrinsic Parent(pt::SpcHypCliffElt) -> SpcHypCliff
//#######################
{Return the underlying hyperbolic space of a point in hyperbolic space.}
    return pt`parent;
end intrinsic;

//#######################
intrinsic is_infinite(x::SpcHypCliffElt) -> BoolElt
//#######################
{Create a point of hyperbolic space}
    return x`is_infinite;
end intrinsic;

//#######################
intrinsic Eltseq(x::SpcHypCliffElt) -> SeqEnum[RngElt]
//#######################
{Return the Eltseq of the corresponding vector if possible.}
    require not is_infinite(x): "element must not be infinite";
    return Eltseq(vector(x));
    
end intrinsic;

//#######################
intrinsic infinity(H::SpcHypCliff) -> SpcHypCliffElt
//#######################
{Create an infinite element for hyperbolic space.}
    pt:=New(SpcHypCliffElt);
    pt`is_infinite:=true;
    pt`vector:=infty;
    pt`parent:=H;
    return pt;
end intrinsic;

////////////////////////
intrinsic vector(pt::SpcHypCliffElt)->ModTupRngElt
////////////////////////
{Return the coordinates of the point in hyperbolic space}
    require not is_infinite(pt): "Can't be an infinite point of partial Satake compactified hyperbolic space";
    return pt`vector;
end intrinsic;


//#######################
intrinsic height(x::SpcHypCliffElt) -> RngElt
//#######################
{
Get the last component of an element of hyperbolic space. All cusps (as hyperbolic space elements) are defined to have height zero. In particular infinity has height zero.
}
    if is_infinite(x) then
        return 0;
    else
        seq:=Eltseq(x);
        return seq[#seq];
    end if;
end intrinsic;


//#######################
intrinsic is_cusp(x::SpcHypCliffElt) -> BoolElt,.
//#######################
{Determine if an element is in the boundary of compactified hyperbolic space.}
    if is_infinite(x) then
        return true, infinity(cusps(Parent(x)));
    else
        v:=Eltseq(x);
        if v[#v] eq 0 then
            return true, cusps(Parent(x))! [v[i]:i in [1..#v-1]];
        else
            return false;
        end if;
    end if;
end intrinsic;

//#######################
intrinsic cusp(x::SpcHypCliffElt) -> SetCspCliffElt
//#######################
{Return the element as SetCspCliffElt if possible.}
    flag,c:=is_cusp(x);
    require flag: "Element is not a cusp.";
    return c;
end intrinsic;

//#######################
intrinsic elt(H::SpcHypCliff,x::ModTupRngElt) -> SpcHypCliffElt
//#######################
{Determine if an element is in the boundary of compactified hyperbolic space.}
    return H! Eltseq(x);
end intrinsic;

//#######################
intrinsic elt(H::SpcHypCliff,x::Pt[FldAC]) -> SpcHypCliffElt
//#######################
{Construct of Satake compactified hyperbolic space from a Qbar-point in affine space. The point should be totally real.}
    return H! Eltseq(x);
end intrinsic;

//#######################
intrinsic elt(H::SpcHypCliff,x::CliffAlgElt) -> BoolElt
//#######################
{If x is a Clifford vector coercible into hyperbolic space then  }
    cl_big:=big_clifford_algebra(H);
    
    if x in cl_big then
        return H!vector(x); //this will return an error if x is not a clifford vector.
    else
        require is_extension(cl_big,Parent(x)): "The big Clifford algebra of H must be an extension of the parent of x.";
        return H!cl_big!x;
    end if;
end intrinsic;

//#######################
intrinsic big_clifford_algebra(H::SpcHypCliff) -> CliffAlg
//#######################
{Return the big clifford algebra.}
    return H`big_clifford_algebra;
end intrinsic;

//#######################
intrinsic clifford_vector(x::SpcHypCliffElt) -> CliffAlgElt
//#######################
{Return x and an element of the big clifford algebra.}
    cl_big:=big_clifford_algebra(Parent(x));
    return clifford_vector(cl_big,vector(x));;
end intrinsic;


//#######################
intrinsic 'eq'(x::SpcHypCliffElt,y::SpcHypCliffElt) -> BoolElt
//#######################
{Determines if two element of hyperbolic space are equal.}
    if is_infinite(x) and is_infinite(y) then return true;
    elif is_infinite(x) or is_infinite(y) then return false;
    else
        //return vector(x) eq vector(y);
        return real_algebraic_point(x) eq real_algebraic_point(y);
    end if;
end intrinsic;

//#######################
intrinsic elt(H::SpcHypCliff,y::SetCspCliffElt) -> SpcHypCliffElt
//#######################
{Creates an element of compactified hyperbolic space from a cusp.}
    require cusps(H) eq Parent(y): "The cusp must be a cusp of the Satake compactification. The Clifford algebras do not match.";
    
    if is_infinite(y) then
        return infinity(H);
    else
        cl_big:=big_clifford_algebra(H);
        return H!cl_big!clifford_vector(y);
    end if;
end intrinsic;




////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////

intrinsic IsCoercible(C::SetCspCliff,pt::SpcHypCliffElt)->BoolElt,.
{}
    seq:=Eltseq(pt);
    if dimension(C)+1 eq #seq then
        if seq[#seq] eq 0 then
            cl:=clifford_algebra(C);
            v:=clifford_vector(cl,Vector([seq[i] : i in [1..#seq-1]]));
            return true, C!v;
        else return
            false;
        end if;
    else
        return false;
    end if;
end intrinsic;


intrinsic IsCoercible(H::SpcHypCliff,x::.)->BoolElt,.
{}
    if Type(x) eq SpcHypCliffElt then
        if Parent(x) eq H then
            return true, x;
        elif is_infinite(x) then
            return true, infinity(H);
        else
            return true, elt(H,Eltseq(x));
        end if;
    elif Type(x) eq Pt then
        if Parent(x) eq affine_space(H) then
            return true,H!Eltseq(x);
        else
            return false;
        end if;
    else
        return true, elt(H,x);
    end if;
end intrinsic;



////////////////////
intrinsic cusps(SL2O::GrpPSL2Cliff,PSigma::GrpFP)->SeqEnum[SetCspCliffElt],SeqEnum[AlgMatElt]
////////////////////
{Compute a collection of representatives of cusps of PSigma subset PSL2O and a collection of matrices g such that g(infty) is that representative. The algorithm uses a double coset decomposition. Here the orbit of infinity under PSL2(O) is isomorphic to PSL2(O)/stab as a set with a group action. It has a left action by PSigma and hence PSigma\PSL2(O)/stab is in bijection with orbits of the cusps under PSigma.
}
    O:=clifford_order(SL2O);
    cl:=clifford_algebra(O);
    csps:=cusps(cl);
    infty:=infinity(csps);
    psl2_quo:=fp_group(SL2O);
    sl2_infty,stab_to_psl2,gens_infty:=stabilizer_infty(SL2O);
    psl2_infty:=stab_to_psl2(sl2_infty);
    transversal_fp,rep_map:=Transversal(psl2_quo,PSigma,psl2_infty);
    transversal_mat:=[fp_element_to_matrix(SL2O,g) : g in transversal_fp];
    return [g(infty) : g in transversal_mat],transversal_mat;
end intrinsic;
