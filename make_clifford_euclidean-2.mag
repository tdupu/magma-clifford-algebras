AttachSpec("hecke.spec");
SetVerbose("LMFDB",4);
SetLMFDBRootFolder(".");
Z:=Integers();
Q:=RationalField();


squares:=[[-1,-1],[ -1, -2 ],[ -1, -3 ],[ -2, -3 ],[ -2, -5 ],[ -1, -6 ],[ -2, -6 ],[ -1, -7 ],[ -1, -10 ],[ -2, -10 ],[ -2, -14 ],[ -2, -26 ]];

for sqs in squares do
    cl := clifford_algebra(Q,sqs);
    ords := get_maximal_orders(cl);
    write_lmfdb_clifford_orders(cl,ords);
end for;
