intrinsic jsonify_integer_matrix(mat::AlgMatElt[RngInt])->SeqEnum[SeqEnum[RngIntElt]]
//##########################
{}
    return [Eltseq(row) : row in Rows(mat)];
end intrinsic;

//##########################
intrinsic dejsonify_integer_matrix(seq::SeqEnum[SeqEnum[RngIntElt]])->AlgMatElt[RngInt]
//##########################
{}
    return Matrix(seq);
end intrinsic;

//########################
intrinsic dejsonify_matrix(cl_mag::AlgClff,json::SeqEnum)->AlgMatElt
//########################
{}
//assumes the matrix is square
/*
    
    EXAMPLES:
        mat eq dejsonify_matrix(cl_mag,jsonify_matrix(mat));

*/
    GL2:=GL(2, cl_mag);
    n:=#json;
    return GL2!Matrix([[ dejsonify_magma_element(cl_mag,json[i][j]) : j in [1..n]]: i in [1..n]]);
end intrinsic;

