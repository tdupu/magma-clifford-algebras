//#####################
intrinsic 'eq'(X1::LMFDBCliffOrd,X2::LMFDBCliffOrd)->BoolElt
//#####################
{}
    return LMFDB_equality(X1,X2);
end intrinsic;

//#####################
intrinsic 'eq'(X1::LMFDBGrpSL2Cliff,X2::LMFDBGrpSL2Cliff)->BoolElt
//#####################
{}
    return LMFDB_equality(X1,X2);
end intrinsic;

//#####################
intrinsic 'eq'(X1::LMFDBGrpSL2CliffGamma0,X2::LMFDBGrpSL2CliffGamma0)->BoolElt
//#####################
{}
    return LMFDB_equality(X1,X2);
end intrinsic;

//#####################
intrinsic 'eq'(X1::LMFDBHeckeMatrices,X2::LMFDBHeckeMatrices)->BoolElt
//#####################
{}
    return LMFDB_equality(X1,X2);
end intrinsic;


//#####################
intrinsic LMFDB_equality(X1::Any,X2::Any)->BoolElt
//#####################
{}
    my_type:=Type(X1);
    require Type(X1) eq Type(X2): "object must be LMFDB object of the same type";
    for attr in GetAttributes(my_type) do
        if Get(X1,attr) eq Get(X2,attr) then
            //do nothing
        else
            return false;
        end if;
    end for;

    return true;

end intrinsic;

