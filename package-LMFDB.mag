//###############################
intrinsic get_lmfdb_gamma0_path2(sl2o::GrpPSL2Cliff,beta::AlgMatElt)->MonStgElt
//###############################
{}
/*
TAD (11/16/2024):
    Each individual gamma0 LMFDB object is going to be stored in
    LMFDBROOT/gamma0/<order label>/<gamma0 label>.txt
    
    This is so that we can manipulate each individually.
    This is part of a re-write for gamma0 storage.
*/

    SetColumns(0);
    Folder:=get_data_folder();
    order_label := get_label(sl2o);
    gamma0_label:=get_label(sl2o,beta);
    path := Sprintf("%ogamma0/%o/%o", Folder, order_label,gamma0_label);
    return path;
    
end intrinsic;

//###############################
intrinsic get_lmfdb_gamma0_path2(X::LMFDBGrpPSL2Cliff)->MonStgElt
//###############################
{}
/*
TAD (11/16/2024):
    Each individual gamma0 LMFDB object is going to be stored in
    LMFDBROOT/gamma0/<order label>/<gamma0 label>.txt
    
    This is so that we can manipulate each individually.
    This is part of a re-write for gamma0 storage.
*/

    SetColumns(0);
    Folder:=get_data_folder();
    order_label:=get_label(O);
    gamma0_label:=X`label;
    path := Sprintf("%ogamma0/%o/%o", Folder, order_label);
    return path;
    
end intrinsic;

//###############
