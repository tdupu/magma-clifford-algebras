//###############
//###############

//#############################
intrinsic write_lmfdb_clifford_orders(cl::CliffAlg,ords::SeqEnum: overwrite := false, timing:=" ")
//#############################
{}
    datalist:=[];
    for O in ords do
        X:=create_lmfdb_object(O);
        X`timing:=timing;
        data:=SaveLMFDBObject(X);
        Append(~datalist,data);
    end for;

    file:=get_lmfdb_clifford_order_path(cl);
    
    for data in datalist do
        print_file(file, data: overwrite := overwrite);
    end for;

end intrinsic;


//#############################
intrinsic write_lmfdb_hecke(MS::ModSymCliff,alpha::AlgMatElt: timing:=" ", overwrite:=false)
//#############################
{}
        
    hecke_dict:=MS`hecke_matrices_tf;
    sl2o:=clifford_bianchi_group(MS);
    gamma0_label:=get_label(sl2o,alpha);
    X:=create_lmfdb_object(MS,alpha:timing:=timing);
    file:=get_lmfdb_hecke_path(MS,alpha);
    file;
    data:=SaveLMFDBObject(X);
    data;
    print_file(file, data: overwrite := overwrite);

end intrinsic;

//###########################
intrinsic print_file(fname::MonStgElt,data::MonStgElt: overwrite := false)
//###########################
{}
    vprintf Clifford, 4: "printing %o to %o...\n\n", data, fname;
    
    existing := OpenTest(fname, "r");
    
    
    if existing and not overwrite then
        vprintf Clifford, 4: "the file already exists...\n";
        PrintFile(fname,data);
    elif existing then
        vprintf Clifford, 4: "the file already exists, overwrite requested...\n";
        System(Sprintf("rm %o\n",fname));
        PrintFile(fname,data);
    else
        vprintf Clifford, 4: "the file does not exist, touching...\n";
        
        stuff:=Split(fname,"/");
        filename:=stuff[#stuff];
        filepath:=&*[stuff[i] * "/" : i in [1..#stuff-2]]*stuff[#stuff-1];
        System("mkdir -p " * filepath);
        System("touch " * fname);
        PrintFile(fname,data);
    end if;

end intrinsic;


//#############################
intrinsic write_lmfdb_clifford_order(cl::CliffAlg, X::LMFDBCliffOrd: overwrite := false)
//#############################
{}

    SetColumns(0);
    file:=get_lmfdb_clifford_order_path(cl);
    data:=SaveLMFDBObject(X);
    
    printf "Writing to disc...\n %o ....\n \n \n",X;
    print_file(file, data:overwrite := overwrite);
    
end intrinsic;

