//###########################
intrinsic jsonify_matrix(mat::GrpMatElt)->SeqEnum
//##########################
{}
    m:=Nrows(mat);
    n:=Ncols(mat);
    return [[jsonify_magma_element(mat[i][j]) : j in [1..n]] : i in [1..m]];
end intrinsic;

//###########################
intrinsic jsonify_matrix(mat::AlgMatElt)->SeqEnum
//##########################
{}
    cl_mag:=Parent(mat[1][1]);
    GL2:=GeneralLinearGroup(2,cl_mag);
    return jsonify_matrix(GL2!mat);
end intrinsic;

