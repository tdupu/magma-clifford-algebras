//###############################
intrinsic get_lmfdb_hecke_path(MS::ModSymCliff,beta::AlgMatElt)->MonStgElt
//###############################
{}
    SetColumns(0);
    Folder:=get_data_folder();
    O:=clifford_order(MS);
