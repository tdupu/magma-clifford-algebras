end intrinsic;

//#############################
intrinsic write_lmfdb_sl2(cl::CliffAlg,X::LMFDBGrpSL2Cliff: overwrite := false, timing:=" ")
//#############################
{}
    SetColumns(0);
    Y:=New(LMFDBGrpSL2Cliff);
    Y:=X;
    if timing ne " " then
        Y`timing:=timing;
    end if;
    file:=get_lmfdb_sl2_path(cl);
    data:=SaveLMFDBObject(Y);
    printf "Writing to disc...\n %o ....\n",Y;
    print_file(file, data: overwrite := overwrite);
end intrinsic;

//#############################
intrinsic write_lmfdb_sl2(PSL2O::GrpPSL2Cliff: overwrite := false,timing:=" ")
//#############################
{}
    X:=create_lmfdb_object(PSL2O);
    X`timing:=timing;
    cl:=get_clifford_algebra(PSL2O);
    write_lmfdb_sl2(cl,X: overwrite := overwrite);

end intrinsic;

//#############################
intrinsic write_lmfdb_gamma0(X::LMFDBGrpSL2CliffGamma0: overwrite := false, timing:=" ")
//#############################
{}
    SetColumns(0);
    order_label:=X`order;
    Y:=New(LMFDBGrpSL2CliffGamma0);
    Y:=X;
    Y`timing:=timing;
    O:=clifford_order(order_label);
    file:=get_lmfdb_gamma0_path(O);
    data:=SaveLMFDBObject(Y);
    print_file(file, data: overwrite := overwrite);
 
end intrinsic;

//#############################
intrinsic write_lmfdb_gamma0(SL2O::GrpPSL2Cliff,beta::AlgMatElt: do_over:=false)
//#############################
{Compute and write a gamma0 group to disc.}
    O1:=clifford_order(SL2O);
    cl1:=clifford_algebra(SL2O);
    SL2O;
    
    fname:=get_lmfdb_gamma0_path(O1);
    fname;
    
    existing := OpenTest(fname, "r");
    if existing then
        //extract labels:
        lines := {@ H : H in Split(Read(fname), "\n") @};
        labels:={@ load_lmfdb_gamma0(line)`label : line in lines @};
        //close the file;
        delete existing;
    else
        labels:={@ @};
    end if;
    
    lab:=get_label(SL2O,beta);
    if (not lab in labels) or do_over then
        T0:=Cputime();
        Gamma0_fp(SL2O,beta);
        T1:=Sprintf("%o",Cputime(T0)); //later make this into an option, see #96
        gamma0_lmfdb:=create_lmfdb_object(SL2O,beta);
        write_lmfdb_gamma0(gamma0_lmfdb: overwrite := do_over, timing:=T1);
    end if;
    
end intrinsic;

//#############################
intrinsic write_lmfdb_gamma02(X::LMFDBGrpSL2CliffGamma0: overwrite := false)
//#############################
{}
    SetColumns(0);
    file:=get_lmfdb_gamma0_path2(X);
    data:=SaveLMFDBObject(X);
    print_file(file, data: overwrite := overwrite);
 
end intrinsic;


//###############
//###############
// READING/WRITING TOOLS
//###############
//###############

//########################
intrinsic jsonify_magma_element(a::AlgClffElt)->Tup
//########################
{}
    elt:=Eltseq(a);
    den:=Z!LeastCommonMultiple([Denominator(i) : i in elt]);
    num:=[Z!den*a : a in elt];
    return [* num,den *];
end intrinsic;


//########################
intrinsic dejsonify_magma_element(cl_mag::AlgClff,json::List)->AlgClffElt
//########################
{}
/*
    EXAMPLE:
        cl_mag:=get_magma_algebra(cl);
        a:=get_magma_elt(random_clifford_vector(cl)^2);
        a eq dejsonify_magma_element(cl_mag,jsonify_magma_element(a));
        
*/
    num:=json[1];
    den:=json[2];
    return cl_mag![n/den : n in num];
end intrinsic;

//########################
intrinsic gram_matrix(cl::CliffAlg)->AlgMatElt
//########################
{}
    I:=get_I(cl);
    return Matrix([[ Z!Eltseq((-(i1+i2)^2 + i1^2+i2^2)/2)[1] : i1 in I] : i2 in I]);
end intrinsic;

//########################
intrinsic jsonify_quadratic_form(cl::CliffAlg)->SeqEnum
//########################
{}
    gram:=gram_matrix(cl);
    d:=Ncols(gram);
    return [ [gram[i][j] : j in [i..d] ]: i in [1..d] ];
end intrinsic;


//########################
intrinsic dejsonify_clifford_algebra(json::SeqEnum)->CliffAlg
//########################
{}
    //only for diagonals for now
    d:=#json;
    sqs:=[-json[i][1] : i in [1..d]];
    return clifford_algebra(sqs,Q);
end intrinsic;

//---------ORDERS-------------

//########################
intrinsic jsonify_basis(O::CliffOrd)->SeqEnum
//########################
{}
    return [jsonify_magma_element(get_magma_elt(b)) : b in basis(O)];
end intrinsic;

//########################
intrinsic jsonify_magma_element_list(my_list::SeqEnum)->SeqEnum
//########################
{}
    return [jsonify_magma_element(x): x in my_list];
end intrinsic;

//########################
intrinsic dejsonify_magma_element_list(cl_mag::AlgClff, my_list::SeqEnum)->SeqEnum
//########################
{}
