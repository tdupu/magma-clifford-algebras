//########################
intrinsic create_lmfdb_object(O::CliffOrd: timing:=" ")->LMFDBCliffOrd
//########################
{}
    vprintf LMFDB,4: "creating LMFDBCliffOrd object...\n ";
    lmfdb_ord:=New(LMFDBCliffOrd);
    cl:=get_clifford_algebra(O);
    lmfdb_ord`label:=get_label(O);
    lmfdb_ord`clifford_algebra:=jsonify_quadratic_form(cl);
    lmfdb_ord`basis:=jsonify_basis(O);
    lmfdb_ord`is_maximal:=is_maximal(O);
    
    lmfdb_ord`dimension:=dimension(O);
    lmfdb_ord`is_star_invariant:=is_star_invariant(O);
    //lmfdb_ord`conjugates:=
    //lmfdb_ord`is_euclidean,
    lmfdb_ord`discriminant:=discriminant(O);
    //lmfdb_ord`is_compatible,
    lmfdb_ord`is_norm_euclidean:=is_norm_euclidean(O);
    //lmfdb_ord`is_not_euclidean,
    //lmfdb_ord`clifford_unit_group_generators:=[];
    //lmfdb_ord`vector_lattice:=
    //lmfdb_ord`clifford_vector_basis,
    lmfdb_ord`timing:=timing;
    return lmfdb_ord;
end intrinsic;

//########################
intrinsic create_lmfdb_object(PSL2O::GrpPSL2Cliff: timing:=" ")->LMFDBGrpSL2Cliff
//########################
{}
    O:=get_clifford_order(PSL2O);
    cl:=clifford_algebra(O);
    cl_mag:=get_magma_algebra(cl);
    sl2_lmfdb:=New(LMFDBGrpSL2Cliff);
    sl2_lmfdb`label:=get_label(O);
    sl2_lmfdb`matrix_generators:=jsonify_matrix_list(Generators(PSL2O));
    sl2_lmfdb`order:=get_label(O);
    sl2_lmfdb`relations:=Relations(PSL2O);
    sl2_lmfdb`matrix_to_fpgroup:=jsonify_matrix_to_fpgroup(PSL2O);
    sl2_lmfdb`timing:=timing;
    return sl2_lmfdb;
end intrinsic;

//########################
intrinsic create_lmfdb_object(SL2O::GrpPSL2Cliff,alpha::AlgMatElt)->LMFDBGrpSL2CliffGamma0
//########################
{The user is not resposible for checking that gamma0 is actually a subgroup of SL2O`sl2_fp_group.
They can use the map to actually determine the subgroup.
}
    /*
    TAD (11/16/24):
        This is a better version of the above one.
        This assume that the user has computed gamma0(alpha) for the particular alpha and hence can refer to the table.
    
    */
    gamma0,map:=Explode(SL2O`gamma0fp_dict[alpha]);
    sl2_quo:=SL2O`sl2_fp_group; //not sure why I need to call this again
    R,get_rep:=RightTransversal(sl2_quo,map(gamma0));
    
    O:=get_clifford_order(SL2O);
    cl:=clifford_algebra(O);
    cl_mag:=get_algebra(O);
    
    vec_dim:=#cl`vecs;
    
    /*-----
        Got rid of the testing here. The testing should really be done earlier.
    */
    
    order_label:=get_label(O);
    gens_mat:=[fp_element_to_matrix(SL2O,map(g)) : g in Generators(gamma0)];
    gens_fp:=[Eltseq(sl2_quo!map(g)) : g in Generators(gamma0)];
    reps_mat:=[fp_element_to_matrix(SL2O,r) : r in R];
    defining_element:=jsonify_matrix(alpha);
    defining_element_label:=get_label(alpha);
    matrix_generators:=jsonify_matrix_list(cl_mag,gens_mat);
    group_label:=order_label cat "." cat defining_element_label;
    fp_generators:=gens_fp;
    relations:=[Eltseq(r[1]*r[2]^(-1)) : r in Relations(gamma0)];
    group_index:=#R;
    gamma0_ab:=AbelianQuotient(gamma0);
    abelianization:=Invariants(gamma0_ab);
    rank:=TorsionFreeRank(gamma0_ab);
    matrix_coset_representatives:=jsonify_matrix_list(cl_mag,reps_mat);
    fp_coset_representatives:=[Eltseq(r) : r in R];
        
    /*-----
        SAVE
    */
    
    gamma0_lmfdb:=New(LMFDBGrpSL2CliffGamma0);
    
    if pdet(alpha)[1] in Z then
        gamma0_lmfdb`level_norm:= Z!pdet(alpha)[1];
    else
        assert pdet(alpha^-1) in Z;
        gamma0_lmfdb`level_norm:= Z!pdet(alpha^-1)[1];
    end if; //this is an improper handling of the level. It should be changed to a rational number. 
    
    gamma0_lmfdb`order:=order_label;
    gamma0_lmfdb`defining_element:=defining_element;
    gamma0_lmfdb`defining_element_label:=defining_element_label;
    gamma0_lmfdb`label:=group_label;
    gamma0_lmfdb`matrix_generators:=matrix_generators;
    gamma0_lmfdb`fp_generators:=fp_generators;
    gamma0_lmfdb`relations:=relations;
    gamma0_lmfdb`index:=group_index;
    gamma0_lmfdb`abelianization:=abelianization;
    gamma0_lmfdb`rank:=rank;
    //gamma0_lmfdb`manin_rank:=;
    gamma0_lmfdb`matrix_coset_representatives:=matrix_coset_representatives;
    gamma0_lmfdb`fp_coset_representatives:=fp_coset_representatives;
    
    return gamma0_lmfdb;
    
end intrinsic;


//########################
intrinsic get_label(beta::AlgMatElt)->MonStgElt
//########################
{}
    return integer_to_base62(Hash(beta));
end intrinsic;

//########################
intrinsic create_lmfdb_object(MS::ModSymCliff,beta::AlgMatElt : timing:=" ")->LMFDBHeckeMatrices
//########################
{}
    hecke_dict:=MS`hecke_matrices_tf;
    sl2o:=clifford_bianchi_group(MS);
    gamma0_label:=get_label(sl2o,beta);
    keys:=[k:k in Keys(hecke_dict)];
    hecke_LMFDB:=New(LMFDBHeckeMatrices);
    hecke_LMFDB`gamma0_label:=gamma0_label;
    hecke_LMFDB`clifford_matrices:=jsonify_matrix_list(keys);
    hecke_LMFDB`timing:=timing;
    hecke_LMFDB`hecke_matrices:=[jsonify_integer_matrix(hecke_dict[k]) : k in keys];
    return hecke_LMFDB;

end intrinsic;

//###########################
intrinsic clifford_order_lmfdb(label::MonStgElt)->CliffOrdLMFDB
//###########################
{}
    words:=Split(label,".");
    n:=StringToInteger(words[1]);
    sqs:=[-base62_to_integer(s): s in Split(words[2],"_")];
    cl:=clifford_algebra(Q,sqs);
    lmfdb_ords:=read_lmfdb_clifford_orders(cl);
    for lmfdb_ord in lmfdb_ords do
        if lmfdb_ord`label eq label then
            return lmfdb_ord;
        end if;
    end for;
    
    error "No lmfdb order of that label was found";
    
end intrinsic;

//###########################
intrinsic sl2_lmfdb(label::MonStgElt)->LMFDBGrpSL2Cliff
//###########################
{}
    O:=clifford_order(label);
    cl:=get_clifford_algebra(O);
    
    order_label:=get_label(O);
    list:=read_lmfdb_sl2(cl);
    for elt in list do
        if Get(elt,"label") eq order_label then
            return elt;
        end if;
    end for;
end intrinsic;

