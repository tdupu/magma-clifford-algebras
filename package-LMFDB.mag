intrinsic jsonify_matrix_list(cl_mag::AlgClff,mat_gens::SeqEnum)->SeqEnum
//########################
{}
/*
TAD: This is very dumb. We need to get rid of this extra argument (or this intrinsic altogether).
*/
    return [jsonify_matrix(g) : g in mat_gens];
end intrinsic;

