// This function returns the value of an attribute, computing it and caching it using the function of the same name if necessary.

//#############################
intrinsic Get(G::Any, attr::MonStgElt) -> Any
//#############################
{}
    if HasAttribute(G, attr) then
        return G``attr;
    else
        //val := eval attr*"(G)";
        //G``attr := val;
        //return val;
        return None();
    end if;
end intrinsic;

