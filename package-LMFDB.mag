//###########################
intrinsic clifford_order(label::MonStgElt)->CliffOrd
//###########################
{}
    return clifford_order(clifford_order_lmfdb(label));
end intrinsic;

//##################
intrinsic clifford_bianchi_group(label::MonStgElt)->GrpPSL2Cliff
//##################
{}
    SL2O_lmfdb:=sl2_lmfdb(label);
    relations:=SL2O_lmfdb`relations;
    O:=clifford_order(label);
    cl:=get_clifford_algebra(O);
    cl_magma:=get_magma_algebra(cl);
 
    GL2:=GL(2, cl_magma);
    M2:=MatrixAlgebra(cl_magma,2);
    group_generators:=[M2!g: g in dejsonify_matrix_list(cl_magma,SL2O_lmfdb`matrix_generators)];
    
    return clifford_bianchi_group(O,group_generators,relations);

end intrinsic;

intrinsic load_clifford_bianchi_group(O::CliffOrd)->GrpPSL2Cliff
{}
    return clifford_bianchi_group(get_label(O));
end intrinsic;

//####################
intrinsic Gamma0_fp(SL2O::GrpPSL2Cliff,alpha_label::MonStgElt: redo := false) -> GrpFP, Map, SeqEnum
//####################
{Get the finitely presented Gamma0 group from storage.}
    if not assigned SL2O`gamma0fp_dict then
        SL2O`gamma0fp_dict:=AssociativeArray();
    end if;
    
    from_file:=read_lmfdb_gamma0(SL2O);
    
    O:=get_clifford_order(SL2O);
    cl:=get_clifford_algebra(O);
    cl_mag:=get_algebra(cl);
    
    T0:=Time();
    vprintf LMFDB, 2: "loading... \n";
    from_file:=[x : x in read_lmfdb_gamma0(SL2O)];
    T1:=Time(T0);
    vprintf LMFDB, 2: "%o seconds... \n",T1;
    
    found_gamma0:=false;
    i:=1;
    for X in from_file do
        vprintf LMFDB, 2: "percentage complete: %o \n", RealField(2)!Index(from_file,X)/#from_file;
        gamma0_lmfdb:=X;
        sl2quo:=sl2_fp(SL2O);
        beta:=dejsonify_matrix(cl_mag,gamma0_lmfdb`defining_element);
        if gamma0_lmfdb`defining_element_label eq alpha_label then
            found_element:=true;
            alpha:=beta;
        end if;
        fp_generators:=gamma0_lmfdb`fp_generators;
        relations:=gamma0_lmfdb`relations;
        
        F:=FreeGroup(#fp_generators);
        gamma0,map := quo< F | relations>;
        imgs:=[&*[sl2quo.x : x in y] : y in fp_generators];
        inclusion:=hom<gamma0->sl2quo | imgs >;
        gamma0_sub:=inclusion(gamma0);
        gens_from_conversion:=[fp_element_to_matrix(SL2O,g) : g in Generators(gamma0_sub)];
        SL2O`gamma0fp_dict[beta]:=<gamma0,inclusion,gens_from_conversion>;
    end for;
    
    
    if not found_element then
        error "There is no element for the given label in storage.";
    else
        return SL2O`gamma0fp_dict[alpha][1];
    end if;
    
end intrinsic;

//####################
intrinsic load_Gamma0_fp(SL2O::GrpPSL2Cliff,alpha::AlgMatElt: redo := false) -> GrpFP, Map, SeqEnum
//####################
{}
    cl:=clifford_algebra(SL2O);
    alpha_label:=get_label(alpha);
    return Gamma0_fp(SL2O,alpha_label);
end intrinsic;

//####################
intrinsic load_hecke_matrices_tf(MS::ModSymCliff,beta::AlgMatElt)->Assoc
//####################
{}
    if not assigned MS`hecke_matrices_tf then
        MS`hecke_matrices_tf:=AssociativeArray();
    end if;
    
    cl_mag:=magma_algebra(MS);
    hecke_mats_lmfdb:=read_lmfdb_hecke_matrices(MS,beta);
    alpha_list_json:=hecke_mats_lmfdb`clifford_matrices;
    
    alpha_list:=dejsonify_matrix_list(cl_mag,alpha_list_json);
    hecke_mats_tf:=[dejsonify_integer_matrix(x) : x in hecke_mats_lmfdb`hecke_matrices];
    
    num_mats:=#alpha_list;
    assert num_mats eq #hecke_mats_tf;
    
    for i in [1..num_mats] do
        alpha:=alpha_list[i];
        Talpha:=hecke_mats_tf[i];
        if not alpha in Keys(MS`hecke_matrices_tf) then
            MS`hecke_matrices_tf[alpha]:=Talpha;
        end if;
    end for;
    
    return MS`hecke_matrices_tf;

end intrinsic;
