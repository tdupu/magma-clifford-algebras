//########################
{The better intrinsic for jsonifying 2x2 matrices in clifford algebras for storing into LMFDB objects.}
    return [jsonify_matrix(g) : g in mat_gens];
end intrinsic;


//########################
intrinsic dejsonify_matrix_list(cl_mag::AlgClff,json::SeqEnum)->SeqEnum
