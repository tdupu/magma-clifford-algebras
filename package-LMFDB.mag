//###########################
intrinsic clifford_order(X::LMFDBCliffOrd)->CliffOrd
//###########################
{}
    cl1:=dejsonify_clifford_algebra(X`clifford_algebra);
    O1:=dejsonify_order(cl1,X`basis);
    O1`is_maximal:=X`is_maximal;
    return O1;
end intrinsic;

//###########################
intrinsic load_clifford_orders(cl::CliffAlg)->CliffOrd
//###########################
{}
    return {@ clifford_order(X) : X in read_lmfdb_clifford_orders(cl) @};
end intrinsic;

