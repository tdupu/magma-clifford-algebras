//########################
intrinsic dejsonify_order(cl::CliffAlg,basis_json::SeqEnum)->CliffOrd
//########################
{}
    cl_mag:=get_magma_algebra(cl);
    return clifford_order(Integers(),[cl!x : x in dejsonify_magma_element_list(cl_mag,basis_json)]);
