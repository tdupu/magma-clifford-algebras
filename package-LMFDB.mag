//###############

//###############################
intrinsic get_lmfdb_clifford_order_path(cl::CliffAlg)->MonStgElt
//###############################
{}
    SetColumns(0);
    Folder:=get_data_folder();
    quad_form:=jsonify_quadratic_form(cl);
    form_label:=quadratic_form_label(quad_form);
    d:=#quad_form[1]+1;
    label := Sprintf("%o.%o", d, form_label);
    path := Sprintf("%oorders/%o", Folder, label);
    return path;
    
end intrinsic;


//
intrinsic get_data_folder()->MonStgElt
//
{}
    root:=GetLMFDBRootFolder();
    if root[#root] ne "/" then
        root := root * "/";
    end if;
    Folder:=root * "DATA/";
    return Folder;
end intrinsic;


//###############################
intrinsic get_lmfdb_sl2_path(cl)->MonStgElt
//###############################
{}
    
    SetColumns(0);
    Folder:=get_data_folder();
    quad_form:=jsonify_quadratic_form(cl);
    form_label:=quadratic_form_label(quad_form);
    d:=#quad_form[1]+1;
    label := Sprintf("%o.%o", d, form_label);
    path := Sprintf("%osl2/%o", Folder, label);
    return path;
    
end intrinsic;


