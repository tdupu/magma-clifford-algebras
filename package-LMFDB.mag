//########################
intrinsic jsonify_relations(Gamma_quo::GrpFP)->SeqEnum
//########################
{}
    rels:=Relations(Gamma_quo);
    return [Eltseq(rel[1]) cat [-x: x in Reverse(Eltseq(rel[2]))] : rel in rels];
end intrinsic;

//########################
intrinsic jsonify_sl2_gens(PSL2O::GrpPSL2Cliff)->SeqEnum
//########################
{}
    SL2O_quo:=PSL2O`sl2_fp_group;
    q_map:=PSL2O`sl2_to_psl2_map;
    mat_gens:=[fp_element_to_matrix(PSL2O,q_map(g)) : g in Generators(SL2O_quo)];
    return jsonify_matrix_list(mat_gens);
end intrinsic;

//########################
intrinsic jsonify_sl2_rels(PSL2O::GrpPSL2Cliff)->SeqEnum
//########################
{}
    SL2O_quo:=PSL2O`sl2_fp_group;
    return jsonify_relations(SL2O_quo);
end intrinsic;

//########################
intrinsic jsonify_matrix_to_fpgroup(PSL2O::GrpPSL2Cliff)->SeqEnum
//########################
{}
    mydict:=PSL2O`mat_to_sl2quo;
    cl_magma:=get_magma_algebra(get_clifford_algebra(PSL2O));
    mykeys:=[k : k in Keys(mydict)];
    GL2:=GL(2, cl_magma);
    return [<jsonify_matrix(GL2!k),Eltseq(mydict[k])>: k in mykeys];
end intrinsic;

//########################
intrinsic dejsonify_matrix_to_fpgroup(cl_mag::AlgClff,SL2Oquo::GrpFP,seq::List)->Assoc
//########################
{}
    mydict:=AssociativeArray();
    for x in seq do
        mat:=dejsonify_matrix(cl_mag,x[1]);
        if #x[2] ne 0 then
            elt:=SL2Oquo!x[2];
        else
            elt:=Id(SL2Oquo);
        end if;
        mydict[mat]:=elt;
    end for;
    
    return mydict;
end intrinsic;

//########################
intrinsic integer_to_base62(n::RngIntElt)->StrMonElt
//########################
{}
    big_alphabet:="0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    q,r:=Quotrem(n,62);
    list:=[r];
    while q ne 0 do
        q,r :=Quotrem(q,62);
        list:=list cat [r];
    end while;
    m:=#list;
    //&+[list[i]*62^(i-1) : i in [1..m]];

    my_string:="";
    for i in [1..m] do
        my_string := big_alphabet[list[i]+1] cat my_string;
    end for;
    return my_string;
end intrinsic;

//########################
intrinsic base62_to_integer(num::MonStgElt) -> RngIntElt
//########################
{Convert a string representing a number in base 62 to an integer.}
  digits := "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
  n := 0;
  for i in [1..#num] do
    ind := Index(digits,num[i]);
    error if ind eq 0, "invalid digit";
    n := #digits*n + ind - 1;
  end for;
  return n;
end intrinsic;


//###############
//###############
// LABELS
//###############
//###############

  
//########################
intrinsic quadratic_form_label(my_form::SeqEnum)->MonStgElt
//########################
{}
    d:=#my_form[1];
    my_form_label:=integer_to_base62(my_form[1][1]);
    for i in [2..d] do
        my_form_label:= my_form_label cat "_" cat integer_to_base62(my_form[i][1]);
    end for;
    return my_form_label;
end intrinsic;

//########################
intrinsic get_label(cl::CliffAlg)->MonStgElt
//########################
{}
    quad_form:=jsonify_quadratic_form(cl);
    my_label:=IntegerToString(#quad_form[1]+1) cat "." cat quadratic_form_label(quad_form);
    return my_label;
end intrinsic;

//########################
intrinsic get_label(O::CliffOrd)->MonStgElt
//########################
{This is the label of the clifford algebra "." the discriminant "." the Hash of the order.}
    
    if not assigned O`label then
        cl:=clifford_algebra(O);
        my_label:=get_label(cl) cat ".";
        disc:=discriminant(O);
        if disc lt 0 then
            my_label:=my_label cat "m";
        end if;
        my_label:= my_label cat IntegerToString(AbsoluteValue(discriminant(O))) cat "." cat integer_to_base62(Hash(O));
        O`label:=my_label;
    end if;
    
    return O`label;
end intrinsic;

//########################
intrinsic get_label(O::CliffOrd)->MonStgElt
//########################
{}
    cl:=get_clifford_algebra(O);
    my_label:=get_label(cl) cat ".";
    disc:=discriminant(O);
    if disc lt 0 then
        my_label:=my_label cat "m";
    end if;
    my_label:= my_label cat IntegerToString(AbsoluteValue(discriminant(O))) cat "." cat integer_to_base62(Hash(O));
    return my_label;
end intrinsic;

//########################
intrinsic get_label(sl2o::GrpPSL2Cliff,beta::AlgMatElt)->MonStgElt
//########################
{}
/*
TAD (11/16/2024):
    This is for labelling of gamma0 LMFDB elements.
    The scheme is <order>.<matrix element>.

*/
    O:=clifford_order(sl2o);
    order_label:=get_label(O);
    defining_element_label:=get_label(beta);
    return order_label cat "." cat defining_element_label;
end intrinsic;

