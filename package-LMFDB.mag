// LOAD FUNCTIONS
//###############
//###############

//####################
intrinsic load_lmfdb_clifford_order(line::MonStgElt: sep:="|") -> LMFDBCliffOrd
//####################
{}
    vprintf LMFDB,4: "entering load_lmfdb_clifford_order \n";
    
    attrs:=LMFDBCliffOrd_ATTRS;
    data := Split(line, sep: IncludeEmpty := true);
    error if #data ne #attrs, "Wrong size data line";
    X := New(LMFDBCliffOrd);
    for i in [1..#data] do
        attr := attrs[i];
        X``attr := LoadAttr(attr, data[i], X);
    end for;
    return X;
end intrinsic;

//####################
intrinsic load_lmfdb_sl2(line::MonStgElt: sep:="|") -> LMFDBGrpSL2Cliff
//####################
{}
    vprintf LMFDB,4: "entering load_lmfdb_sl2 \n";
    
    attrs:=LMFDBGrpSL2Cliff_ATTRS;
    data := Split(line, sep: IncludeEmpty := true);
    error if #data ne #attrs, "Wrong size data line";
    X := New(LMFDBGrpSL2Cliff);
    for i in [1..#data] do
        attr := attrs[i];
        X``attr := LoadAttr(attr, data[i], X);
    end for;
    return X;
end intrinsic;

//####################
intrinsic load_lmfdb_gamma0(line::MonStgElt: sep:="|") -> LMFDBGrpSL2CliffGamma0
//####################
{}
    
    attrs:=LMFDBGrpSL2CliffGamma0_ATTRS;
    vprintf LMFDB,4: "entering load_lmfdb_gamma0\n, attributes %o", attrs;
    data := Split(line, sep: IncludeEmpty := true);
    error if #data ne #attrs, "Wrong size data line";
    X := New(LMFDBGrpSL2CliffGamma0);
    for i in [1..#data] do
        attr := attrs[i];
        X``attr := LoadAttr(attr, data[i], X);
    end for;
    return X;
end intrinsic;

//####################
intrinsic load_lmfdb_hecke_matrices(line::MonStgElt: sep:="|") -> LMFDBHeckeMatrices
//####################
{}
    vprintf LMFDB, 4:  "entering load_lmfdb_hecke_matrices \n";
    
    attrs:=LMFDBHeckeMatrices_ATTRS;
    data := Split(line, sep: IncludeEmpty := true);
    error if #data ne #attrs, "Wrong size data line";
    X := New(LMFDBHeckeMatrices);
    for i in [1..#data] do
        attr := attrs[i];
        X``attr := LoadAttr(attr, data[i], X);
    end for;
    return X;
end intrinsic;

