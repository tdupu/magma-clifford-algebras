/*
Timings in the functions all need to be strings.
They also need to not be the empty string in order to register.
*/

Z:=Integers();
Q:=RationalField();

declare verbose LMFDB, 5;
declare type LMFDBCliffOrd;
declare attributes LMFDBCliffOrd:
    label,
    clifford_algebra,
    basis,
    is_maximal,
    dimension,
    is_norm_euclidean,
    discriminant,
    is_star_invariant,
    timing;
    //clifford_unit_group_generators,
    //clifford_unit_vectors,
    //clifford_vector_lattice,
    //clifford_vector_basis,
    //conjugates,
    //is_euclidean,
    //is_compatible,
    //is_not_euclidean,
    
LMFDBCliffOrd_ATTRS:=Sort([ "basis", "clifford_algebra", "dimension", "discriminant", "is_maximal", "is_norm_euclidean", "label","is_star_invariant","timing" ]); //always alphabetical

declare type LMFDBGrpSL2Cliff;
declare attributes LMFDBGrpSL2Cliff:
    label,
    matrix_generators,
    order,
    relations,
    matrix_to_fpgroup,
    timing;
    
LMFDBGrpSL2Cliff_ATTRS:=Sort([ "label", "matrix_generators", "matrix_to_fpgroup", "order", "relations", "timing"]); //always alphabetical
    
declare type LMFDBGrpSL2CliffGamma0;
declare attributes LMFDBGrpSL2CliffGamma0:
    matrix_coset_representatives,
    fp_coset_representatives,
    defining_element,
    index,
    level_norm,
    label,
    matrix_generators,
    fp_generators,
    rank,
    order,
    relations,
    abelianization,
    defining_element_label,
    timing;
    
    //add torsion part in place of abelianizations
    //cusps
    
declare type LMFDBGrpSL2Cliff;
declare attributes LMFDBGrpSL2Cliff:
label,
order,
matrix_generators,
relations,
timing;

declare type LMFDBSubGrpSL2Cliff;
declare attributes LMFDBSubGrpSL2Cliff:
  label,
  //quadratic_form,
  order,
  is_gamma0,
  defining_element,
  matrix_generators,
  relations,
  coset_representatives,
  index,
  timing;
  
  //torsion_part
  //cusps
  
    
declare type LMFDBHeckeMatrices;
declare attributes LMFDBHeckeMatrices: gamma0_label,clifford_matrices,hecke_matrices,timing;
    
LMFDBGrpSL2CliffGamma0_ATTRS:=Sort([ "abelianization", "defining_element","defining_element_label","fp_coset_representatives", "fp_generators", "index", "label", "level_norm", "matrix_coset_representatives", "matrix_generators", "order", "rank", "relations", "timing"]); //always alphabetical

LMFDBGrpSL2CliffLowIndex_ATTRS:=Sort([ "abelianization", "fp_coset_representatives", "fp_generators", "index", "label", "matrix_coset_representatives", "matrix_generators", "number", "order", "rank", "relations", "timing"]); //always alphabetical

LMFDBHeckeMatrices_ATTRS:=Sort(["gamma0_label","clifford_matrices","hecke_matrices","timing"]);//ALWAYS ALPHABETICAL!



