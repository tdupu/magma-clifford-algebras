//###########################
intrinsic read_lmfdb_sl2(cl::CliffAlg)->SetIndx
//###########################
{}
    fname:=get_lmfdb_sl2_path(cl);
    lines := {@ H : H in Split(Read(fname), "\n") @};
    return {@ load_lmfdb_sl2(line) : line in lines @};
end intrinsic;


