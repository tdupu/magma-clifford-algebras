Z:=Integers();
Q:=RationalField();

/*
The template for types and intrinsics we are using is here:
https://magma.maths.usyd.edu.au/magma/handbook/congruence_subgroups_of_psl2r

Conjecture: norm clifford-euclidean orders have only one bubble over its fundamental domain.

Because of the conjecture we can obtain a generating set by taking all of the elements of the unit group and then considering translations by them and rotations by them together with inversion. We can then obtain the relations by taking words of a certain length in all of the generators. This is implemented in clifford_bianchi_group.

Things I want:
    --The correct category to go after is subquotients of PSL2(O) for O an order in a Clifford algebra because they have the correct closure properties. Because of this all GrpPSL2Cliff objects need to have supergroup, subgroup, and quot_map attributes. In terms of matrices these are two matrix subgroups of GL2, one which designates the sub and the next which designates the quotient. The groups themselves have matrix generators and a finitely presented group. For PSL2 we work with matrices up to sign.
    
    --generators(Gamma).
    --fp_group(Gamma)
    --subgroup,kernel_of_quotient:=matrix_group(Gamma), kernel of quotient should always contain -id.
    --matrix(my_element). GrpPSL2CliffElt to MatGrpElt
    --fp_elt(my_element). GrpPSL2CliffElt to GrpFPElt
    --order(my_element).
    --G1 eq G2, Group equality is determined by matrix group equality where we automatically throw in neg_mat which is the negative identity matrix. This comes from the lattice isomorphism theorem.
    --g1 eq g2 is matrix(g1)*matrix(g2)^(-1) is pm the identity. (NOTE: this avoids the word problem)
    --identity(Gamma);
    --matrix_to_fp_elt(my_matrix), uses a matrix factorization.
    --fp_elt_to_matrix, uses the dictionary
    --g1 in Gamma1 (I'm not sure how to do this one but we should be able to avoid the word problem)
    --low_index_subgroups(Gamma), uses the finite index subgroups.
    --Print: elements should just display their associated 2x2 matrix.

    EXAMPLE:
        >Z:=Integers();
        >Q:=Rationals();
        >Attach("package-cliff.mag");
        >Attach("package-cusp.mag");
        >Attach("package-order.mag");
        >Attach("package-modular-symbols.mag");
        >Attach("package-grpcliff.mag");
        >d:=3;
        >cl := clifford(d,Q);
        >O:=get_maximal_orders(cl)[1];
        >PSL2O:=clifford_bianchi_group(O);
        
    There was a bug previously with how the quotient to matrices worked. This was a test for it.
    
        >index_bound:=3;
        >low_index_subgroups:=low_index_subgroups_fp(PSL2O, <2, index_bound>);
        >Gammaquo:=low_index_subgroups[5];
        >PSL2Oquo:=fp_group(PSL2O);
        >R,rmap:=RightTransversal(PSL2Oquo,Gammaquo);
        >psl2quo_to_mat:=PSL2O`psl2quo_to_mat;
        //One of the generators is not in the keys!
        >keys:=Keys(psl2quo_to_mat);
        >R[2] in keys;
        >R[2] in Generators(PSL2Oquo);
        >R[2] in PSL2Oquo;
        //the generators are contained all have a conversion
        >SL2Oquo:=PSL2O`sl2_fp_group;
        >Generators(SL2Oquo) subset Keys(PSL2O`sl2quo_to_mat);
        
    I'm testing some group action things here.
    
        >my_cusps:=cusps(cl);
        >act:=my_cusps`action;
        >I:=get_I(cl);
        >infty:=Infinity();
        >x:= I[1]+I[2]/4;
        >M,A,mm,aa:=get_convergents(PSL2O,x);
        >B_word:=aa[#aa];
        >B_mat:=A[#A];
        >my_cusps:=cusps(cl);
        >act:=my_cusps`action;
        >act(B_mat,infty)-x; //equality of cusps with vectors should be implemented
    
    
*/

declare type GrpPSL2Cliff[GrpPSL2CliffElt];
declare attributes GrpPSL2Cliff: matrix_group, matrix_group_kernel, fp_group, clifford_algebra, clifford_order, low_index_subgroups, label, mat_to_SL2Ofree, SL2Ofree_to_mat, relations, vec_to_mat, mat_to_vec, sl2quo_to_mat, mat_to_sl2quo, psl2quo_to_mat, mat_to_psl2quo, sl2_matrix_group, sl2_fp_group, psl2_fp_group, sl2_to_psl2_map, mat_to_unit, unit_to_mat, unit_to_sl2quo, sl2quo_to_unit, vec_to_sl2quo, sl2quo_to_vec, unit_to_psl2quo, psl2quo_to_unit, vec_to_psl2quo,psl2quo_to_mat_func, psl2quo_to_vec,gl2,matrix_generators,sl2_fp_generators,psl2_fp_generators, index_of_sub, decompose_matrix,cusps,mat_to_psl2quo_func, gamma0fp_dict,sl2_to_psl2_fp, matrix_algebra, hecke_double_cosets,sl2quo_to_mat_func,hecke_operators;

declare attributes GrpPSL2CliffElt: cliff_alg, matrix, fp_elt, eltseq, clifford_algebra, magma_algebra, parent, group_order;

import "fundamental-domain.mag": voronoi_cell, fund_domain, to_vor, present_stab_inf, make_semidirect, match_semidirect, make_inverses, pres_psl2;

import "fundamental-domain-functions.mag": sl2_data;

Z:=Integers();
Q:=RationalField();
infty:=Infinity();

// AML Nov 6 2024: modified to allow nonpositive values in rel, in
// accordance with Magma's convention; also required the second argument
// to be a sequence of integers
//########################
intrinsic evaluate_relation(eltseq::SeqEnum,rel::SeqEnum[RngIntElt])->.
//########################
{}
/*
    INPUT:
        --eltseq, a nonempty sequence of elements which can be multiplied
        --rel, a sequence of integers rel = [i1,i2,...,ir]
        
    OUTPUT:
        --eltseq[i1]*eltseq[i2]* ... * eltseq[ir];

    Note: a negative entry is interpreted as the inverse of the corresponding
          generator.
*/
    return &*[Universe(eltseq)|eltseq[AbsoluteValue(i)]^Sign(i) : i in rel|i ne 0];
end intrinsic;

//########################
intrinsic evaluate_relation(eltseq::SetIndx,rel::SeqEnum[RngIntElt])->.
//########################
{}
  return evaluate_relation([x: x in eltseq],rel);
end intrinsic;

//%%%%%%%%%%%%%%%%%
intrinsic evaluate_word_to_matrix(my_word::GrpFPElt,my_matrix_dict::Assoc,G::GrpFP)->GrpMatElt
//%%%%%%%%%%%%%%%%
{}
/*
    INPUT:
        --my_word, an element of the FP group G
        --my_matrix_dict, an AssociativeArray of elements on the generators
            and their inverses that assigns to each generator a group element.
    OUTPUT:
        --
        
        alpha:=1+2*I[1]-I[2];
        S:=Matrix(2,2,[[cl ! 0,cl ! -1], [cl ! 1, cl ! 0]]);
        s:=matrix_to_quo_dict[S];
        M1 := Matrix(2,2,[[0, -1], [1, -alpha]]);
        tau_minus_alpha:=vecO_to_quo(-alpha,cob_matrix,vecO_basis,translate_to_quo_dict);
        M1 eq evaluate_word_to_matrix(s*tau_minus_alpha,eval_dict_quo,SL2O_quo);

*/
  // AML: changed my_word to G!my_word to make Eltseq do the right thing.
    M:=#Eltseq(G!my_word);
    if M eq 0 then
        my_matrix:=my_matrix_dict[my_word];
    else
        my_matrix:=&*[my_matrix_dict[G.(Eltseq(G!my_word)[i])] : i in [1..M]];
    end if;
    return my_matrix;
end intrinsic;


//######################
intrinsic make_psl2_group_elt(T::GrpPSL2Cliff, x::AlgMatElt) -> GrpPSL2CliffElt
//######################
{Creates a GrpPSL2CliffElt object with parent T and element x.}
    E := New(GrpPSL2CliffElt);
    E`parent := T;
    E`matrix := x;
    return E;
end intrinsic;

//######################
intrinsic Parent(x::GrpPSL2CliffElt) -> GrpPSL2Cliff
//######################
{

}
    return x`parent;
end intrinsic;

//######################
intrinsic '+'(x::GrpPSL2CliffElt, y::GrpPSL2CliffElt) -> GrpPSL2CliffElt
//######################
{

}
    require x`Parent eq y`Parent: "Parents must be the same.";
    return make_psl2_group_elt(Parent(x), x`elt + y`elt);
end intrinsic;

//######################
intrinsic '*'(x::GrpPSL2CliffElt, y::GrpPSL2CliffElt) -> GrpPSL2CliffElt
//######################
{
    Multiplies two clifford group elements.
}
    require Parent(x) eq Parent(x): "Parents must be the same."; //this is too strict.
    return make_psl2_group_elt(Parent(x), x`elt * y`elt);
end intrinsic;

/*//######################
intrinsic 'eq'(T1::GrpPSL2Cliff, T2::GrpPSL2Cliff) -> BoolElt
//######################
{Checks if two GrpPSL2Cliff objects are equal.}
    return T1`matrix_group eq T2`matrix_group;
end intrinsic;*/

//######################
intrinsic 'eq'(x::GrpPSL2CliffElt, y::GrpPSL2CliffElt) -> BoolElt
//######################
{Checks if two GrpPSL2CliffElt objects are equal.}
    return Parent(x`matrix[1,1]) eq Parent(y`matrix[1,1]) and x`matrix in [y`matrix,-y`matrix];
end intrinsic;

//######################
intrinsic Print(E::GrpPSL2CliffElt)
//######################
{Prints a GrpPSL2CliffElt object.}
    printf "%o", E`matrix;
end intrinsic;

//######################
intrinsic IsCoercible(T::GrpPSL2Cliff, x::.) -> BoolElt, GrpPSL2CliffElt
//######################
{Checks if x can be coerced into GrpPSL2Cliff and performs the coercion if possible.}
    if Type(x) eq RngIntElt then
        return true, make_psl2_group_elt(T, x); //garbage template
    end if;
    return false, "Element is not coercible into GrpPSL2Cliff.";
end intrinsic;

//##################
intrinsic rotation_matrix(u_elt::CliffAlgElt)->AlgMatElt
//##################
{
    INPUT:
        --u a Clifford group element (CliffAlgElt)
        
    OUTPUT:
        --the 2x2 matrix corresponding to x -> uxu^*.
}
    //require is_clifford_group_elt(u): "We can only make this kind of matrix from a clifford group element..."; //this is not implemented
    
    
    return Matrix(2,2,[u_elt, 0, 0, star(u_elt)^(-1)]);
end intrinsic;

//##################
intrinsic rotation_matrix(u::CliffOrdElt)->AlgMatElt
//##################
{
    INPUT:
        --u a Clifford group element (CliffOrdElt)
        
    OUTPUT:
        --the 2x2 matrix corresponding to x -> uxu^*.
}
    //require is_clifford_group_elt(u): "We can only make this kind of matrix from a clifford group element..."; //this is not implemented
    
    u_elt:=get_algebra_elt(u);
    return Matrix(2,2,[u_elt,0,0,star(u_elt)^(-1)]);
end intrinsic;

//##################
intrinsic translation_matrix(v::CliffOrdElt)->AlgMatElt
//##################
{
    INPUT:
        --v, a Clifford clifford vector (CliffOrdElt)
        
    OUTPUT:
        --the 2x2 matrix corresponding to x -> uxu^*.
}
    cl_mag:=get_algebra(Parent(v));
    v_elt:=get_algebra_elt(v);
    return Matrix(2,2,[cl_mag|1,v_elt,0,1]);
end intrinsic;

//##################
intrinsic translation_matrix(v_elt::CliffAlgElt)->AlgMatElt
//##################
{
    INPUT:\n
        --v, a Clifford clifford vector\n
        \n
    OUTPUT:\n
        --the 2x2 matrix corresponding to x -> x+v.\n
}
    cl:=Parent(v_elt);
    return Matrix(2,2,[cl|1, v_elt, 0, 1]);
end intrinsic;


//##################
intrinsic clifford_bianchi_group(O::CliffOrd : method:="dirichlet",batch_size:=5000,num_rels:=10000,word_length:=20,inv_stable:=false, redo:=false)->GrpPSL2Cliff
//##################
{Compute a clifford bianchi group from an order in a clifford algebra.
}

    //--------TODO: MAKE OPTIONAL PARAMETERS--------
    
    if not redo and assigned O`psl2 then
        return O`psl2;
    end if;
    
    PSL2O := New(GrpPSL2Cliff);
    cl:=get_cliff_algebra(O);
    cusp_set:=cusps(cl);
    act:=cusp_set`action;
    cl_magma:=get_algebra(cl);
    
    GL2:=GL(2, cl_magma);
    id_mat:=GL2!Matrix(2,2,[1, 0, 0, 1]);
    neg_mat:=GL2!Matrix(2,2,[-1,0,0,-1]);
    trivial_matrix_group:=sub<GL2|neg_mat>; //if we are really recording PSL2 then we need to quotient by this.

    
    //
    //---Norm Clifford-Euclidean Case
    //
    if is_norm_euclidean(O) and is_star_invariant(O) then
    
        //---printing---
        vprintf Clifford, 3: "the order was found to be norm Euclidean...\n";
    
        mat_to_unit:=AssociativeArray();
        unit_to_mat:=AssociativeArray();
        vec_to_mat:=AssociativeArray();
        mat_to_vec:=AssociativeArray();
        
    
        Ogrp,Ounits,Omat,repn:=units(O);
        //the first one are clifford group elements, the last ones is a permutation matrix group.
        ugens,units_quo,map_quo:=units_fp(O);
        //vec_units:=get_unit_vectors(O);
        
        rots:=[];
        trans:=[];
        
        //-----printing stuff-----
        vprintf Clifford,4: "gathering unit and vector matrices...\n";
        
        unit_to_mat[O!1]:=id_mat;
        mat_to_unit[id_mat]:=O!1;
        
        for u in Ogrp do //this used to be in u in ugens and this ran a lot faster.
            rotu:=rotation_matrix(u);
            unit_to_mat[u]:=rotu;
            mat_to_unit[rotu]:=u;
            Append(~rots,rotu);
        end for;

        for v in vec_basis(O) do
            transv:=translation_matrix(v);
            transv_neg:=translation_matrix(-v);
            vec_to_mat[v]:=transv;
            vec_to_mat[-v]:=transv_neg;
            mat_to_vec[transv]:=v;
            mat_to_vec[transv_neg]:=-v;
            Append(~trans,transv);
        end for;

        S:=GL2!Matrix(2,2,[0,-1,1,0]);
        
        group_generators:=trans cat rots cat [S];
        
        
        id:=group_generators[1]*group_generators[1]^(-1);
        num_gens:=#group_generators;
        
        //
        //---------FIND THE RELATIONS FOR THE GROUP-------------
        //        
        if method eq "products" then
            
            //-----printing stuff-----
            vprintf Clifford,3: "figuring out relations for our group by brute force...\n using words of length %o to compute relations...\n this may take a while...\n", word_length;
            
            perms:=Permutations({1..num_gens},word_length);
            relations:=[];
            for perm in perms do
                product:=&*[group_generators[i] : i in perm];
                if product eq id then
                    Append(~relations,perm);
                end if;
            end for;
        
        elif method eq "random" then
            //the code used here can be found in relation-finder.mag
            
            mat_gens := {@ g : g in group_generators @} join {@ g^-1 : g in group_generators @};
            inverse:= {@ Index(mat_gens, g^(-1)) : g in mat_gens @};
        
            
            //%%%%%%%%%%%%%%%%%%%%%%
            function gives_relation(elt3,elt3_inv)
            //%%%%%%%%%%%%%%%%%%%%%%
                //---printing---
                vprintf Clifford,5: "entering gives_relation...\n";
                
                return (elt3 eq elt3*elt3_inv);
            end function;
            
            //g*mat_gens[inverse[Index(mat_gens,g)]] eq 1
            random_rels:=get_relations(mat_gens,inverse,gives_relation: batch_size:=batch_size,num_rels:=num_rels, len:=word_length);
            triv_rels:=get_trivial_relations(mat_gens,inverse);
            relations:=random_rels cat triv_rels;
            group_generators:=mat_gens;
            num_gens:=#group_generators;
            
        elif method eq "fundamental_domain" then
            
            //call in the necessary lattices and grops
            cl:=clifford_algebra(O);
            lat:=vec(O:small:=true);
            gp:=units_matrix_group(O);

            new_fd, new_fd_inds, pairing_table, fd, lps, sorted_cones, sorted_pg, sorted_pgto := fund_domain(lat,gp: gram := InnerProductMatrix(lat));
            psl2_fp,to_psl2_fp,stab_gens,inv_trs,mats,gen_maps := pres_psl2(lat,gp,new_fd,pairing_table,fd,lps,cl: gram := InnerProductMatrix(lat));
            // currently getting stuck on inv_inv; we don't get inverses
            // of the rescaled sphere
            
            inv_mat:=Matrix(2,2,[cl|0,-1,1,0]);
            mat_gens_stab:=[matn_tuple_to_sl2(O,tup) : tup in stab_gens];
            mat_gens_bottom:=[ matn_tuple_to_sl2(O,tup)*inv_mat : tup in inv_trs];
            mat_gens:=mat_gens_stab cat mat_gens_bottom;
            mat_gens_inverted:=[g^-1 : g in mat_gens];
            rels:=[Eltseq(r[1]) cat Reverse([-x : x in Eltseq(r[2])]) : r in Relations(psl2_fp)];
            group_generators,relations:=lift_relations(mat_gens_inverted,rels); //seems very wrong
            
        elif method eq "fundamental_domain_v2" then
            
            FD:=fundamental_domain_infty(O:inv_stable:=true,include_inv:=false);
            side_pair_infty:=side_pairing_infty(O,FD);
            stab_infty,to_stab_infty,gens_infty:=stabilizer_infty(O,FD,side_pair_infty);
            group_generators,relations,G, side_pair, torsion_elements, polyhedron1, polyhedron2, edge2, next_step, side_pair_poly,FD_SL2:=sl2_data(O,FD,side_pair_infty,stab_infty,gens_infty);
            
            //caching
            O`side_pair:=side_pair_poly;
            O`fundamental_domain:=FD_SL2;
            
        elif method eq "dirichlet" then
            include_inv:=false;
            inv_stable:=true;
            fd := dirichlet_fd(O:include_inv := include_inv, inv_stable := inv_stable);
            side_pair_infty:=side_pairing_infty(O,fd : include_inv:=include_inv);
            stab_infty,gens_infty:=stabilizer_infty(O,fd,side_pair_infty);
            group_generators,relations,G, side_pair, torsion_elements, polyhedron1, polyhedron2, edge2, next_step, side_pair_poly,FD_SL2:=sl2_data(O,fd,side_pair_infty,stab_infty,gens_infty);
            assert forall{x: x in relations|&*[group_generators[AbsoluteValue(i)]^Sign(i): i in x] in [ScalarMatrix(cl,2,i): i in [1,-1]]};
            
            //caching
            O`side_pair:=side_pair_poly;
            O`fundamental_domain:=FD_SL2;
        else
            error "Not a valid method";
            
        end if;
            
        PSL2:=clifford_bianchi_group(O,[g: g in group_generators],relations); //this intrinsic takes generators and relations and forms the group.
        
            return PSL2;
    
    else
        error("Not implemented for orders which are not norm-euclidean and invariant under the star involution.");
    end if;

end intrinsic;

////////////////////
intrinsic is_upper_triangular(g::AlgMatElt)->BoolElt
////////////////////
{Given a 2x2 matrix return true if upper triangular and false otherwise.}
    if g[2,1] eq 0 then
        return true;
    else
        return false;
    end if;
end intrinsic;


////////////////////
intrinsic clifford_bianchi_group(O::CliffOrd,group_generators::SeqEnum,relations::SeqEnum)->GrpPSL2Cliff
////////////////////
{This is the main intrinsic for instantiating the dictionaries used by other algorithms.
This algorithm feeds into the clifford_bianchi_group intrinsics which build the generators and relations from data.}
/*
    INPUT:
        --O, order in clifford algebra of positive definite quadratic form
        --group_generators, 2x2 AlgClffElt matrices
            *upper triangular ones are always generators for stabilizer of infinity
            *last generator is the -id
        --relations as a sequence of integers
        
    OUTPUT:
        --GrpPSL2Cliff object (with mat_to_quo and quo_to_mat and other attributes populated so that the Manin symbol algorithms run)
*/

    PSL2O:=New(GrpPSL2Cliff);
    
    cl:=clifford_algebra(O);
    GL2:=GL(2,get_algebra(cl));
    
    sl2_quo:=quo<FreeGroup(#group_generators)|relations>;
    
    //We need a better way of doing neg_mat that works for the random method
    neg_mat:=Matrix(2,2,[cl|-1,0,0,-1]);
    ind_neg_mat:=Index(group_generators,neg_mat);
    //assert ind_neg_mat eq #group_generators;
    
    //vprintf Clifford,3: "neg_mat=%o...\n",neg_mat;
    neg_fp:=sl2_quo.ind_neg_mat; //always the last spot
    output_neg_mat :=evaluate_relation(group_generators,Eltseq(neg_fp));
    vprintf Clifford,3: "%o , Parent %o\n",output_neg_mat, Parent(neg_mat);
    assert Parent(output_neg_mat) eq Parent(neg_mat);
    assert neg_mat eq output_neg_mat;
    
    psl2_quo<[g]>,quot_map:=quo<sl2_quo|neg_fp>;
    //G2,quot3:=quo<sl2_quo|neg_fp>;
    //psl2_quo<[g]>,quot4:=Simplify(G2);
    //quot_map:=quot3*quot4;
    //quot_map:=quot3;

    mat_to_quo:=AssociativeArray();
    quo_to_mat:=AssociativeArray();

    for i in [1..#group_generators] do
        mat_to_quo[group_generators[i]]:=sl2_quo.i;
        quo_to_mat[sl2_quo.i]:=group_generators[i];
        mat_to_quo[group_generators[i]^-1]:=sl2_quo.i^-1;
        quo_to_mat[sl2_quo.i^-1]:=group_generators[i]^-1;
    end for;
    
    mat_gens_stab:=[g : g in group_generators| is_upper_triangular(g)];
    mat_gens_bottom:=[ g: g in group_generators | not g in mat_gens_stab];

    rk:=get_arity(cl)+1;

    t1:=Cputime();
    unit_mats:=[decompose(g)[2] : g in mat_gens_stab];
    rots,to_gl2:=sub<GL2|unit_mats>;
    stab,to_sl2_quo:=sub<sl2_quo|[mat_to_quo[y] : y in mat_gens_stab]>;
    ff:=hom<stab->rots|[decompose(g)[2] : g in mat_gens_stab]>;
    trsub:=Kernel(ff);
    vprintf Clifford, 3: "Computed the FPGrp for the additive part of the stabilizer of infinity in %o seconds...\n", Cputime(t1);

    //make sure to evaluate with sl2_quo not stab!
    assert &and[mat_gens_stab[i] eq evaluate_relation(group_generators, Eltseq(sl2_quo!stab.i)):i in [1..#mat_gens_stab]];

    t2:=Cputime();
    tv_units:=RightTransversal(stab,trsub);

    assert #units(O) eq #tv_units;
    vprintf Clifford, 3: "Computed an FPGrp transversal for the units in %o seconds...\n", Cputime(t2);

    vectors:={};
    for i in [1..#Generators(trsub)] do
        fp_element:=sl2_quo! trsub.i;
        translation:=evaluate_relation(group_generators,Eltseq(fp_element));
        mat_to_quo[translation]:=fp_element;
        quo_to_mat[fp_element]:=translation;
        vectors:=vectors join {translation[1][2]};
    end for;

    magma_vectors:=[magma_vector(cl!v): v in vectors];
    lat:=vec(O:small:=true);
    lat0:=sub<lat|magma_vectors>;
    assert lat eq lat0;

    // AML: I'm not assuming it is a subset of the generators.
    // However, I was assuming the coefficients are integral--not anymore.
    lcm := LCM([Denominator(d): d in &cat [Eltseq(i): i in Set(magma_vectors)]]);
    seq_mv := Setseq(Set(magma_vectors));
    vec_mat := ChangeRing(lcm*Matrix(seq_mv),Z);
    T_cvs := [translation_matrix(clifford_vector(cl,v)): v in seq_mv];
    
    tr_gens:=[];//wasn't initialized
    
    for v in Basis(lat0) do
    
      indp := Index(Rows(vec_mat),lcm*v);
      indm := Index(Rows(vec_mat),-lcm*v);
      if indp gt 0 then
        sol := Vector([i eq indp select 1 else 0: i in [1..Nrows(vec_mat)]]);
      elif indm gt 0 then
        sol := Vector([i eq indm select -1 else 0: i in [1..Nrows(vec_mat)]]);
      else
        sol := Solution(vec_mat,ChangeRing(lcm*v,Z))[1];
      end if;
      
      // optional: try harder to find a shorter solution
      // note that the translation subgroup is abelian, so it shouldn't
      // matter what order we take
      t_v := &*[mat_to_quo[translation_matrix(clifford_vector(cl,seq_mv[i]))]^sol[i]: i in [1..Nrows(vec_mat)]];
      Append(~tr_gens,t_v);
      // let's not forget to put it in the arrays
      quo_to_mat[t_v] := translation_matrix(clifford_vector(cl,v));
      mat_to_quo[translation_matrix(clifford_vector(cl,v))] := t_v;
      
    end for;
    
    /*
    -------------------
    //VECTORS
    -------------------
    */

    vec_to_quo:=AssociativeArray();
    quo_to_vec:=AssociativeArray();

    for v_clf in vec_basis(O) do
        v:=magma_vector(cl!v_clf);
        r:=Coordinates(lat0!v);
        fp_element:=&*[(sl2_quo!tr_gens[i])^r[i]: i in [1..rk]];
        mat:=&*[(quo_to_mat[sl2_quo!tr_gens[i]])^r[i]: i in [1..rk]];
        
        mat_to_quo[mat]:=fp_element;
        quo_to_mat[fp_element]:=mat;
        vec_to_quo[v_clf]:=fp_element;
        quo_to_vec[fp_element]:=v_clf;
        mat_to_quo[mat^(-1)]:=fp_element^(-1);
        quo_to_mat[fp_element^(-1)]:=mat^(-1);
        vec_to_quo[-v_clf]:=fp_element^(-1);
    end for;
    
    function vec_to_quo_func(v)
        vb:=vec_basis(O);
        coords:=Coordinates(lat!magma_vector(cl!v));
        return sl2_quo!&*[vec_to_quo[vb[i]]^coords[i] : i in [1..arity(cl)+1]];
    end function;

    /*
    -------------------
    //UNITS
    -------------------
    */

    units_fp_seq:=[];
    tv_units_bad:=[];
    for r2 in tv_units do
        mat2:=evaluate_relation(group_generators,Eltseq(sl2_quo!r2));
        if is_upper_triangular(mat2) then
            tau2,pi2:=Explode(decompose(mat2));
            assert tau2*pi2 eq mat2;
            assert pi2 eq ff(r2);
            tau2_fp:=vec_to_quo_func(cl!tau2[1,2]);
            assert evaluate_relation(group_generators,Eltseq(sl2_quo!tau2_fp)) eq tau2;
            r2_fp:=sl2_quo!tau2_fp^-1*r2;
            assert evaluate_relation(group_generators,Eltseq(r2_fp)) eq ff(r2);
            Append(~units_fp_seq,r2_fp);
        else
            Append(~tv_units_bad,r2);
        end if;
    end for;

    assert #units_fp_seq eq #rots;
    assert #{ff(r) : r in units_fp_seq} eq #rots;

    unit_to_quo:=AssociativeArray();
    quo_to_unit:=AssociativeArray();
    unit_to_mat:=AssociativeArray();
    mat_to_unit:=AssociativeArray();

    for r in units_fp_seq do
        R:=ff(r);
        u:=O!cl!R[1,1];
        quo_to_mat[r]:=R;
        mat_to_quo[R]:=r;
        unit_to_quo[ u ]:=r;
        quo_to_unit[r]:=u;
    end for;
    
    inv_mat:=Matrix(2,2,[cl|0,-1,1,0]);
    
    assert inv_mat*inv_mat eq neg_mat;
    assert neg_mat in mat_gens_stab;

    /*
    -------------------
    //INVERSION
    -------------------
    */

    g:=mat_gens_bottom[1];
    g_fp:=mat_to_quo[g];

    //we know that the last element will look like
    //    neg_mat*inv_mat*g
    //where g is upper triangular so
    //(NB: neg_mat is in the center so we can absorb)
    g_stab:=neg_mat*inv_mat*g;
    tau,pi:=Explode(decompose(g_stab));
    tau_fp:=vec_to_quo_func(cl!tau[1,2]);
    pi_fp:=mat_to_quo[pi];
    //assert evaluate_relation(group_generators,Eltseq(tau_fp)) eq tau;
    //assert evaluate_relation(group_generators,Eltseq(pi_fp)) eq pi;
    g_stab_fp:=tau_fp*pi_fp;
    //assert evaluate_relation(group_generators,Eltseq(g_stab_fp)) eq g_stab;

    //HENCE
    inv_fp:=g_fp*g_stab_fp^-1;

    mat_to_quo[inv_mat]:=inv_fp;
    quo_to_mat[inv_fp]:=inv_mat;
    
    
    /*
    -------------------
    //PSL2 ASSOCIATIVE ARRAYS
    -------------------
    */
    
    //Taylor: These are needed for the Manin symbol code to run.
    
    vec_to_psl2quo:=AssociativeArray();
    psl2quo_to_vec:=AssociativeArray();
    unit_to_psl2quo:=AssociativeArray();
    psl2quo_to_unit:=AssociativeArray();
    
    for v in [k: k in Keys(vec_to_quo)] do
        tv:=vec_to_quo[v];
        vec_to_psl2quo[v]:=quot_map(tv);
        psl2quo_to_vec[quot_map(tv)]:=v;
    end for;
    
    for u in [k: k in Keys(unit_to_quo)] do
        u_fp:=unit_to_quo[u];
        unit_to_psl2quo[u]:=quot_map(u_fp);
        psl2quo_to_unit[quot_map(u_fp)]:=u;
    end for;
    
    /*
    -------------------
    //PSL2 VERSIONS
    -------------------
    */
    
    
    PSL2O`gl2:=GL2; //needs to be defined
    PSL2O`matrix_group:=sub<GL2|group_generators>; //needs to be defined
    
    cl_magma:=get_algebra(cl);
    PSL2O`matrix_algebra:=MatrixAlgebra(cl_magma,2); //needs to be defined
        
    PSL2O`clifford_order:=O;
    PSL2O`clifford_algebra:=cl;
    PSL2O`relations:=relations;

    PSL2O`sl2_fp_group:=sl2_quo;
    PSL2O`psl2_fp_group:=psl2_quo; //duplicate
    PSL2O`sl2_to_psl2_fp:=quot_map; //duplicate
    PSL2O`fp_group:=psl2_quo;
    
    //PSL2O`sl2_to_psl2_map:=quot3*quot4;
    PSL2O`sl2_to_psl2_map:=quot_map; //we don't simplify anymore
    
    PSL2O`sl2quo_to_mat:=quo_to_mat;
    PSL2O`mat_to_sl2quo:=mat_to_quo;
    //PSL2O`psl2quo_to_mat:=psl2quo_to_mat; //not implemented
    PSL2O`psl2quo_to_mat:=AssociativeArray();
    for k in Keys(PSL2O`sl2quo_to_mat) do
      PSL2O`psl2quo_to_mat[PSL2O`sl2_to_psl2_map(k)] := PSL2O`sl2quo_to_mat[k];
    end for;
    PSL2O`mat_to_psl2quo:=AssociativeArray();
    for i in Keys(mat_to_quo) do
      PSL2O`mat_to_psl2quo[i] := quot_map(mat_to_quo[i]);
    end for;
    
    PSL2O`matrix_generators:=group_generators;
    
    //All of these will be instantiated.
    //PSL2O`mat_to_unit:=mat_to_unit;
    //PSL2O`unit_to_mat:=unit_to_mat;
    //PSL2O`vec_to_mat:=vec_to_mat;
    //PSL2O`mat_to_vec:=mat_to_vec;
    PSL2O`unit_to_sl2quo:=unit_to_quo; //not implemented?
    PSL2O`sl2quo_to_unit:=quo_to_unit;
    PSL2O`vec_to_sl2quo:=vec_to_quo; //not implemented?
    PSL2O`sl2quo_to_vec:=quo_to_vec;
    
    PSL2O`unit_to_psl2quo:=unit_to_psl2quo; //not implemented?
    PSL2O`psl2quo_to_unit:=psl2quo_to_unit;
    PSL2O`vec_to_psl2quo:=vec_to_psl2quo; //not implemented?
    PSL2O`psl2quo_to_vec:=psl2quo_to_vec;
    
    PSL2O`cusps:=cusps(cl);
    
    //%%%%%%%%%%%%%%%%%
    function sl2quo_to_mat_func(my_word)
    //%%%%%%%%%%%%%%%%
        return evaluate_word_to_matrix(my_word,PSL2O`sl2quo_to_mat,PSL2O`sl2_fp_group);
    end function;
    
    //%%%%%%%%%%%%%%%%%
    function psl2quo_to_mat_func(my_word)
    //%%%%%%%%%%%%%%%%
        return evaluate_word_to_matrix(my_word,PSL2O`psl2quo_to_mat,PSL2O`psl2_fp_group);
    end function;

    PSL2O`sl2quo_to_mat_func := sl2quo_to_mat_func;
    PSL2O`psl2quo_to_mat_func := psl2quo_to_mat_func;
    
    return PSL2O;

end intrinsic;


