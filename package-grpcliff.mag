intrinsic sl2_fp(PSL2O::GrpPSL2Cliff)->GrpFP
//####################
{}
    return PSL2O`sl2_fp_group;
end intrinsic;


//####################
intrinsic Gamma0_fp(PSL2O::GrpPSL2Cliff,alpha::AlgMatElt : len:=20,num_rels := 1000,batch_size := 1000,redo := false, method:="rs_fp") -> GrpFP, Map, SeqEnum
//####################
{Methods can be "random","from_disc","rs_fp","rs_mat" where the later ones stand for Reidemeister-Schreier algorithm which comes in the flavor for finitely presented groups or for matrix groups. In practice the finitely presented version runs faster.\n\n

Claim: With a test on the index this intrinsic computes Gamma0(alpha).\n\n

Proof: Clearly what is computed is a subgroup of Gamma0(alpha). If the subgroup has the right index it is the whole thing, and that is what happens.\n\n

We then use canonical_cosets followed by rs_fp to get a canonical presentation. (NOT IMPLEMENTED HERE)

}

    // computes the presentation using only FP-group information
    //%%%%%%%%%%%%%%%%%%%
    function gamma0_fp(G,beta,psl,cl,ord)
    //%%%%%%%%%%%%%%%%%%%    
      vprint Clifford, 4: "really entering Reidemeister-Schreier for finitely presented groups...\n";
      
      test := func<g|forall{r: r in Eltseq(beta^-1*m*beta)|r in ord} where m is &*[fp_element_to_matrix(PSL2O,G.i): i in [0] cat Eltseq(G!g)]>;
      sl2_quo:=G;
      ct,tv := coset_table(sl2_quo,test:limit := 10^6);
      assert IsSatisfied(Relations(sl2_quo),ct);
      h := hom<sl2_quo->SymmetricGroup(#tv)|ct>;
      gamma0 := sub<sl2_quo|h>;
      //tv2,get_rep:=RightTransversal(sl2_quo,gamma0);
     
      vprint Clifford, 4: "gamma0 computed";
      
      assert forall{x: x in Generators(gamma0)|test(x)};
      
      // This presents the finite-index subgroup, such as Gamma_0(p).
      // However, it appears to have a bug.
      
      tv_can:=tv;
      //tv_can:=tv2;
      //tv_can:=canonical_cosets(sl2_quo,gamma0,get_rep,lex_comparison);
      
      pres,pres_to := presentation(sl2_quo,ct,tv_can,test); //canonical cosets goes here
      assert Image(pres_to) eq gamma0;
      
      // make sure that the relations are as expected
      assert forall{x: x in Relations(pres)|&*[fp_element_to_matrix(PSL2O,sl2_quo.i): i in [0] cat Eltseq(pres_to(LHS(x)*RHS(x)^-1))] in [ScalarMatrix(2,cl!i): i in [1,-1]]};
      
      assert AQInvariants(gamma0) eq AQInvariants(pres);
      
      return pres,pres_to;
    end function;

    // computes the presentation using matrices--maybe faster
    //%%%%%%%%%%%%%%%%%%%
    function gamma0_mat(G,beta,psl,cl,ord)
    //%%%%%%%%%%%%%%%%%%%
      test := func<g|forall{r: r in Eltseq(beta^-1*m*beta)|r in ord} where m is &*[fp_element_to_matrix(PSL2O,G.i): i in [0] cat Eltseq(G!g)]>; //there is a problem with this I don't understand.
      test_m := func<m|forall{r: r in Eltseq(beta^-1*m*beta)|r in ord}>;
      ctm,tvm := coset_table_matrices(G,test_m,psl`sl2quo_to_mat,cl); //psl`sl2quo_to_mat should maybe be the map x -> fp_element_to_matrix(PSL2O,x)
      tvm_comb := [<&*[G|G.(i gt Ngens(G) select Ngens(G)-i else i): i in t[2]],t[2]>: t in tvm];
      h := hom<G->SymmetricGroup(#tvm)|ctm[1..Ngens(G)]>;
      gamma0 := sub<G|h>;
      // The Reidemeister-Schreier algorithm wants things to be in an FP-group,
      // not a group of matrices.  tvm_comb is a combinatorial version of the
      // transversal calculated in terms of matrices.
      pres,pres_to := presentation(G,ctm,tvm_comb,test);

      assert Image(pres_to) eq gamma0;
      // make sure that the relations are as expected
      assert forall{x: x in Relations(pres)|&*[psl`sl2quo_to_mat[G.i]: i in [0] cat Eltseq(pres_to(LHS(x)*RHS(x)^-1))] in [ScalarMatrix(2,cl!i): i in [1,-1]]};
      assert AQInvariants(gamma0) eq AQInvariants(pres);
      return pres,pres_to;
    end function;


    if not assigned PSL2O`gamma0fp_dict then
        vprint Clifford, 4: "creating a dictionary of gamma0 subgroups...\n";
        PSL2O`gamma0fp_dict:=AssociativeArray();
    end if;
    
    if not alpha in Keys(PSL2O`gamma0fp_dict) or redo then
    
        vprint Clifford, 4: "alpha is not a key in our dictionary...\n computing... \n";
            
        if method eq "random" then
            O:=get_clifford_order(PSL2O);
            cl:=get_clifford_algebra(O);
            
            //For the get_relations
            mat_gens:=PSL2O`matrix_generators;
            mat_gens:= mat_gens join {@ g^-1 : g in mat_gens @};
            
            SL2O_quo:=PSL2O`sl2_fp_group;
            quo_gens:={@ PSL2O`mat_to_sl2quo[g] : g in mat_gens @};
            
            inverse:={@ Index(mat_gens,g^(-1)):g in mat_gens @};

            Gamma0_test:=get_Gamma0_test(O,alpha);
            //this is a UserProgram
            //it tests membership in Gamma0
            //see package-relations.mag
            
            random_rels:=get_relations(mat_gens,inverse,Gamma0_test :len:=len, batch_size:=batch_size, num_rels:=num_rels);
            trivial_rels:=get_trivial_relations(mat_gens,inverse);
            all_rels:=random_rels cat trivial_rels;

            //make the group
            
            Gamma0_gens:=[evaluate_relation(quo_gens,my_rel) : my_rel in all_rels];
            Gamma0_gens_mat:=[evaluate_relation(mat_gens,my_rel) : my_rel in all_rels];
            fp_group,map:=sub<SL2O_quo|Gamma0_gens>;
            PSL2O`gamma0fp_dict[alpha]:=<fp_group,map,Gamma0_gens_mat>;
        
        else
            psl:=PSL2O;
            G := psl`sl2_fp_group;
            ord:=clifford_order(psl);
            cl:=clifford_algebra(ord);
        
            if method eq "rs_mat" then
                pres2,pres2_to := gamma0_mat(G,alpha,psl,cl,ord);
                sg,sgto := Simplify(pres2);
                lg,lgto := SimplifyLength(sg);
                
                map:=lgto*sgto*pres2_to;
                Gamma0_gens_mat:=[fp_element_to_matrix(psl,map(g)):g in Generators(lg)];
                PSL2O`gamma0fp_dict[alpha]:=<lg,map,Gamma0_gens_mat>;
                
            elif method eq "rs_fp" then
                vprint Clifford, 4: "entering Reidemeister-Schreier for finitely presented groups...\n";
                pres1,pres1_to := gamma0_fp(G,alpha,psl,cl,ord);
                sg,sgto := Simplify(pres1);
                lg,lgto := SimplifyLength(sg);
                map:=lgto*sgto*pres1_to;
                Gamma0_gens_mat:=[fp_element_to_matrix(psl,map(g)):g in Generators(lg)];
                PSL2O`gamma0fp_dict[alpha]:=<lg,map,Gamma0_gens_mat>;
                
            end if;

        
        end if;
        
    end if;
    
        data:=PSL2O`gamma0fp_dict[alpha];
        return data[1],data[2],data[3];
        
end intrinsic;


//####################
intrinsic Gamma0_fp(PSL2O::GrpPSL2Cliff,alpha::GrpMatElt : len:=20,num_rels := 1000,batch_size := 1000,redo := false, method:="rs_fp") -> GrpFP, Map, SeqEnum
//####################
{}
    cl_mag:=get_algebra(clifford_algebra(clifford_order(PSL2O)));
    M:=MatrixAlgebra(cl_mag,2);
    return Gamma0_fp(PSL2O,M!alpha: len:=len,num_rels := num_rels,batch_size := batch_size,redo := redo, method:=method);
end intrinsic;

