///////////////
intrinsic stabilizer_infty(SL2O::GrpPSL2Cliff)->GrpFP,Map,Setq
///////////////
{Return the stabilizer of infinity as a finitely presented group (as a subgroup of SL2(O)) and a map to the finitely presented version of PSL2(O) with its generators as matrices.}
    O:=clifford_order(SL2O);
    psl2_quo:=fp_group(SL2O);
    sl2_infty,gens_infty:=stabilizer_infty(O);
    gens_infty_fp:=[matrix_to_fp_element(SL2O,g) : g in gens_infty];
    stab_to_psl2:=hom<sl2_infty->psl2_quo|gens_infty_fp>;
    return sl2_infty,stab_to_psl2,gens_infty;
end intrinsic;
