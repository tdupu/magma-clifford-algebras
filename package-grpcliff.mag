//#####################
intrinsic prune( G::GrpFP, psl::GrpPSL2Cliff)->GrpFP
//#####################
{Reduce the set of generators of a group, to make it less cumbersome for Magma's built-ins.  It may not be necessary to use this.}
  vprint Clifford, 1: "It may not be necessary to use this function.  Consider just using Magma's built-in Rewrite.";
  sl2 := psl`sl2_fp_group;
  // the 0 is to make sure the universe gets set
  to_mat := func<g|&*[psl`sl2quo_to_mat[psl`sl2_fp_group.i]: i in [0] cat Eltseq(psl`sl2_fp_group!g)]>;
  vprint Clifford, 4: "multiplying out", Ngens(G), "words";
  mats := [to_mat(G.i): i in [1..Ngens(G)]];
  matset := {@x: x in mats@};
  plusinds := [Index(mats,m): m in matset];
  minusinds := [Index(mats,-m): m in matset];
  min_no0 := func<x,y|0 in [x,y] select x+y else Min(x,y)>;
  mins := Sort({@min_no0(plusinds[i],minusinds[i]): i in [1..#matset]@});
  vprint Clifford, 4: "reducing to", #mins, "distinct matrices";
  mat_mins := {@mats[i]: i in mins@};
  inv_mins := {@i^-1: i in mat_mins@};
  drops := {};
  vprintf Clifford, 4: "removing obvious products ";
  for i in [#mins..1 by -1] do
    // not sure what the optimal order is for the loop
    if exists{r: m1,m2 in [mat_mins,inv_mins],r in [1..i-1],s in [1,-1]|(ind ne 0 and ind lt i) where ind is Index(m2,s*mat_mins[i]*m1[r])} then
      // I'm assuming that the generators get bigger as we go along, which may not be true
      Include(~drops,i);
      vprintf Clifford, 5: "+";
    end if;
    if i mod 100 eq 0 then vprintf Clifford, 6: "."; end if;
  end for;
  vprintf Clifford, 4: "\nfound %o matrices to remove\n", #drops;
  keeps := {1..#mins} diff drops;
  keep_mins := [mins[i]: i in Sort(Setseq(keeps))];
  g_red := sub<psl`sl2_fp_group|[G.i: i in keep_mins]>;
  // assert Index(sl2,g_red) eq Index(sl2,G);
  return g_red;
end intrinsic;

////////////////////
intrinsic matn_tuple_to_sl2(O::CliffOrd,tup:Tup)->AlgMatElt
////////////////////
{Converts an element of the semidirect product as a tuple of (b,A) representing the map x->(x+b)*A to a SL2(O) element where O is an order in a clifford algebra. The element sequence of b corresponds to a clifford vector in the clifford order and A corresponds to multiplication by a unit.}
    cl:=clifford_algebra(O);
    b:=tup[1];
    A:=tup[2];
    //the action to be a left action
    u:=O`matn_to_unit[Transpose(A)];
    v:=O!clifford_vector(cl,b);
    pi_u:=rotation_matrix(u);
    tau_v:=translation_matrix(v);
    return pi_u*tau_v;
end intrinsic;

////////////////////
intrinsic lift_relations(mat_gens::SeqEnum,rels::SeqEnum)->SeqEnum,SeqEnum
////////////////////
{Takes relations for matrices which can return \pm the identity and returns a new set of matrices with -id as the last entry and a new set of relations that work on the nose. This is for lifting the presentation of psl2 to sl2.}
    id_mat:=mat_gens[1]*mat_gens[1]^(-1);
    neg_mat:=-id_mat;
    new_rels:=[];
    if neg_mat in mat_gens then
        last:=Index(mat_gens,neg_mat);
        new_mat_gens:=mat_gens;
    else
        last:=#mat_gens+1;
        new_mat_gens:=mat_gens cat [neg_mat];
    end if;
    
    for r in rels do
        output:=evaluate_relation(mat_gens,r);
        if output eq id_mat then
            Append(~new_rels,r);
        else
            Append(~new_rels,r cat [last]);
        end if;
    end for;

    if last eq #mat_gens+1 then
        for i in [1..#mat_gens] do
            rel:=[i,last,-i,last];
            if not rel in rels then //we should really be checking if it is the identity in the FP group because any cyclic permutation of this works
                Append(~new_rels,rel);
            end if;
        end for;
    else
        for i in [i : i in [1..#mat_gens] | i ne last] do
            rel:=[i,last,-i,last];
            if not rel in rels then
                Append(~new_rels, rel);
            end if;
        end for;
    end if;
    
    if not [last,last] in rels then
        Append(~new_rels,[last,last]);
    end if;
    
    return new_mat_gens,new_rels;
end intrinsic;

// AML 26/09/2024: I'll implement Reidemeister-Schreier so that we can find
// presentations of subgroups.
// 27/09/2024: no, no need.  I think Rewrite does everything we want.
/* For example:
AttachSpec("hecke.spec");
cl := clifford_algebra(3,Q);
ord := get_maximal_orders(cl)[1];
psl := clifford_bianchi_group(ord);
G := psl`sl2_fp_group;
beta := Matrix(2,2,[cl|1+2*cl.2,0,0,1-2*cl.2]);        
g1,g1map,elts1 := Gamma0_fp(psl,beta: num_rels := 40000, batch_size := 2500, len := 30);
assert Index(G,g1) eq 156;
time rew := Rewrite(G,g1);
// and Magma still knows how to coerce elements of rew into G and g1
tp := TietzeProcess(rew);
// reduces the length of the presentation by 1/3, as measured by #Sprintf
SimplifyPresentation(~tp); 
grew,gmap := Group(tp);
// and now grew is a group isomorphic to rew and gmap is the isomorphism
*/

/* I did a larger example with the element 3+2i+2j of norm 17.
After increasing the parameters to Gamma0_fp it found index 5220 = 
17^3 + 17^2 + 17 + 1 as expected.  Applying prune took 40 minutes to
give a presentation on 1221 generators, which Rewrite cut to 15 in 30 seconds,
and then SimplifyPresentation used 10 seconds to remove 1 generator and 
6 relations.  The abelianization is (Z/2Z)^10 + Z/48Z, for what it's worth.

However, just calling Rewrite on g1 directly took only 35 seconds and got
to the same place, so the prune intrinsic above may not be useful.  What
we really need is a better way to generate the congruence subgroups.
*/

function make_lower_left(cl,ord,beta,a,d,b)
  if b eq 0 then
    return a*cl`star(d) eq 1, cl!0;
  end if;
  myc := cl`star((cl!b)^-1*(a*cl`star(d)-cl!1));
  return beta[1,1]*myc*(beta^-1)[2,2] in ord and myc in ord, myc;
end function;

// NB this assumes that beta is diagonal
function make_random_elts(psl,cl,ord,beta,bd,n_elts: found_elts := {@@})
  if #found_elts ge n_elts then return found_elts; end if;
  binv := beta^-1;
  ord_elts := [ord|[r,s,t,u]: r,s,t,u in [-bd..bd]];
  poss_a := [x: x in ord_elts|beta[2,2]*x*binv[2,2] in ord];
  poss_d := [x: x in ord_elts|beta[1,1]*x*binv[1,1] in ord];
  poss_b := [x: x in ord_elts|beta[2,2]*x*binv[1,1] in ord];

  done_pairs := {@[x[1,1],x[2,2]]: x in found_elts@};
  vprint Clifford, 4: "finished setting up, getting started";
  while #found_elts lt n_elts do
    repeat
      a := Random(poss_a);
      d := Random(poss_d);
      if [a,d] in done_pairs then continue; end if;
      // I'm sure one could do better by imposing some requirements on
      // norm here already
      // b := Random(poss_b);
      Include(~done_pairs,[a,d]);
      avail_b := [b: b in poss_b|(b ne 0 and cl`is_vec(b*cl`star(a)) and cl`is_vec(cl`star(b)*d) and IsDivisibleBy(n,Z!Eltseq(nm(b))[1])) or (b eq 0 and a*d eq cl!1)] where n is Z!Eltseq(nm(a*cl`star(d)-cl!1))[1];
      until #avail_b gt 0;
    vprintf Clifford, 6: ".";
    for b in avail_b do 
      ism,c := make_lower_left(cl,ord,beta,a,d,b);
      if ism then
        vprint Clifford, 5: "found new matrix";
        mat := Matrix(2,2,[cl|a,b,c,d]);
        psl_elt := make_psl2_group_elt(psl,mat);
        if psl_elt notin found_elts then
          Include(~found_elts,psl_elt);
          if #found_elts mod 100 eq 0 then vprint Clifford, 2: "found", #found_elts, "matrices so far"; end if;
        end if;
      end if;
    end for;
  end while;
  return found_elts;
end function;

// NB this assumes that beta is diagonal
function make_random_elts_0(psl,cl,ord,beta,bd,n_elts: found_elts := {@@})
  if #found_elts ge n_elts then return found_elts; end if;
  binv := beta^-1;
  bas := Basis(ord`magma_order);
  ord_elts := [ord|&+[v[i]*bas[i]: i in [1..4]]:v in CartesianPower({-bd..bd},4)];
  poss_a := [x: x in ord_elts|beta[2,2]*x*binv[2,2] in ord];
  poss_d := [x: x in ord_elts|beta[1,1]*x*binv[1,1] in ord];
  poss_b := [x: x in ord_elts|beta[2,2]*x*binv[1,1] in ord];

  vprint Clifford, 4: "finished setting up, getting started";
  while #found_elts lt n_elts do
    repeat
      repeat
        a := Random(poss_a);
        d := Random(poss_d);
        b := Random(poss_b);
      until cl`is_vec(b*cl`star(a)) and cl`is_vec(cl`star(b)*d);
      vprintf Clifford, 6: ".";
      ism,c := make_lower_left(cl,ord,beta,a,d,b);
    until ism;
    vprint Clifford, 5: "found new matrix";
    mat := Matrix(2,2,[cl|a,b,c,d]);
    psl_elt := make_psl2_group_elt(psl,mat);
    if psl_elt notin found_elts then
      Include(~found_elts,psl_elt);
      if #found_elts mod 100 eq 0 then vprint Clifford, 2: "found", #found_elts, "matrices so far"; end if;
    end if;
  end while;
  return found_elts;
end function;

