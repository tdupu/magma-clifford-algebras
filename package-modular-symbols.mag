*/

//##########################
intrinsic hecke_double_cosets(MS::ModSymCliff,alpha::AlgMatElt)->SeqEnum
//##########################
{}
    PSigma:=get_defining_group_fp(MS);
    PSL2O:=get_psl2(MS);
    return hecke_double_cosets(PSL2O,PSigma,alpha);

end intrinsic;

//##########################
intrinsic get_finite_index_fp(MS::ModSymCliff)->GrpFp
//##########################
{}
    return MS`finite_index_subgroup_fp;
end intrinsic;

//##########################
intrinsic hecke_action(alpha::AlgMatElt,ms::ModSymCliffElt)->ModSymCliffElt
//##########################
{}
    MS:=Parent(ms);
    hecke_mats:=hecke_double_cosets(MS,alpha);
    mod_syms:=[g*ms: g in hecke_mats];
    return &+mod_syms;
  
end intrinsic;


//##########################
intrinsic generators(MS::ModSymCliff)->SeqEnum
//##########################
{}
    V:=manin_symbols(MS);
    //cache these
    return [MS.i : i in [1..Ngens(MS)]];
end intrinsic;

//##########################
intrinsic '.'(MS::ModSymCliff,i::RngIntElt)->ModSymCliffElt
//##########################
{}
   v:=manin_symbols(MS).i;
   return manin_to_modular_symbol(MS,v);
end intrinsic;

//##########################
intrinsic manin_symbols(MS::ModSymCliff)->GrpAb
//##########################
{Return the Manin symbols of the set of modular symbols as a finitely generated abelian group.}
    return MS`manin;
end intrinsic;


//##########################
intrinsic 'eq'(m1::ModSymCliffElt,m2::ModSymCliffElt)->BoolElt
//##########################
{}
    man1:=manin_symbol(m1);
    man2:=manin_symbol(m2);
    //require: Parent(m1) eq Parent(m2));
    return man1 eq man2;
end intrinsic;

//##########################
intrinsic Ngens(MS::ModSymCliff)->RngIntElt
//##########################
{}
   return Ngens(MS`manin);
end intrinsic;

//##########################
intrinsic rank(MS::ModSymCliff)->RngIntElt
//##########################
{}
   return Rank(MS`manin);
end intrinsic;

//##########################
intrinsic hecke_matrix(MS::ModSymCliff,alpha::AlgMatElt)->AlgMatElt
//##########################
{}
    if not assigned MS`hecke_matrices then
        MS`hecke_matrices:=AssociativeArray();
    end if;
    
    if not alpha in Keys(MS`hecke_matrices) then
        sequence:=[];
        n:=Ngens(MS);
        for i in [1..n] do
            vprintf Clifford, 4: "Hecke matrix alpha=%o, column=%o...\n",alpha,i;
            man_i:=manin_symbols(MS).i;
            ms_i:=manin_to_modular_symbol(MS,man_i);
            Tman_i:=manin_symbol(hecke_action(alpha,ms_i));
            sequence:=sequence cat [ Eltseq(Tman_i) ];
        end for;
        
        Talpha:=Matrix(n,n,sequence);
        MS`hecke_matrices[alpha]:=Talpha;
    end if;
    
    return MS`hecke_matrices[alpha];
    
end intrinsic;


//#########################
intrinsic subgroup_matrix_generators(MS)->SeqEnum
//#########################
{}
    if not assigned MS`subgroup_matrix_generators then
        PSigma:=subgroup_fp(MS);
        PSL2O:=MS`psl2;
        PSL2O_quo:=fp_group(PSL2O);
        MS`subgroup_matrix_generators:=[fp_element_to_matrix(PSL2O,PSL2O_quo!g) : g in Generators(PSigma)];
    end if;
    
    return MS`subgroup_matrix_generators;
end intrinsic;

//############################
intrinsic subgroup_fp(MS::ModSymCliff)->GrpFP
//############################
{}
    return MS`finite_index_subgroup_fp;
end intrinsic;


//############################
intrinsic random_basic_symbol_crude(cl::CliffAlg : bound:=20)->Tup
//###########################
{}
    //put optional parameters in
    return <random_clifford_vector(cl),random_clifford_vector(cl)>;
end intrinsic;

//#########################
intrinsic random_basic_symbol(MS::ModSymCliff)->ModSymCliffElt
//#########################
{}
    cl:=get_clifford_algebra(MS);
    return basic_symbol(MS,random_basic_symbol_crude(cl));
end intrinsic;



//#########################
intrinsic random_relation_basic(MS::ModSymCliff)->ModSymCliffElt
//#########################
{}
    mats:=subgroup_matrix_generators(MS);
    g:=random_product(mats);
    symb:=random_basic_symbol(MS);
    return symb-g*symb;
end intrinsic;

//#########################
intrinsic manin_symbols_tf(MS::ModSymCliff)->GrpAb,Map
//#########################
{}
    if not assigned MS`manin_module_tf then
        MS`manin_module_tf,MS`manin_module_tf_map:=FreeAbelianQuotient(manin_symbols(MS));
    end if;
        return MS`manin_module_tf,MS`manin_module_tf_map;
end intrinsic;

//#########################
intrinsic hecke_matrix_tf(MS::ModSymCliff,alpha::AlgMatElt)->AlgMatElt
//########################
{}

    if not assigned MS`hecke_matrices_tf then
        MS`hecke_matrices_tf:=AssociativeArray();
    end if;
    
    if not alpha in Keys(MS`hecke_matrices_tf) then
        Talpha:=hecke_matrix(MS,alpha);
        rows:=[];
        TF,tf_map:=manin_symbols_tf(MS);
        manin:=manin_symbols(MS);
        for i in [1..Ngens(TF)] do
            v:=TF.i;
            prerow:=tf_map(manin!Eltseq(Vector(Eltseq(v@@tf_map))*Talpha));
            rows:=rows cat [Eltseq(prerow)];
        end for;
        Talpha_tf:=Matrix(rows);
        MS`hecke_matrices_tf[alpha]:=Talpha_tf;
    end if;
    
    return MS`hecke_matrices_tf[alpha];
    
end intrinsic;

//#########################
intrinsic hecke_matrices(MS::ModSymCliff)->Assoc
//########################
{}
    if not assigned MS`hecke_matrices then
        MS`hecke_matrices:=AssociativeArray();
    end if;
    
    return MS`hecke_matrices;
    
end intrinsic;

//#########################
intrinsic hecke_matrices_tf(MS::ModSymCliff)->SeqEnum
//########################
{}
    if not assigned MS`hecke_matrices_tf then
        MS`hecke_matrices_tf:=AssociativeArray();
    end if;
    
    Mn:=MatrixAlgebra(Q,Ngens(manin_symbols_tf(MS)));
    MS`matrix_algebra:=Mn;
    
    return [Mn!MS`hecke_matrices_tf[k] : k in Keys(MS`hecke_matrices_tf)];
    
end intrinsic;

//#########################
intrinsic hecke_algebra_tf(MS::ModSymCliff)->AlgMat
//########################
{}
    Mn:=MS`matrix_algebra;
    hecke_mats_tf:=hecke_matrices_tf(MS);
    hecke_alg_tf:=sub<Mn|hecke_mats_tf>;
    MS`hecke_algebra_tf:=hecke_alg_tf;
    
    return MS`hecke_algebra_tf;
    
end intrinsic;

//#########################
intrinsic hecke_eigenspaces(MS::ModSymCliff : raw:=false)->SeqEnum
//########################
{}
    manin_tf:=manin_symbols_tf(MS);
    hecke_algebra_tf:=hecke_algebra_tf(MS);
    eigenspaces:=CommonEigenspaces(hecke_algebra_tf);
    
    if raw then
        return eigenspaces;
    end if;

    spaces:=[];
    for eigenspace in eigenspaces do
        gens:=[g : g in Generators(eigenspace)];
        Append(~spaces,sub<manin_tf|[&+[Z!(Eltseq(gen)[i])*manin_tf.i: i in [1..Ngens(manin_tf)]] : gen in gens]>);
    end for;
    
    MS`eigenspaces:=spaces;
    
    return MS`eigenspaces;
    
end intrinsic;


////////////////////////////////////////
////////////////////////////////////////
// HECKE OPERATORS ON ABELIANIZATIONS
////////////////////////////////////////
////////////////////////////////////////

////////////////////
intrinsic conjugate_intersection(SL2O::GrpPSL2Cliff,PSigma::GrpFP,alpha::AlgMatElt)->GrpFP
////////////////////
{Given PSigma a subgroup of PSL2(O) compute alpha^-1*PSigma*alpha meet PSL2(O) symbolically.}
    psl2_quo:=fp_group(SL2O);
    gamma0,gamma0to:=Gamma0_fp(SL2O,alpha);
    quot_map:=SL2O`sl2_to_psl2_fp;
    gamma0a:=gamma0to(gamma0);
    Pgamma0a:=quot_map(gamma0a);
    PSigma0a:=PSigma meet Pgamma0a;
    gens0a:=[fp_element_to_matrix(SL2O,g):g in Generators(PSigma0a)];
    gens0a_conj:=[alpha^(-1)*g*alpha: g in gens0a];
    gens0a_conj_fp:=[ matrix_to_fp_element(SL2O,g) : g in gens0a_conj];
    phi:=hom<PSigma0a->psl2_quo|gens0a_conj_fp>;
    PSigma0a_conj:=Image(phi);
    return PSigma0a_conj meet PSigma;
end intrinsic;

/*
If we need to lift this to SL2 we can do something like this.

quot_map:=PSL2O`sl2_to_psl2_fp;
PSigma:=quot_map(Sigma);
PSigma0_conj,incl,mat_gens:=conjugate_intersection(PSL2O,PSigma,alpha);
mat_gens_inverted:=[g^-1 : g in mat_gens];
rels:=[Eltseq(r[1]) cat Reverse([-x : x in Eltseq(r[2])]) : r in Relations(PSigma0_conj)];
group_generators,relations:=lift_relations(mat_gens_inverted,rels);

//I'm a little worried about the sign of the elements. I'm also a little worked that negative the identity is also included here.
*/


////////////////////
intrinsic hecke_operator(SL2O::GrpPSL2Cliff,PSigma::GrpFP,alpha::AlgMatElt)->Map
////////////////////
{Compute the Hecke operator associated to the matrix alpha on the group PSigma which is an finitely presented subgroup of PSL2(O). This is done by first computing the PSigma meet PSigma^(alpha^-1) and then computing the transfer map from PSigma to this group, then computing the abelianization of the conjugation map from PSigma meet PSigma^(alpha^-1) to alpha^-1 PSigma alpha meet PSigma and then computing the image of that in the abelianization of PSigma. }
    
    
    if not assigned SL2O`hecke_operators then
        SL2O`hecke_operators:=AssociativeArray();
    end if;
    
    if not PSigma in Keys(SL2O`hecke_operators) then
        SL2O`hecke_operators[PSigma]:=AssociativeArray();
    end if;
    
    if not alpha in Keys(SL2O`hecke_operators[PSigma]) then
        function conj(g,alpha)
            return matrix_to_fp_element(SL2O,alpha^-1*fp_element_to_matrix(SL2O,g)*alpha);
        end function;
        
        PSigma_a_inv:=conjugate_intersection(SL2O,PSigma,alpha^-1);
        PSigma_a:=conjugate_intersection(SL2O,PSigma,alpha);
        conjugation_tuple:=[conj(g,alpha) : g in Generators(PSigma_a_inv)];

        G1:=PSigma_a_inv;
        G2:=PSigma_a;
        
        //compute presentations
        R1,get_rep1:=Transversal(PSigma,G1);
        R2,get_rep2:=Transversal(PSigma,G2);
        test_G1:=func<x|get_rep1(x) eq Id(PSigma)>;
        test_G2:=func<x|get_rep2(x) eq Id(PSigma)>;
        pms1,tv1:=coset_table(PSigma,test_G1);
        pres1,pres_to1:=presentation(PSigma,pms1,tv1,test_G1);
        H1:=pres_to1(pres1);
        assert H1 subset PSigma;
        pms2,tv2:=coset_table(PSigma,test_G2);
        pres2,pres_to2:=presentation(PSigma,pms2,tv2,test_G2);
        H2:=pres_to2(pres2);
        assert H2 subset PSigma;
        H1_simple,H1_simple_to := Simplify(H1);
        H2_simple,H2_simple_to :=Simplify(H2);
        gens1:=AbelianGeneratorLifts(H1_simple); //this is defined in package-magma-fixes, and seems to hang
        H1_ab,ab1_to:=AbelianQuotient(H1_simple);
        PSigma_ab,f2:=AbelianQuotient(PSigma);
        pre_conj_gens := [conj(H1_simple_to(g),alpha) : g in gens1];
        assert forall{x: x in pre_conj_gens|x in PSigma};
        conj_ab_gens := [f2(i): i in pre_conj_gens];
        // conj_ab_gens:=[f2(conj(H1_simple_to(g),alpha)) : g in gens1]; //I have never gotten this to run
        L:=hom<H1_ab->PSigma_ab|conj_ab_gens>;
        tr,A,hA,B,hB:=TransferMap(PSigma,H1);
        transfer:=hom<PSigma_ab->H1_ab | [H1_ab!Eltseq(tr(A.i)) : i in [1..Ngens(A)]]>;
        Talpha:=hom<PSigma_ab->PSigma_ab|[L(transfer(PSigma_ab.i)) : i in [1..Ngens(PSigma_ab)] ]>;
        SL2O`hecke_operators[PSigma][alpha]:=Talpha;
    end if;
        return SL2O`hecke_operators[PSigma][alpha];
end intrinsic;

////////////////////
intrinsic hecke_matrix(SL2O::GrpPSL2Cliff,PSigma::GrpFP,alpha::AlgMatElt)->SeqEnum,Map
////////////////////
{Compute the hecke matrix on the abelianization of PSigma associated to the matrix alpha.}
    
    T:=hecke_operator(SL2O,PSigma,alpha);
    return [Eltseq(T(g)) : g in Generators(Domain(T))],T;
end intrinsic;

////////////////////
intrinsic hecke_matrix_tf(SL2O::GrpPSL2Cliff,PSigma::GrpFP,alpha::AlgMatElt)->AlgMatElt
////////////////////
{Compute the hecke matrix on the torsion free part of the abelianization of PSigma associated to the matrix alpha.}
    T:=hecke_operator(SL2O,PSigma,alpha);
    return matrix_on_torsion_free(T);
end intrinsic;


intrinsic matrix_on_torsion_free(f::Map)->AlgMatElt
{Given an endomorphism of abelian groups return the associated on the torsion free part of the abelian group.}
    A:=Domain(f);
    Atf:=TorsionFreeSubgroup(A);
    Ators:=TorsionSubgroup(A);
    Btf,to_Btf:=A/Ators;
    M:=Matrix([Eltseq(Atf!(to_Btf(f(Atf.i)) @@ to_Btf)) : i in [1..Ngens(Atf)]]);
    return M;
end intrinsic;


////////////////////
intrinsic load_gamma0_data(SL2O::GrpPSL2Cliff)
////////////////////
{Loads the gamma0 matrices that are available from storage.}
    O:=clifford_order(SL2O);
    cl:=clifford_algebra(O);
    beta:=Matrix(2,2,[cl|2,0,0,1]);
    gamma0:=Gamma0_fp(SL2O,get_label(beta));
end intrinsic;


////////////////////
intrinsic levels_by_det(SL2O::GrpPSL2Cliff)->Assoc
////////////////////
{Get all of the levels of Gamma0 matrices and organize them by determinant}
    O:=clifford_order(SL2O);
    cl:=clifford_algebra(O);
    M2:=MatrixAlgebra(magma_algebra(cl),2);
    alpha_by_det:=AssociativeArray();
    alphas:=[alpha : alpha in Keys(SL2O`gamma0fp_dict)];
    for alpha in alphas do
        d:=pdet(alpha)[1];
        if not d in Keys(alpha_by_det) then
            alpha_by_det[d]:=[M2!alpha];
        else
            Append(~alpha_by_det[d],M2!alpha);
        end if;
    end for;
    
    return alpha_by_det;
end intrinsic;

////////////////////
intrinsic levels(SL2O::GrpPSL2Cliff)->SeqEnum[RngIntElt]
////////////////////
{Return all of the level that are currently stored for this group. For levels of prime pseudodeterminant one can also compute Gamma0_fp for alpha^-1 if they have been loaded from storage. This is used in Hecke operators on abelian groups.
}
    alphas_by_det:=levels_by_det(SL2O);
    all_alphas:=&cat[ [alpha : alpha in alphas_by_det[d]] : d in Keys(alphas_by_det) | d gt 1];
    all_alphas:=Reverse([alpha : alpha in all_alphas]);
    return all_alphas;
end intrinsic;

////////////////////
intrinsic groups_by_rank(grps::SeqEnum[GrpFP])->Assoc,SeqEnum
////////////////////
{}
    grps_by_rank:=AssociativeArray();
    for G in grps do
        aq_invs:=AQInvariants(G);
        r:=Multiplicity(aq_invs,0);
        if r in Keys(grps_by_rank) then
            Append(~grps_by_rank[r],G);
        else
            grps_by_rank[r]:=[G];
        end if;
    end for;
    
    return grps_by_rank;
end intrinsic;

////////////////////
intrinsic low_index_by_rank(SL2O::GrpPSL2Cliff,tup::Tup)->Assoc,SeqEnum
////////////////////
{Return an associative array whose keys are subgroups of a given rank.}
    quot:=SL2O`sl2_to_psl2_fp;
    psl2_quo:=fp_group(SL2O);
    low_index_subs:=LowIndexSubgroups(psl2_quo,tup);
    libr:=groups_by_rank(low_index_subs);
    return libr,low_index_subs;
end intrinsic;

////////////////////
intrinsic PGamma0_by_rank(SL2O::GrpPSL2Cliff)->Assoc,SeqEnum
////////////////////
{Return an associative array whose keys are ranks and whose output are a collection of alphas such that PGamma0_alpha has that rank.}
    quot:=SL2O`sl2_to_psl2_fp;
    all_alphas:=[alpha : alpha in Keys(SL2O`gamma0fp_dict)];
    
    gamma_by_rank:=AssociativeArray();
    for alpha in all_alphas do
        gamma:=Gamma0_fp(SL2O,alpha);
        aq_invs:=AQInvariants(gamma);
        rk:=Multiplicity(aq_invs,0);
        vprintf Clifford, 1: "%o,", rk;
        if rk in Keys(gamma_by_rank) then
            Append(~gamma_by_rank[rk],alpha);
        else
            gamma_by_rank[rk]:=[alpha];
        end if;
    end for;
    
    return gamma_by_rank;
end intrinsic;
    

/////////////////////////
intrinsic PGamma0_fp(SL2O::GrpPSL2Cliff,seq::SeqEnum)->GrpFP
/////////////////////////
{Return the intersection of PGamma0(alpha) for alpha in seq.}
//add caching
    quot:=SL2O`sl2_to_psl2_fp;
    gammas:=[];
    for alpha in seq do
        gamma0,f:=Gamma0_fp(SL2O,alpha);
        Pgamma:=quot(f(gamma0));
        Append(~gammas,Pgamma);
    end for;
    return &meet(gammas);
end intrinsic;


/////////////////////////
intrinsic hecke_matrices_for_p(SL2O::GrpPSL2Cliff,PSigma::GrpFP,p::RngIntElt :sample:=0)->Assoc
/////////////////////////
{Return the hecke matrices of a given level p.}
    lvl_by_det:=levels_by_det(SL2O);
    Tp:=AssociativeArray();
    if sample eq 0 then
        sample:=#lvl_by_det[p];
    end if;
    
    
    for i in [1..sample] do
        alphai:=lvl_by_det[p][i];
        t0:=Time();
        Tp[i]:=hecke_matrix_tf(SL2O,PSigma,alphai);
        vprintf Clifford,1: " %o: %o,", RealField(2)!i/sample,Time(t0);
    end for;
    
    return Tp;
end intrinsic;

/////////////////////////
intrinsic hecke_matrices_for_p(MS::ModSymCliff,p::RngIntElt :sample:=0)->Assoc
/////////////////////////
{Return the hecke matrices of a given level p.}
    SL2O:=clifford_bianchi_group(MS);
    lvl_by_det:=levels_by_det(SL2O);
    Tp:=AssociativeArray();
    if sample eq 0 then
        sample:=#lvl_by_det[p];
    end if;
    
    
    for i in [1..sample] do
        alphai:=lvl_by_det[p][i];
        t0:=Time();
        Tp[i]:=hecke_matrix_tf(MS,alphai);
        vprintf Clifford,1: " %o: %o,", RealField(2)!i/sample,Time(t0);
    end for;
    
    return Tp;
end intrinsic;

/////////////////////////
intrinsic hecke_matrix_dict(SL2O::GrpPSL2Cliff,PSigma::GrpFP,primes::SeqEnum[RngIntElt]:sample:=0)->Assoc
/////////////////////////
{Return the hecke matrices of a given level p.}
    T:=AssociativeArray();
    for p in primes do
        t0:=Time();
        T[p]:=hecke_matrices_for_p(SL2O,PSigma,p:sample:=sample);
        vprintf Clifford,1: "%o:%o,%o", p,RealField(2)!Index(primes,p)/#primes,Time(t0);
    end for;
    return T;
end intrinsic;

/////////////////////////
intrinsic hecke_matrix_dict(MS::ModSymCliff,primes::SeqEnum[RngIntElt]:sample:=0)->Assoc
/////////////////////////
{Return the hecke matrices of a given level p.}
    T:=AssociativeArray();
    for p in primes do
        t0:=Time();
        T[p]:=hecke_matrices_for_p(MS,p:sample:=sample);
        vprintf Clifford,1: "%o:%o,%o", p,RealField(2)!Index(primes,p)/#primes,Time(t0);
    end for;
    return T;
end intrinsic;
