
//the template for this package is https://magma.maths.usyd.edu.au/magma/handbook/text/1668#18928

declare type ModSymCliff[ModSymCliffElt];
declare attributes ModSymCliff: finite_index_subgroup_fp,psl2o,right_transversals,right_transversal_map,quo_to_free,free_to_quo,quo_to_manin,manin_to_quo,free_module,manin_module,clifford_algebra,magma_algebra,clifford_order,fp_group_to_free_module,free_module_to_fp_group,free_to_manin_map,quo_to_man_func,man_to_quo_func,manin,man_to_abs_func,abs_to_man_func, random_manin_symbol,cusps,hecke_matrices,relations,subgroup_matrix_generators,abs_to_free_func,free_to_abs_func,abs_to_free_cusp_func,free_to_abs_cusp_func, right_transversal_matrices,manin_module_tf,manin_module_tf_map,hecke_matrices_tf,matrix_algebra, hecke_algebra_tf,eigenspaces;

declare attributes ModSymCliffElt: parent,assoc,elt,cusps,magma_algebra,clifford_algebra;

//import "coset-table.mag": presentation,coset_table; //this already appears as an intrinsic in coset-table.mag which should probably be moved to package-magma-fixes.mag.

infty:=Infinity();
Z:=Integers();
Q:=RationalField();

//#####################
function random_rational();
//#####################
    numerator := Random([-1000..1000]); // Choose a random integer in the range -1000 to 1000
    denominator := Random([1..1000]);   // Choose a random positive integer in the range 1 to 1000
    return Q ! (numerator / denominator);
end function;

//#####################
random_integer:=func<|Z ! Random([-1000..1000])>;
//#####################

////////////////////
intrinsic modular_symbols(SL2O::GrpPSL2Cliff,PSigma::GrpFP)->ModSymCliff
////////////////////
{Alias for modular symbols with the signature flipped.}
    return modular_symbols(PSigma,SL2O);
end intrinsic;

//#############################
intrinsic modular_symbols(Gammaquo::GrpFP,PSL2O::GrpPSL2Cliff : method:="deterministic", cycle_sample_size:=1000,
        action_percentage:=0.3, num_rels:=10000, len:=20, coset_method:="fp_group", scramble:=false) -> ModSymCliff
//#############################
{
Compute the group of modular symbols for a finite index subgroup PGamma in PSL2(O).
}
    base_ring:=Integers();
    MS:=New(ModSymCliff);
    
    PSL2Oquo:=fp_group(PSL2O);   //improvement for abstract class PSL2O:=supergroup(Gamma);
    cl:=get_clifford_algebra(PSL2O);
    cusp_set:=cusps(cl);
    act:=cusp_set`action;
    //zero:=cusp(cl!0);
    //infty:=cusp(infty);
    O:=get_clifford_order(PSL2O);
    cl_mag:=get_magma_algebra(cl);
    O_mag:=get_magma_order(O);
    Inds:=get_vector_indices(cl);
    Zn:=get_clifford_lattice(cl);
    Qn:=get_vector_space(cl);
    zero_c:=zero(cusp_set);
    infty_c:=infinity(cusp_set);
  
    if coset_method eq "fp_group" then
      vprintf Clifford, 4: "creating right transversal ... ";
      vtime Clifford, 4: R,get_rep:=RightTransversal(PSL2Oquo,Gammaquo);
        
        // We store these representatives in the cache inside the PSL2O object which helps with matrix group to finitely presented group conversion.
        
        rep_mats:=[MatrixAlgebra(cl`alg,2)|];

        vprintf Clifford, 5: "converting %o elements to matrices ", #R;
        for r in R do
          vprintf Clifford, 6: ".";
            r_quo:=PSL2Oquo!r;
            r_mat:=fp_element_to_matrix(PSL2O,r_quo);
            PSL2O`psl2quo_to_mat[r_quo]:=r_mat;
            PSL2O`psl2quo_to_mat[r_quo^-1]:=r_mat^-1;
            PSL2O`mat_to_psl2quo[r_mat]:=r_quo;
            PSL2O`mat_to_psl2quo[r_mat^-1]:=r_quo^-1;
            Append(~rep_mats,r_mat);
        end for;
        vprintf Clifford, 5: "\n";
    elif coset_method eq "adam" then
    
        //put adam's code here
    
    end if;
    
    //The free abelian group on coset representatives has a surjective map to the modular symbols. A quotient of this free abelian group will be the group of Manin symbols.
    MSfree:=FreeAbelianGroup(#R);

    quo_to_free:=AssociativeArray();
    free_to_quo:=AssociativeArray();
    
    id_mat:=Matrix(2,2,[cl! 1,cl! 0,cl! 0,cl ! 1]);
    id_sl2:=matrix_to_fp_element(PSL2O,id_mat);
    
    quo_to_free[get_rep(id_sl2)]:=id_sl2;

    vprint Clifford, 5: "creating some coercions";
    for i in [1..#R] do
        quo_to_free[R[i]]:=MSfree.i;
        free_to_quo[MSfree.i]:=R[i];
    end for;

    // AML: the next line is slow because Gammaquo comes with a massive pile
    // of generators.  It can be improved by reducing the generators first.
    // subgroup_mats:=[fp_element_to_matrix(PSL2O,g) : g in Generators(Gammaquo)];
    // but it's annoying that apparently you can only do this once.
    vprint Clifford, 4: "trying to reduce the group";
    try
      vtime Clifford, 4: red_gammaquo,red_to_gammaquo := ReduceGenerators(Gammaquo);
    catch e vprint Clifford, 4: "failing (perhaps because of a bug that prevents the same group from being reduced twice)";
      red_gammaquo := Gammaquo; red_to_gammaquo := hom<Gammaquo->Gammaquo|[Gammaquo.i: i in [1..Ngens(Gammaquo)]]>;
    end try;
    // I suspect that we should just use red_gammaquo instead of Gammaquo.
    subgroup_mats_red := [fp_element_to_matrix(PSL2O,red_gammaquo.i): i in [1..Ngens(red_gammaquo)]];
    vprint Clifford, 4: "finding the generators as matrices";
    vtime Clifford, 4: subgroup_mats := [evaluate_relation(subgroup_mats_red,Eltseq(red_gammaquo!red_to_gammaquo(Gammaquo.i))): i in [1..Ngens(Gammaquo)]];
    
    //%%%%%%%%%%%%%%%%%%%%%%
    function free_to_abs(c)
    //%%%%%%%%%%%%%%%%%%%%%%
    /*
    Given a vector v in the free abelian group corresponding to the coset representatives we map v_i = \sum c_i e_i to sum c_i (M_i) where M_i is the ith representative and the parentheses denote the principal modular symbol associated to a matrix.
    
        INPUT:
            --c, a vector corresponding to a Manin symbol, here this is just an element of the free abelian group.
            
        OUTPUT:
            --a tuple of <<a,b>,c> for a,b rational Clifford vectors or infinity.
        
        Note that this uses comparisons of Clifford vectors which apparently makes sense.
            a0 := I[1];
            b0 := I[2];
            a0 lt b0;
            
    */
        abstract_symbol_tuple := <>;
        keys:=<>;
        
        //---printing---
        vprintf Clifford,4: "Making principal symbols associated to coset representatives...\n";
        
        /*
        Make an intrinsic for principal symbols.
        Also, call these on cusps, so as to not manage types.

        */
        
        for i in [1..#R] do
            g:=fp_element_to_matrix(R[i]);//to matrix
            ci:=c[i];
            if ci ne 0 then
                ai:=act(g,0);
                bi:=act(g,infty);
                if Type(ai) eq Infty and Type(ai) eq Type(bi) then
                    //do nothing
                elif (Type(ai) eq Infty) then
                    keys:=keys cat <bi,ai>;
                    Append(~abstract_symbol_tuple,<-ci,<bi,ai>>);
                elif (Type(bi) eq Infty) then
                    keys:=keys cat <ai,bi>;
                    Append(~abstract_symbol_tuple,<ci,<ai,bi>>);
                elif (ai gt bi) then
                    keys:=keys cat <bi,ai>;
                    Append(~abstract_symbol_tuple,<-ci,<bi,ai>>);
                elif (bi gt ai) then
                    keys:=keys cat <ai,bi>;
                    Append(~abstract_symbol_tuple,<ci,<ai,bi>>);
                end if;
            end if;
        end for;
        
        return abstract_symbol_tuple;
    end function;
    
    //%%%%%%%%%%%%%%%%%%%%%%
    function free_to_abs_cusp(c)
    //%%%%%%%%%%%%%%%%%%%%%%
    /*
    Given a vector v in the free abelian group corresponding to the coset representatives we map v_i = \sum c_i e_i to sum c_i (M_i) where M_i is the ith representative and the parentheses denote the principal modular symbol associated to a matrix.
    
        INPUT:
            --c, a vector corresponding to a Manin symbol, here this is just an element of the free abelian group.
            
        OUTPUT:
            --a tuple of <<a,b>,c> for a,b cusps
        
        Note that this uses comparisons of Clifford vectors which apparently makes sense.
            a0 := I[1];
            b0 := I[2];
            a0 lt b0;
            
    */
        abstract_symbol_tuple := <>;
        keys:=<>;
        
        //---printing---
        vprintf Clifford,4: "Making principal symbols associated to coset representatives...\n";
        
        /*
        Make an intrinsic for principal symbols.
        Also, call these on cusps, so as to not manage types.

        */
        
        
        for i in [1..#R] do
            g:=fp_element_to_matrix(R[i]);//to matrix
            ci:=c[i];
            if ci ne 0 then
                ai:=g(zero_c);
                bi:=g(infty_c);
                if ai eq bi then
                    //do nothing
                elif (ai gt bi) then
                    keys:=keys cat <bi,ai>;
                    Append(~abstract_symbol_tuple,<-ci,<bi,ai>>);
                elif (bi gt ai) then
                    keys:=keys cat <ai,bi>;
                    Append(~abstract_symbol_tuple,<ci,<ai,bi>>);
                end if;
            end if;
        end for;
        
        return abstract_symbol_tuple;
    end function;
    
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function abs_to_free(my_abstract_symbol)
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    /*
    Converts abstract modular symbols to c symbols. This is the raw version.
        
        INPUT:
            --my_abstract_symbol, a modular symbol presented as a list of
                [[a,b],c] where c is a rational number and a,b clifford vectors
            
        OUTPUT:
            --c, an element of finite dimensional vectors space
                of dimension |Gamma/SL2(O)|
                
        The procedure takes [[a,b],c] considered as c*[a,b] then writes is as c([oo,b]-[oo,a]).
        Each of the symbols [oo,x] are computed separately by computing the matrices A1,...,Ar
        such that Ai(infty)=ai is the ith convergent of x. We have
           [oo,x] = [oo,a1]+[a1,a2] + ... + [a(r-1),ar]
        and each symbol looks like [Ai(0),Ai(infty)] in this linear combination. These all have
        the form Ai = CR where C is in Gamma and R is a coset representative. This means that
        [Ai(0),Ai(infty)] = [C R(0),C R(infty)] = (R) and the (R) are the generators of the Manin
        symbols.

            magma: my_abstract_symbol := [* [* 3, [* I[1]+I[2]/4, 1/24+I[2] *] *],[* -1/5, [* I[1]/5-I[2]/4, 1+I[2]/15 *] *] *];
            magma: abstract_to_free(my_abstract_symbol, O, cl, Inds, Zn, Qn, is_vec, star, get_rep, get_manin_dict,translate_to_quo_dict, cob_matrix,vecO_basis);
            ( 2/5 -1/5    0 -1/5  2/5    0)
            
    */
    //These names are bad. They are really not elements of "manin" which is the quotient module defined later. The naming is bad because this was pulled from an earlier implementation.
         
        //-----------------
        function abstract_to_free_basic(x)
        //-----------------
            if Type(x) eq Infty then
                id_mat:=IdentityMatrix(cl_mag,2);
                id_psl2:=matrix_to_fp_element(PSL2O,id_mat);
                return quo_to_free[get_rep(id_psl2)];
            else
                M, A, M_quo, A_quo := get_convergents(PSL2O,x);
                        
                return &+[quo_to_free[get_rep(A_quo[i])] : i in [1..#A_quo]];
            end if;
        end function;
        
        //-----------------
        function abstract_to_free_single(one_symbol)
        //-----------------
            coeff := one_symbol[2];
            a := one_symbol[1][1];
            b := one_symbol[1][2];
            
            //---printing---
            vprintf Clifford, 4: "in abstract_to_free: type a=%o...\n",Type(a);
        
            // Handle the non-basic case
            if Type(a) eq Infty then
                return coeff*abstract_to_free_basic(b);
            elif Type(b) eq Infty then
                return -coeff*abstract_to_free_basic(a);
            else
                manin_symbol_a := abstract_to_free_basic(a);
                manin_symbol_b := abstract_to_free_basic(b);
                return coeff * (manin_symbol_b - manin_symbol_a);
            end if;
        end function;
        
        return &+[abstract_to_free_single(s) : s in my_abstract_symbol];
    end function;
    
    
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function abs_to_free_cusp(my_abstract_symbol)
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    /*
    Converts abstract modular symbols to c symbols. This is the raw version.
        
        INPUT:
            --my_abstract_symbol, a modular symbol presented as a list of
                [[a,b],c] where c is a rational number and a,b cusps
            
        OUTPUT:
            --c, an element of finite dimensional vectors space
                of dimension |Gamma/SL2(O)|
                
        The procedure takes [[a,b],c] considered as c*[a,b] then writes is as c([oo,b]-[oo,a]).
        Each of the symbols [oo,x] are computed separately by computing the matrices A1,...,Ar
        such that Ai(infty)=ai is the ith convergent of x. We have
           [oo,x] = [oo,a1]+[a1,a2] + ... + [a(r-1),ar]
        and each symbol looks like [Ai(0),Ai(infty)] in this linear combination. These all have
        the form Ai = CR where C is in Gamma and R is a coset representative. This means that
        [Ai(0),Ai(infty)] = [C R(0),C R(infty)] = (R) and the (R) are the generators of the Manin
        symbols.

            magma: my_abstract_symbol := [* [* 3, [* I[1]+I[2]/4, 1/24+I[2] *] *],[* -1/5, [* I[1]/5-I[2]/4, 1+I[2]/15 *] *] *];
            magma: abstract_to_free(my_abstract_symbol, O, cl, Inds, Zn, Qn, is_vec, star, get_rep, get_manin_dict,translate_to_quo_dict, cob_matrix,vecO_basis);
            ( 2/5 -1/5    0 -1/5  2/5    0)
            
    */
    //These names are bad. They are really not elements of "manin" which is the quotient module defined later. The naming is bad because this was pulled from an earlier implementation.
         
        //-----------------
        function abstract_to_free_basic(x)
        //-----------------
            if is_infinite(x) then
                //id_mat:=IdentityMatrix(cl_mag,2);
                //id_psl2:=matrix_to_fp_element(PSL2O,id_mat);
                //return quo_to_free[get_rep(id_psl2)];
                return MSfree!0;
            else
                x_cl:=cl!x;
                M, A, M_quo, A_quo := get_convergents(PSL2O,x_cl);
                        
                return &+[quo_to_free[get_rep(A_quo[i])] : i in [1..#A_quo]];
            end if;
        end function;
        
        //-----------------
        function abstract_to_free_single(one_symbol)
        //-----------------
            coeff := one_symbol[2];
            a := one_symbol[1][1];
            b := one_symbol[1][2];
            
            //---printing---
            vprintf Clifford, 4: "in abstract_to_free: type a=%o...\n",Type(a);
        
            // Handle the non-basic case
            if is_infinite(a) then
                return coeff*abstract_to_free_basic(b);
            elif is_infinite(b) then
                return -coeff*abstract_to_free_basic(a);
            else
                manin_symbol_a := abstract_to_free_basic(a);
                manin_symbol_b := abstract_to_free_basic(b);
                return coeff * (manin_symbol_b - manin_symbol_a);
            end if;
        end function;
        
        return &+[abstract_to_free_single(s) : s in my_abstract_symbol];
    end function;
    
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function random_relation_basic_abs( :len:=20);
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
        pair:=random_basic_symbol_crude(cl);
        g:=random_product(subgroup_mats :len:=len);
        gpair:=<act(g,pair[1]),act(g,pair[2])>;
        return <<pair,1>,<gpair,-1>>;
    end function;
    
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function random_relation_basic_abs_cusp( :len:=20);
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
        elts:=random_basic_symbol_crude(cl);
        g:=random_product(subgroup_mats :len:=len);
        a:=cusp_set ! elts[1];
        b:=cusp_set ! elts[2];
        return <<<a,b>,1>,<<g*a,g*b>,-1>>;
    end function;
    
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function random_relation_basic_man();
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
        return abs_to_free(random_relation_basic_abs());
    end function;

    //--------------------------------------------------
    //Now we are going to take a quotient of MSfree.
    //1) Let T(v) = abs_to_free(free_to_abs(v)). The relations are given by v-T(v).
    //2) {infty,a} eq {g(infty),g(a)} for many a.
    // in the current version random_relation_basic and random_relation_basic_man are not used.
    //----------------------------------------------------
    /*
    This is wrong. --Taylor, October 2025
    
    */
    
    relations:=[];
    
    //----------------------------------------------------
    //---------------random sample ----------------------
    //----------------------------------------------------
    if method eq "random_sample" then
    
        //---------------------
        function get_triple_relation_abs(triple)
        //---------------------
            abc:=[a: a in triple];
            a:=abc[1];
            b:=abc[2];
            c:=abc[3];
            cycle_rel:=< <<a,b>,1> , <<b,c>,1>, <<c,a>,1> >;
            return cycle_rel;
        end function;
    
        sample_size:=cycle_sample_size;
        percentage:=action_percentage;
    
        end_points:={@ g*zero_c : g in rep_mats @} join {@ g*infty_c : g in rep_mats @};

        vprintf Clifford,5: "making one relation for each of the %o generators of the free abelian group ", #Generators(MSfree);
        for i in [1..#Generators(MSfree)] do
          vprintf Clifford,6: ".";
            vi:=MSfree.i;
            Ri:=fp_element_to_matrix(PSL2O,free_to_quo[vi]);
            basici:=<<Ri*zero_c,Ri*infty_c>,1>; //these are "crude"
            my_abs:=<basici>;
            relation:= MSfree.i - abs_to_free_cusp(my_abs);
            Append(~relations,relation);
        end for;
        vprintf Clifford,5: "\n";
        //<infty,x> = <g infty, g x>
        //The g's here can be randomized
        set_sm := {@x: x in subgroup_mats@};
        set_ep := {@x: x in end_points@};
        // pairs:={ <g,x> : g in Set(subgroup_mats), x in Set(end_points) };
        sample_size:=Ceiling(percentage*#set_sm*#set_ep);
        sample_inds:=RandomSubset({1..#set_sm*#set_ep},sample_size);
        sample := [<set_sm[(i-1) div #set_ep+1],set_ep[i mod #set_ep+1]>: i in sample_inds];
        
        vprintf Clifford,5: "making %o action relations ", #sample;
        for a in [b: b in sample] do
          vprintf Clifford,6: ".";
            g:=a[1];
            x:=a[2];
            action_rel:= abs_to_free_cusp(< <<infty_c,x>,1>, <<g*infty_c,g*x>,-1> >);
            Append(~relations,action_rel);
        end for;
        vprintf Clifford,5: "\n";
    
        if #end_points gt 2 then
          vprintf Clifford,5: "making %o triple relations ", sample_size;
          triples:={@ RandomSubset(set_ep,3) : i in [1..sample_size] @} where set_ep is {x : x in end_points};
          for triple in triples do
            vprintf Clifford,6: ".";
            Append(~relations,abs_to_free_cusp(get_triple_relation_abs(triple)));
          end for;
          vprintf Clifford,5: "\n";
        end if;
        
    //----------------------------------------------------
    //---------------random relations ----------------------
    //----------------------------------------------------
    if method eq "random_relations" then
        
        for i in [1..#Generators(MSfree)] do
            vi:=MSfree.i;
            Ri:=fp_element_to_matrix(PSL2O,free_to_quo[vi]);
            basici:=<<Ri*zero_c,Ri*infty_c>,1>; //these are "crude"
            my_abs:=<basici>;
            relation:= MSfree.i - abs_to_free_cusp(my_abs);
            Append(~relations,relation);
        end for;
        
        //spam random relations in no particular order for a given size
        
        Append(~relations,[ random_relation_basic_man() : i in [1..cycle_sample_size]]);
        
    end if;
        
    //------------------------------------------------------
    //---------------deterministic relations ---------------
    //------------------------------------------------------
    elif method eq "deterministic" or "hecke" then
    
        end_points:={@ g*zero_c : g in subgroup_mats @} join {@ g*infty_c : g in subgroup_mats @};
    
        for i in [1..#Generators(MSfree)] do
            vi:=MSfree.i;
            Ri:=fp_element_to_matrix(PSL2O,free_to_quo[vi]);
            basici:=<<Ri*zero_c,Ri*infty_c>,1>; //these are "crude"
            my_abs:=<basici>;
            relation:= MSfree.i - abs_to_free_cusp(my_abs);
            Append(~relations,relation);
        end for;
        
        for x in end_points do
            for g in subgroup_mats do
                if x ne infty_c then
                    action_rel_abs:= < <<infty_c,x>,1>, <<g*infty_c,g*x>,-1> >;
                    action_rel:=abs_to_free_cusp(action_rel_abs);
                    Append(~relations,action_rel);
                end if;
            end for;
            vprintf Clifford,5: "completed %o out of %o... \n", Index(end_points,x),#end_points;
        end for;
    
    //------------------------------------------------------
    //---------------hecke relations ----------------------
    //------------------------------------------------------
    elif method eq "hecke" then
    
        error "Not implemented";
    
    end if;
    
    //This is the quotient
    MSquo,q_map:=quo<MSfree|Set(relations)>;
    
    
    //We cache the relationships between the coset representatives and the elements of the quotient abelian group that are in bijection with them. They just come extending the setup we had previously.
    // AML: in general they do not seem to be in bijection, nor do we always
    // get all the generators.  This causes all sorts of problems later,
    // which I try to fix in some of the code below.
    
    /*
    Sorry, I think we *do* get all of the generators. This is what we proved.
    */

    quo_to_man:=AssociativeArray();
    man_to_quo:=AssociativeArray();

    for i in [1..#R] do
        quo_to_man[R[i]]:=q_map(MSfree.i);
        man_to_quo[q_map(MSfree.i)]:=R[i];
    end for;
    
    /*
    The elements of MSfree that map to generators of MSquo are (MSquo.i @@ q_map).
    */
    
    /*
    Adam says: we do not get all of the generators of MSquo among the keys of man_to_quo.
    */
    
    // AML: !!! danger: I am not sure this is safe.  Taylor, please have a
    // look and tell me what you think.  If not we need to make some other
    // changes around here.
    /*
    I'm not sure what you mean by safe but this shit is certainly crashing somewhere. That's what I'm trying to figure out now. I just want something semi-reliable right now.
    */
    
    if scramble eq true then
        vprint Clifford, 4: "trying to fill in gaps in the man_to_quo array";
        goodkeys := [x: x in Keys(man_to_quo)|#Eltseq(man_to_quo[x]) le 100];
        for i in [-Ngens(MSquo)..Ngens(MSquo)] do
          if MSquo.i notin goodkeys then
            if MSquo.(-i) in goodkeys then
              man_to_quo[MSquo.i] := man_to_quo[(MSquo.(-i))]^-1;
            elif exists(xy){[x,y]: x,y in goodkeys|x*y eq MSquo.i} then
              man_to_quo[MSquo.i] := &*[man_to_quo[t]: t in xy];
            elif exists(xyz){[x,y,z]: x,y,z in goodkeys|x*y*z eq MSquo.i} then
              man_to_quo[MSquo.i] := &*[man_to_quo[t]: t in xyz];
            end if;
            // of course we could keep trying with a longer list, but we can't
            // pretend that this is a homomorphism.
          end if;
        end for;
        /* here is a more general way, just expressing everything in terms
        of known things and pretending it's a homomorphism (this is a valid
        way to produce a lift)
        unfortunately it works very badly when there is torsion of large order*/
        /*repeat
          mybas := Setseq(RandomSubset(Keys(man_to_quo),Ngens(MSquo)));
        until sub<MSquo|mybas> eq MSquo;
        ag := AbelianGroup([Order(i): i in mybas]);
        myhom := hom<ag->MSquo|mybas>;
        for i in [-Ngens(MSquo)..Ngens(MSquo)] do
          if MSquo.i notin Keys(man_to_quo) then
            ib := (MSquo.i)@@myhom;
            imi := &*[man_to_quo[mybas[j]]^Eltseq(ib)[j]: j in [1..#mybas]];
            man_to_quo[MSquo.i] := imi;
          end if;
        end for;
       */
        
        error if exists{c: c in [-Ngens(MSquo)..Ngens(MSquo)]|MSquo.c notin Keys(man_to_quo) and Order(MSquo.c) eq 0}, "failed to find the images of some generators of infinite order";
    end if;

    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    abs_to_man:=func<x|q_map(abs_to_free(x))>;
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
    function man_to_abs(v)
    //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
        my_abs_symb:=<>;
        //pull back v to MSfree
        //then take eltseq
        //w:=(v @@ q_map);
        //c:=Eltseq(w);
        c:=Eltseq(v);
        for i in [1..#Generators(MSquo)] do //#Generators(MSfree)
        //for i in [1..#Generators(MSfree)] do
            Mi:=fp_element_to_matrix(PSL2O,man_to_quo[MSquo.i]); //replace man_to_quo with free_to_quo
            //Mi:=fp_element_to_matrix(PSL2O,free_to_quo[MSfree.i]);
            zero_c:=zero(cusp_set);
            infty_c:=infinity(cusp_set);
            
            //---printing---
            vprint Clifford,5: "about to act on zero_c=%o by Mi=%o... \n",zero_c,Mi;
            
            ai:=Mi*zero_c;
            bi:=Mi*infty_c;
            
            //---printing---
            vprint Clifford,5: "success... \n";
            
            ci:=c[i];
            basici:=<<ai,bi>,ci>;
            my_abs_symb:=my_abs_symb cat <basici>;
        end for;
        return my_abs_symb;
    end function;
    
    //#####################
    function random_manin_symbol();
    //#####################
        free_element:=&+[random_integer()*v : v in Generators(MSfree)];
        return q_map(free_element);
    end function;
    
    MS`finite_index_subgroup_fp:=Gammaquo;
    MS`psl2o:=PSL2O;
    MS`right_transversals:=R;
    MS`right_transversal_map:=get_rep;
    MS`right_transversal_matrices:=rep_mats;
    MS`quo_to_free:=quo_to_free;
    MS`free_to_quo:=free_to_quo;
    MS`quo_to_manin:=quo_to_man;
    MS`manin_to_quo:=man_to_quo;
    MS`free_module:=MSfree;
    MS`manin:=MSquo;
    MS`clifford_algebra:=cl;
    MS`magma_algebra:=cl_mag;
    MS`clifford_order:=O;
    MS`fp_group_to_free_module:=quo_to_free;
    MS`free_module_to_fp_group:=free_to_quo;
    MS`manin_module:=MSquo;
    MS`free_to_manin_map:=q_map;
    //MS`quo_to_man_func:=quo_to_man;
    //MS`man_to_quo_func:=man_to_quo;
    MS`man_to_abs_func:=man_to_abs;
    MS`abs_to_man_func:=abs_to_man;
    MS`abs_to_free_func:=abs_to_free;
    MS`free_to_abs_func:=free_to_abs;
    MS`abs_to_free_cusp_func:=abs_to_free_cusp;
    MS`free_to_abs_cusp_func:=free_to_abs_cusp;
    MS`random_manin_symbol:=random_manin_symbol;
    MS`cusps:=cusp_set;
    MS`relations:=relations;
    // I don't understand--why is this not the same as subgroup_mats,
    // at least up to sign?  It's slow so I don't want to compute it again.
    // MS`subgroup_matrix_generators:= [fp_element_to_matrix(PSL2O,PSL2Oquo!g) : g in Generators(Gammaquo)];
    MS`subgroup_matrix_generators := subgroup_mats;
    return MS;
    
end intrinsic;

