//#############################
intrinsic zero_mod_sym(MS::ModSymCliff) -> ModSymCliffElt
//#############################
{create an empty modular symbol}
  return mod_sym(MS,<>);
end intrinsic;

//#############################
intrinsic random_manin_symbol(MS::ModSymCliff) -> GrpAbElt
//#############################
{Create a random manin symbol}
  return MS`random_manin_symbol();
end intrinsic;

//#############################
intrinsic principal_symbol(MS::ModSymCliff,A::AlgMatElt) -> ModSymCliffElt
//#############################
{}
    csp:=cusps(MS);
    
    //old convention
    infty_c:=infinity(csp);
    zero_c:=zero(csp);
    k:=<A*zero_c,A*infty_c>;
    val:=1;
    basic:=<k,val>;
    sym:=<basic>;
    return mod_sym(MS,sym);
end intrinsic;

//#############################
intrinsic basic_symbol(MS::ModSymCliff,pair::Tup) -> ModSymCliffElt
//#############################
{}
    require #pair eq 2: "The tuple must have length two";
    csp:=cusps(MS);
    //old convention
    k:=<csp!pair[1],csp!pair[2]>;
    val:=1;
    basic:=<k,val>;
    sym:=<basic>;
    return mod_sym(MS,sym);
end intrinsic;

//#############################
intrinsic basic_symbol(MS::ModSymCliff,pair::SeqEnum) -> ModSymCliffElt
//#############################
{}
    require #pair eq 2: "The sequence must have length two";
    csp:=cusps(MS);
    k:=<csp!pair[1],csp!pair[2]>;
    val:=1;
    basic:=<k,val>;
    sym:=<basic>;
    return mod_sym(MS,sym);
end intrinsic;

//#############################
intrinsic mod_sym(MS::ModSymCliff,y::Tup) -> ModSymCliffElt
//#############################
{
Create a modular symbol from a tuple.
Entries should be of the form <[x0,x1],c> where c is a rational number and x0 and x1 are cusps which can either be clifford algebra elements infty.
}
    //---printing---
    vprintf Clifford, 5: "Entering mod_sym for Tup...\n";

    cusp_set:=MS`cusps;
    
    ms := New(ModSymCliffElt);
    ms`parent:=MS;
    ms`magma_algebra := get_magma_algebra(MS);
    ms`assoc := AssociativeArray();
    
    for tup in y do
        pair:=tup[1];
        value:=tup[2];
        
        require #pair eq 2: "A valid tuple must have length two";
        require pair[1] in cusp_set and pair[2] in cusp_set: "A valid tuple requires pairs to be elements of the set of cusps";
        
        a:=pair[1];
        b:=pair[2];
        
        if a lt b then
            if IsDefined(ms`assoc,[a,b]) then
                ms`assoc[[a,b]] +:= value;
            else
                ms`assoc[[a,b]] := value;
            end if;
        elif b lt a then
            if IsDefined(ms`assoc,[b,a]) then
                ms`assoc[[b,a]] +:= -value;
            else
                ms`assoc[[b,a]] := -value;
            end if;
        else
            //skip because the empty associative array should correspond to the zero manin symbol.
        end if;
    end for;
    
    return ms;
end intrinsic;

//intrinsic convert_from_manin_symbol


//###########################
intrinsic get_abstract_symbol(ms:ModSymCliffElt)->Tup
//############################
{}
    return <<k,coeff(ms,k)>:k in Keys(ms`assoc)>;
    
end intrinsic;


//###########################
intrinsic get_crude_abstract_symbol(ms:ModSymCliffElt)->Tup
//############################
{}
    return <<<get_magma_value(k[1]),get_magma_value(k[2])>,coeff(ms,k)>:k in Keys(ms`assoc)>;
    
end intrinsic;

//###########################
intrinsic manin_symbol(ms:ModSymCliffElt)->GrpAbElt
//############################
{}
    MS:=Parent(ms);
    
    return MS`abs_to_man_func(get_crude_abstract_symbol(ms));

end intrinsic;


//#############################
intrinsic Print(MS::ModSymCliff)
//#############################
{}

    printf "Modular symbols for the group %o inside %o \n",MS`finite_index_subgroup_fp,MS`psl2o;

end intrinsic;

//#############################
intrinsic Print(m::ModSymCliffElt)
//#############################
{
Print statement for modular symbol elements.
We are following the magma template.
//https://magma.maths.usyd.edu.au/magma/handbook/text/1668#18927

}
    //need these here for the function
    dict:=m`assoc;
    pairs:=[k : k in Keys(dict)];
    
    //%%%%%%%%%%%%%%%%%
    function print_term(pair)
    //%%%%%%%%%%%%%%%%%
        if dict[pair] eq 0 then
            return "";
        else
            return Sprintf( "%o*{%o,%o}",dict[pair],pair[1],pair[2]);
        end if;
    end function;
    
    //only have + signs for the first and last term.
    n:=#pairs;
    output_string:=print_term(pairs[1]);
    for i in [2..n] do
        output_string:=output_string cat " + " cat print_term(pairs[i]);
    end for;
    printf output_string;
end intrinsic;

//#############################
intrinsic Parent(ms::ModSymCliffElt) -> ModSymCliff
//#############################
{}
    return ms`parent;

end intrinsic;


//#############################
intrinsic cusps(ms::ModSymCliffElt) -> SetCspCliff
//#############################
{}
    return cusps(Parent(ms));

end intrinsic;

//#############################
intrinsic coeff(m::ModSymCliffElt, v::SeqEnum) -> RngElt
//#############################
{coefficient of a pair}
    isd,c := IsDefined(m`assoc,v);
    if isd then
        return c;
    else
        return 0;
    end if;
end intrinsic;

//#############################
intrinsic '+'(m::ModSymCliffElt, n::ModSymCliffElt) -> ModSymCliffElt
//#############################
{sum of modular symbols}
    //this needs to be fixed.
    //error if Parent(m) ne Parent(n) "must be the same Clifford algebra";
    mn := <<k,coeff(m,k)+coeff(n,k)>: k in Keys(m`assoc) join Keys(n`assoc)>;
    smn := mod_sym(Parent(m),mn);
    return smn;
end intrinsic;

//#############################
intrinsic '-'(m::ModSymCliffElt, n::ModSymCliffElt) -> ModSymCliffElt
//#############################
{difference of modular symbols}
  //error if m`alg ne n`alg, "must be the same Clifford algebra";
  mn := <<k,coeff(m,k)-coeff(n,k)>: k in Keys(m`assoc) join Keys(n`assoc)>;
  smn := mod_sym(Parent(m),mn);
  return smn;
end intrinsic;

//#############################
intrinsic '*'(m::RngElt, n::ModSymCliffElt) -> ModSymCliffElt
//#############################
{multiple of modular symbol}
  mn := <<k,m*coeff(n,k)>: k in Keys(n`assoc)>;
  smn := mod_sym(Parent(n),mn);
  return smn;
end intrinsic;

//#############################
intrinsic '*'(g::AlgMatElt, ms::ModSymCliffElt) -> ModSymCliffElt
//#############################
{multiple of modular symbol}
    new_abs := <<<g*k[1],g*k[2]>,coeff(ms,k)> : k in Keys(ms`assoc)>;
    return mod_sym(Parent(ms),new_abs);
end intrinsic;

//#############################
intrinsic '-'(n::ModSymCliffElt) -> ModSymCliff
//#############################
{negative of modular symbol}
  // could just do -1*n
  mn := <<k,-coeff(n,k)>: k in Keys(n`assoc)>;
  smn := mod_sym(Parent(n),mn);
  return smn;
end intrinsic;

//#############################
intrinsic is_zero(n::ModSymCliffElt) -> BoolElt
//#############################
{test whether symbol is 0}
  return forall{k: k in Keys(n`assoc)|n[k] eq 0};
end intrinsic;

//#############################
intrinsic 'eq'(m::ModSymCliffElt, n::ModSymCliffElt) -> BoolElt
//#############################
{test whether symbols are equal}
  //error if m`alg ne n`alg, "must be the same Clifford algebra";
  return forall{k: k in Keys(m) join Keys(n)|coeff(m,k) eq coeff(n,k)};
end intrinsic;

//#############################
intrinsic Eltseq(m::ModSymCliffElt) -> SeqEnum
//#############################
{list of terms in a modular symbol}
  return [<a,m`assoc[a]>: a in Keys(m`assoc)];
end intrinsic;

//#############################
intrinsic Printf(MS::ModSymCliff)
//#############################
{print}
  printf "Modular symbols for the group %o inside %o.",MS`finite_index_subgroup_fp,MS`psl2o;
end intrinsic;

//##########################
intrinsic IsCoercible(MS::ModSymCliff, x::.)->ModSymElt
//##########################
{}
    if ISA(Type(x),GrpAbElt) then
        V:=MS`manin;
        return manin_to_modular_symbol(MS,V!x);
    else
        error "not implemented";
    end if;

end intrinsic;


//##########################
intrinsic manin_to_modular_symbol(MS::ModSymCliff,v::GrpAbElt)->ModSymCliffElt
//##########################
{}
    V:=MS`manin;
    v_manin:=V!v;
    v_abs:=MS`man_to_abs_func(v_manin);
    
    //---printing---
    vprintf Clifford, 5: "returned an abstract symbol from MS`man_to_abs_func of type %o...\n",Type(v_abs);
    
    return mod_sym(MS,v_abs);

end intrinsic;


intrinsic is_integral(O::CliffOrd,g::AlgMatElt)->BoolElt
{Determine if a matric has entries in an order}
    return forall{ x : x in Eltseq(g) | x in O};
end intrinsic;



//##############################
intrinsic hecke_double_cosets(PSL2O::GrpPSL2Cliff,PSigma::GrpFP,alpha::AlgMatElt)->SeqEnum
//##############################
{
Let Sigma be a finite index subgroup of PSL2(O).

We can write  Sigma alpha Sigma a union of cosets for the left action by Sigma on Sigma alpha Sigma so that Sigma alpha Sigma = bigcup Sigma alphai. This algorithm returns the collection of alphai.

We use that there is a bijection between the cosets for the left action of Sigma^alpha cap Sigma on Sigma  and cosets for the left action of Sigma on Sigma alpha Sigma. The map is given by Sigma^alpha cap Sigma)gamma mapsto Sigma alpha gamma. So if we are given a left coset representative for the previous then we have gamma mapping to alpha gamma.

Hence to compute the double cosets it suffices to compute Sigma^alpha cap Sigma inside of Sigma.
}
    //M2O:=PSL2O`matrix_algebra;//needs to be written
    PSL2O_quo:=fp_group(PSL2O);

    if not assigned PSL2O`hecke_double_cosets then
      PSL2O`hecke_double_cosets:=AssociativeArray();
    end if;
    
    if not PSigma in Keys(PSL2O`hecke_double_cosets) then
        PSL2O`hecke_double_cosets[PSigma]:=AssociativeArray();
    end if;
    
    if not alpha in Keys(PSL2O`hecke_double_cosets[PSigma]) then
        /*
        We need to compute Sigma cap Sigma^{alpha} to do this we compute Sigma^{alpha} cap SL2(O) and then intersect it with Sigma.
        We actually do a PSL2 version of this.
        
        The hard part is computing Sigma^{alpha} cap SL2(O).
            --The set of g such that g^{alpha} is in SL2(O) is Gamma0(alpha).
            --This means unconjugating Sigma^{alpha} cap SL2(O) will land in Gamma0(alpha) and also land in Sigma.
            --This means we can compute Gamma0(alpha) cap Sigma then conjugate it.
        There is an additional set here where we take the good cosets of the right action of Gamma0(alpha) cap Sigma inside of Sigma and additionally adjoin those, but I think this step is superfluous.
        */
        //PSigma0_conj_sub, incl1, conj_gens_mat := conjugate_intersection(PSL2O,PSigma,alpha);
        PSigma0_conj_sub:= conjugate_intersection(PSL2O,PSigma,alpha);
        
        //---printing---
        vprintf Clifford,3: "Computing the intersection of PSigma and its conjugate...\n";

        PSigma_cap_PSigma_conj:=PSigma meet PSigma0_conj_sub; //coset table is not closed
        hecke_cosets_single_quo:=[ PSL2O_quo ! x: x in RightTransversal(PSigma,PSigma_cap_PSigma_conj)];
        hecke_cosets_single_mat:=[fp_element_to_matrix(PSL2O,x) : x in hecke_cosets_single_quo];
        hecke_cosets_double_mat:=[alpha*x : x in hecke_cosets_single_mat]; //using the single to double coset isomorphism
        

        PSL2O`hecke_double_cosets[PSigma][alpha]:=hecke_cosets_double_mat;
        
    end if;
    
    return PSL2O`hecke_double_cosets[PSigma][alpha];
        
end intrinsic;


